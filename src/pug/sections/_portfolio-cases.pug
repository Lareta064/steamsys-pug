- var portfolioCases = [{ kicker: 'БРОУ / Пищевая промышленность', title: 'Замена БРОУ на сахарном заводе: снижение давления с 16 до 4 бар', text: 'Устаревший узел БРОУ создавал нестабильное давление в технологических контурах. Заменили на современную установку с электронным регулятором и системой диагностики.', metrics: [{ value: '−15%', label: 'расход пара' }, { value: '14 мес.', label: 'окупаемость' }], bg: 'gallery1', alt: 'Сахарный завод — БРОУ', href: '#case-brou-sugar' }, { kicker: 'СВК / Химическая промышленность', title: 'Монтаж станции возврата конденсата на химическом производстве', text: 'Предприятие сбрасывало конденсат в канализацию из-за отсутствия системы сбора. Спроектировали и поставили СВК с буферным баком и насосным агрегатом.', metrics: [{ value: '−20%', label: 'затраты на воду' }, { value: '10 мес.', label: 'окупаемость' }], bg: 'gallery2', alt: 'Химический завод — СВК', href: '#case-svk-chem' }]

section.ss-section.ss-portfolio-cases
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				span.ss-kicker Кейсы
				h2.ss-h2 Кейсы по готовым системам

		.ss-portfolio-cases__grid
			each c in portfolioCases
				article.ss-case-card.ss-case-card--portfolio
					.ss-case-card__image
						picture
							source(media='(max-width: 767px)' srcset=`${basePath}img/${c.bg}-mob.webp 1x, ${basePath}img/${c.bg}-mob@2x.webp 2x`)
							source(srcset=`${basePath}img/${c.bg}.webp 1x, ${basePath}img/${c.bg}@2x.webp 2x`)
							img(src=`${basePath}img/${c.bg}.webp` width='865' height='360' alt=c.alt loading='lazy' decoding='async')
					.ss-case-card__body
						p.ss-case-card__kicker= c.kicker
						h3.ss-case-card__title= c.title
						p.ss-case-card__text= c.text
						.ss-metrics
							each m in c.metrics
								.ss-metrics__item
									p.ss-metrics__value= m.value
									p.ss-metrics__label= m.label
					.ss-case-card__footer
						+ssLink('Читать кейс')(href=c.href)
