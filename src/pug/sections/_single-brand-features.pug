//- ============================================================
//- «Ключевые преимущества TLV» — та же архитектура, что у «Поставки»
//- (6 ячеек .ss-feature-cell шахматкой dark/light), но вместо номеров
//- короткие акценты-слова («JP», «DN 8–300», «0», «50+», «RU», «PDF»).
//- ============================================================

- var features = [{ accent: 'JP', title: 'Японское качество', text: 'Производство на заводах TLV в Японии. Материалы и допуски соответствуют JIS и ASME стандартам.' }, { accent: 'DN 8–300', title: 'Широкий типоразмерный ряд', text: 'Конденсатоотводчики и клапаны для любых условий — от лабораторных установок до магистральных паропроводов.' }, { accent: '0', title: 'Технология «без потерь пара»', text: 'TLV — изобретатели термодинамических конденсатоотводчиков с нулевым пропуском пара через клапан.' }, { accent: '50+', title: 'Лет на рынке', text: 'TLV основана в 1950 году. Продукция применяется на ключевых промышленных предприятиях по всему миру.' }, { accent: 'RU', title: 'Инженерная поддержка в России', text: 'Техническая поддержка по подбору, монтажу и эксплуатации — от специалистов Паровых систем с опытом 15+ лет.' }, { accent: 'PDF', title: 'Документация в наличии', text: 'Паспорта, сертификаты, инструкции по монтажу и таблицы подбора на русском и английском — в наличии и по запросу.' }]

section.ss-section.ss-single-brand__features
	.ss-container.ss-wrapper
		h2.ss-h2.ss-single-brand__features-title Ключевые преимущества TLV

		.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1
			each f in features
				article.ss-feature-cell.ss-feature-cell--light
					p.ss-feature-cell__accent= f.accent
					h3.ss-feature-cell__title= f.title
					p.ss-feature-cell__text= f.text
