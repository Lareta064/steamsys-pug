//- ============================================================
//- «Что входит в решение» — секция состава поставки на странице кейса.
//- Grid 3×3 из .ss-comp-item (компонент с портфолио-страницы,
//- секция «Как подобрать систему»). Элементы, входящие в данное
//- решение, получают модификатор .ss-comp-item--active (тёмный фон
//- + белый текст — тот же вид, что hover у обычной плашки).
//- ============================================================
- var caseDeliveryItems = [{ title: 'Редукционный клапан', text: 'Регулирует давление пара на выходе. TLV, Baelz, Samson по параметрам объекта', active: true }, { title: 'Охладитель пара', text: 'Для БРОУ — впрыск питательной воды, снижение температуры до заданной' }, { title: 'Регулирующая арматура', text: 'Регуляторы давления и температуры, позиционеры, приводы' }, { title: 'Запорная арматура', text: 'Вентили, шаровые краны, задвижки — нержавеющая или легированная сталь' }, { title: 'КИПиА', text: 'Манометры, термометры, датчики давления и температуры, импульсные трубки' }, { title: 'Фильтры и сепараторы', text: 'Защита клапанов от конденсата и механических примесей' }, { title: 'Предохранительные клапаны', text: 'Защита системы при превышении давления' }, { title: 'Автоматика и щит управления', text: 'ПЛК, HMI, дистанционное управление — по требованию', active: true }, { title: 'Рама / блок в сборе', text: 'Смонтировано на несущей раме, прошло заводские испытания, готово к монтажу' }]

section.ss-section.ss-case-delivery
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				span.ss-kicker Состав поставки
				h2.ss-h2 Что входит в решение
				p.ss-case-delivery__desc
					| Поставляем как полностью собранный модуль на раме — готовый к монтажу. Границы поставки согласуются индивидуально.

		ul.ss-case-delivery__grid
			each item, i in caseDeliveryItems
				li(class='ss-comp-item' + (item.active ? ' ss-comp-item--active' : ''))
					span.ss-comp-item__num= ('0' + (i + 1)).slice(-2)
					.ss-comp-item__body
						h3.ss-comp-item__title= item.title
						p.ss-comp-item__text= item.text
