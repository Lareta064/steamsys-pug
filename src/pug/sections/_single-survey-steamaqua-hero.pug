section.ss-hero-inner.ss-hero-inner--dark.ss-single-survey__hero
	.ss-hero-inner__crumbs
		.ss-container.ss-wrapper
			nav.ss-breadcrumbs(aria-label='Хлебные крошки')
				ol.ss-breadcrumbs__list
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='./') Главная
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='./docs.html') Документация
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='./surveys.html') Опросные листы
					li.ss-breadcrumbs__item.ss-breadcrumbs__item--current(aria-current='page') SteamAqua ГВС

	.ss-hero-inner__body
		.ss-container.ss-wrapper
			.ss-hero-inner__body-inner
				span.ss-kicker Заявка
				h1.ss-h2 Автоматическая станция ГВС SteamAqua
				p.ss-hero-inner__lead Заполните параметры&nbsp;— инженер подберёт автоматическую станцию ГВС SteamAqua под&nbsp;ваш объект и&nbsp;пришлёт КП в&nbsp;течение 1&nbsp;рабочего дня.
				.ss-hero-inner__actions
					+ssBtn('О станциях ГВС SteamAqua', { variant: 'primary', tag: 'a', href: '#' })
