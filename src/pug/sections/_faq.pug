//- ============================================================
//- FAQ-секция страницы каталога оборудования. Единый компонент .ss-faq.
//- ============================================================
- var faqItems = [{ q: 'Как выбрать тип конденсатоотводчика?', a: 'По среде, расходу конденсата, давлению и температуре. Поплавковые — для непрерывного расхода без паровых потерь. Термодинамические — для перегретого пара и высоких давлений. Термостатические — там, где нужно отводить воздух и неконденсируемые газы.' }, { q: 'Какие параметры нужно знать для подбора?', a: 'Рабочее давление (бар), температура среды (°C), расход конденсата (кг/ч), диаметр DN, тип присоединения (резьба/фланец), материал корпуса. Если параметры неизвестны — инженер уточнит по описанию системы.' }, { q: 'Как подобрать аналог под замену?', a: 'Укажите DN, PN и марку заменяемого оборудования. Подбираем аналоги под Spirax Sarco, Gestra, ARI, Yoshitake и другие марки. Инженер подберёт совместимую замену с сохранением технических характеристик.' }]

section.ss-section.ss-section--tinted.ss-faq.ss-bg-gray
	.ss-container.ss-wrapper
		.ss-faq__grid
			.ss-faq__intro
				span.ss-kicker Поддержка
				h2.ss-h2 Часто спрашивают
				p.ss-faq__desc
					| Ответили на частые вопросы по подбору конденсатоотводчиков, параметрам и аналогам.

				.ss-faq__contact
					span.ss-faq__contact-icon(aria-hidden='true')
						+svgIcon('message')
					.ss-faq__contact-body
						h3.ss-faq__contact-title Не нашли ответа на&nbsp;свой вопрос?
						p.ss-faq__contact-text
							| Напишите вашу задачу — наши инженеры изучат ваш запрос и ответят по вашему случаю.
						.ss-faq__contact-action
							+ssBtn('Задать вопрос', { variant: 'primary', icon: 'arrow-right' })(data-modal='request-b24')

			.ss-faq__list
				.ss-accordion(data-accordion)
					each item, i in faqItems
						+ssAccordionItem(item.q, 'catalog-faq-' + (i + 1))
							p= item.a
