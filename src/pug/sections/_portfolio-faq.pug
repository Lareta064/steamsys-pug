//- ============================================================
//- FAQ-секция страницы «Готовые системы и решения».
//- Единый компонент .ss-faq.
//- ============================================================
- var portfolioFaqItems = [{ q: 'Что такое готовая система и чем она отличается от индивидуального проекта?', a: 'Готовая система — это типовой блочный узел с отработанной конструкцией, который адаптируется под параметры вашего объекта. В отличие от проектирования с нуля, расчёт занимает 1 рабочий день, документация уже готова, стоимость ниже. Для нестандартных задач мы выполняем индивидуальное проектирование.' }, { q: 'Сколько времени занимает подбор и расчёт системы?', a: 'Для стандартных типоразмеров — расчёт и коммерческое предложение в течение 1 рабочего дня после получения заполненного опросного листа. Для нестандартных параметров или сложных объектов — от 3 до 5 рабочих дней.' }, { q: 'Что входит в комплект поставки?', a: 'В стандартный комплект входят: блочная установка в сборе, технический паспорт, принципиальная схема, монтажный чертёж, сертификаты на оборудование, инструкция по монтажу и эксплуатации. По запросу — CAD/BIM-модели и дополнительные технические материалы.' }, { q: 'Выполняете ли вы монтаж и пусконаладку?', a: 'Да, мы выполняем полный цикл: от поставки до сдачи объекта в эксплуатацию. Монтажные работы производятся сертифицированными специалистами. После монтажа проводим пусконаладку и обучение эксплуатационного персонала.' }, { q: 'Предоставляете ли вы гарантию на оборудование и работы?', a: 'На поставляемое оборудование действует гарантия производителя — от 12 до 36 месяцев в зависимости от типа оборудования. На монтажные работы — гарантия 12 месяцев. Круглосуточная техподдержка включена в гарантийный период.' }]

section.ss-section.ss-section--tinted.ss-faq.ss-bg-gray
	.ss-container.ss-wrapper
		.ss-faq__grid
			.ss-faq__intro
				span.ss-kicker Поддержка
				h2.ss-h2 Часто задаваемые вопросы
				p.ss-faq__desc
					| Ответили на частые вопросы по готовым системам, подбору, поставке и гарантии.

				.ss-faq__contact
					span.ss-faq__contact-icon(aria-hidden='true')
						+svgIcon('message')
					.ss-faq__contact-body
						h3.ss-faq__contact-title Не нашли ответа на&nbsp;свой вопрос?
						p.ss-faq__contact-text
							| Напишите вашу задачу — наши инженеры изучат ваш запрос и ответят по вашему случаю.
						.ss-faq__contact-action
							+ssBtn('Задать вопрос', { variant: 'primary', icon: 'arrow-right' })(data-modal='request-b24')

			.ss-faq__list
				.ss-accordion(data-accordion)
					each item, i in portfolioFaqItems
						+ssAccordionItem(item.q, 'portfolio-faq-' + (i + 1))
							p= item.a
