//- ============================================================
//- «В каких системах используются» — секция на странице каталога.
//- Карточки типа «По оборудованию» (ss-process-card--photo):
//- тёмный фон + фото в правом нижнем углу + title/text слева + CTA
//- со стрелкой. Grid 4/3/2/1 по брейкпоинтам.
//- Картинки — process-*.webp (пока ставим ближайшие по смыслу,
//- заказчик может заменить индивидуальными).
//- ============================================================
- var usageItems = [{ title: 'Станции возврата конденсата (СВК)', text: 'Поплавковые и насосные КО обеспечивают непрерывный дренаж конденсата из сборного бака в систему возврата.', cta: 'Подробнее о СВК', href: '#usage-svk', img: 'process-production-line' }, { title: 'Обвязка паровых калориферов', text: 'Термодинамические и поплавковые КО защищают калорифер от замерзания и обеспечивают полный дренаж при остановке.', cta: 'Подробнее об обвязке', href: '#usage-calorifer', img: 'process-calorifer' }, { title: 'Обвязка теплообменников', text: 'Поплавковые КО с непрерывным дренажем — основной вид для кожухотрубных и пластинчатых ТО с паровым обогревом.', cta: 'Подробнее', href: '#usage-heat-exchanger', img: 'process-heat-exchanger' }, { title: 'Дренаж РОУ и БРОУ', text: 'КО на дренажных линиях редукционных установок предотвращают накопление конденсата и обеспечивают качество пара.', cta: 'Подробнее о РОУ/БРОУ', href: '#usage-roy', img: 'process-reactor' }, { title: 'ИТП ГВС', text: 'Дренажные КО на паровых вводах и теплообменниках ИТП. Работают в условиях переменной нагрузки.', cta: 'Подробнее', href: '#usage-itp', img: 'process-teplopunkt' }, { title: 'Паровые трубопроводы', text: 'Дренажные горшки на конденсатных карманах магистрального паропровода — защита от гидроударов.', cta: 'Схемы установки', href: '#usage-pipe', img: 'process-dryer' }]

section.ss-section.ss-usage
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				h2.ss-h2 В каких системах используются
				p.ss-usage__desc Конденсатоотводчики применяются в большинстве паровых систем — от обвязки теплообменников до дренажа редукционных установок.

		.ss-grid.ss-grid--row-3.ss-grid--xxl-row-2.ss-grid--md-row-1
			each u in usageItems
				article.ss-process-card.ss-process-card--photo
					.ss-process-card__body
						p.ss-process-card__title= u.title
						p.ss-process-card__text= u.text
					a.ss-process-card__cta(href=u.href)
						span.ss-process-card__cta-arrow(aria-hidden='true') →
						= ' ' + u.cta
					picture.ss-process-card__photo
						source(srcset=`${basePath}img/${u.img}.webp`)
						img(src=`${basePath}img/${u.img}.webp` width='320' height='213' alt='' loading='lazy' decoding='async')
