- var usageItems = [{ title: 'Станции возврата конденсата (СВК)', desc: 'Поплавковые и насосные КО обеспечивают непрерывный дренаж конденсата из сборного бака в систему возврата.', linkText: 'Подробнее о СВК' }, { title: 'Обвязка паровых калориферов', desc: 'Термодинамические и поплавковые КО защищают калорифер от замерзания и обеспечивают полный дренаж при остановке.', linkText: 'Подробнее об обвязке' }, { title: 'Обвязка теплообменников', desc: 'Поплавковые КО с непрерывным дренажем — основной вид для кожухотрубных и пластинчатых ТО с паровым обогревом.', linkText: 'Подробнее' }, { title: 'Дренаж РОУ и БРОУ', desc: 'КО на дренажных линиях редукционных установок предотвращают накопление конденсата и обеспечивают качество пара.', linkText: 'Подробнее о РОУ/БРОУ' }, { title: 'ИТП ГВС', desc: 'Дренажные КО на паровых вводах и теплообменниках ИТП. Работают в условиях переменной нагрузки и перебоев давления.', linkText: 'Подробнее' }, { title: 'Паровые трубопроводы', desc: 'Дренажные горшки на конденсатных карманах магистрального паропровода — защита от гидроударов и повышение качества пара.', linkText: 'Схемы установки' }]

section.ss-section.ss-usage
	.ss-container.ss-wrapper
		.ss-usage__intro
			h2.ss-h2 В каких системах используются
			p.ss-usage__lead Конденсатоотводчики применяются в большинстве паровых систем — от обвязки теплообменников до дренажа редукционных установок.
		.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1
			each item in usageItems
				article.ss-info-card
					h3.ss-semi-20= item.title
					p.ss-reg-16.ss-txt-secondary= item.desc
					+ssLink(item.linkText)
