section.ss-section.ss-section--tinted.ss-bg-gray.ss-team__members
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				h2.ss-h2 Вся команда
				p.ss-semi-16.ss-txt-secondary 11 специалистов. Роль в карточке показывает, чем занимается человек&nbsp;— инжиниринг, продажи, документация или операции.

		ul.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1
			each m in teamMembers
				li
					article.ss-team-card
						a.ss-team-card__permalink(href=m.href aria-label=m.name)
						.ss-team-card__avatar
							- var avatarSrc = m.avatar || 'persone'
							img(src=`${basePath}img/${avatarSrc}.webp` width='80' height='80' alt=m.name loading='lazy' decoding='async')
						.ss-team-card__body
							h3.ss-team-card__name= m.name
							p.ss-team-card__role= m.role
							.ss-team-card__tags
								each tag in m.tags
									span(class=`ss-tag ss-tag--mini${tag.mod ? ' ' + tag.mod : ''}`)= tag.label
							p.ss-team-card__bio= m.bio
							//- if m.cta
							//- 	.ss-team-card__action
							//- 		+ssBtn(m.cta, { variant: 'primary', xsFull: true, tag: 'a', href: '#' })
