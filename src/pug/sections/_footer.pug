//- Миксин для одного контакт-айтема. Опциональный href превращает значение
//- в кликабельную <a> (для телефона/почты — tel: / mailto:).
mixin contactItem(label, value, sizeClass, href)
	li.ss-contacts-list__item
		p.ss-contacts-list__label= label
		if href
			a.ss-contacts-list__value(class=sizeClass, href=href)!= value
		else
			p.ss-contacts-list__value(class=sizeClass)!= value

footer.ss-footer.ss-wrapper
	.ss-container

		//- ==================== Ряд 1: top (brand + nav) ====================
		.ss-footer__top
			.ss-footer__brand
				+svgIcon('logo', { sprite: 'logo-sprite' })(class='svg-logo--white')
				p.ss-footer__brand-desc.ss-medi-16 Пароконденсатные системы для промышленности
				+socialGroup(['whatsapp', 'telegram'])(class='ss-social--white')

			.ss-footer__nav
				each item in navItems
					.ss-footer-nav__item
						input.ss-footer-nav__toggle(type='checkbox', id='ftr-' + item.id, hidden)
						label.ss-footer-nav__title(for='ftr-' + item.id)
							span.ss-footer-nav__title-text= item.title
							+svgIcon('chevron-down')(class='ss-footer-nav__arrow')
						ul.ss-footer-nav__list
							each link in item.links
								li: a.ss-footer-nav__link(href=link.href)= link.text

		//- ==================== Ряд 2: contacts + buttons ====================
		.ss-footer__contacts
			ul.ss-contacts-list.ss-contacts-list--row
				+contactItem('Телефон', '+7 (812) 602-77-70', null, 'tel:+78126027770')
				+contactItem('Почта', 'info@steamsys.ru', null, 'mailto:info@steamsys.ru')
				+contactItem('Режим работы', 'Работаем: Пн - Пт с 9:00 до 18:00<br>Выходной: Сб - Вс', 'ss-medi-16')
				+contactItem('Адрес', 'Санкт-Петербург,<br>ул. Воронежская, д. 5, оф. 123', 'ss-medi-16')
			.ss-footer__contacts-actions
				+ssBtn('Реквизиты', { variant: 'white', icon: 'book' })
				+ssBtn('Получить КП', { variant: 'primary', icon: 'arrow-right' })(data-modal='request')

		//- ==================== Ряд 3: bottom (copyright / links / KOGIT) ====================
		.ss-footer-bottom
			p.ss-footer-bottom__copy.ss-medi-16 © 2008–2026 | ООО «Паровые системы» | ИНН 7816436595 | Все права защищены
			a.ss-footer-bottom__link.ss-medi-14(href='#') СОУТ
			a.ss-footer-bottom__link.ss-medi-14(href='#') Политика конфиденциальности
			p.ss-footer-bottom__dev.ss-reg-14
				| Разработка сайта: #[a(href='#') KOGIT]
