section.ss-section.ss-section--tinted.ss-bg-gray.ss-surveys__list
	.ss-container.ss-wrapper

		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				p.ss-kicker.ss-txt-secondary Выберите тип
				h2.ss-h2 Все опросные листы

		.ss-callout.ss-callout--warning.ss-surveys__urgency
			span.ss-callout__icon ⚡
			.ss-callout__body
				| Нужен срочный расчёт? Позвоните:&nbsp;
				strong +7 (812) 602-77-70
				|  — инженер примет параметры по телефону и подготовит КП без опросного листа.

		ul.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1.ss-surveys__grid
			each item in surveyItems
				li
					article(class='ss-survey-card' + (item.featured ? ' ss-survey-card--featured' : ''))
						.ss-survey-card__head
							if item.badge
								span.ss-survey-card__badge= item.badge
							h3.ss-survey-card__title= item.title
							p.ss-survey-card__sub= item.sub
						.ss-survey-card__body
							ul.ss-survey-card__fields
								each f in item.fields
									li= f
							.ss-survey-card__actions
								+ssBtn('Заполнить онлайн', { variant: 'dark', tag: 'a', href: '#' })

		.ss-surveys__pagination
			p.ss-surveys__pagination-summary
				| Показано&nbsp;
				strong 9
				|  из&nbsp;
				strong 24
				|  опросных листов
			nav.ss-pagination(aria-label='Страницы опросных листов')
				ol.ss-pagination__list
					li.ss-pagination__item
						a.ss-pagination__link(href='#', aria-current='page') 1
					li.ss-pagination__item
						a.ss-pagination__link(href='#') 2
					li.ss-pagination__item
						a.ss-pagination__link(href='#') 3
					li.ss-pagination__item
						a.ss-pagination__link.ss-pagination__link--nav(href='#')
							| Следующая
							+svgIcon('arrow-right')
