- var casesCatalog = [{ kicker: 'БРОУ / Пищевая промышленность', title: 'Замена БРОУ на сахарном заводе: снижение давления с 16 до 4 бар', text: 'Устаревший узел БРОУ создавал нестабильное давление в технологических контурах. Заменили на современную установку с электронным регулятором и системой диагностики.', metrics: [{ value: '−15%', label: 'расход пара' }, { value: '14 мес.', label: 'окупаемость' }], bg: 'gallery1', alt: 'Сахарный завод — БРОУ', href: '#' }, { kicker: 'СВК / Химическая промышленность', title: 'Монтаж станции возврата конденсата на химическом производстве', text: 'Предприятие сбрасывало конденсат в канализацию из-за отсутствия системы сбора. Спроектировали и поставили СВК с буферным баком и насосным агрегатом.', metrics: [{ value: '−20%', label: 'затраты на воду' }, { value: '10 мес.', label: 'окупаемость' }], bg: 'gallery2', alt: 'Химический завод — СВК', href: '#' }, { kicker: 'Обвязка / Энергетика', title: 'Обвязка паровых калориферов на теплоэлектростанции', text: 'Частые гидроудары выводили из строя запорную арматуру. Установили конденсатоотводчики TLV и переработали схему обвязки с оптимизацией уклонов.', metrics: [{ value: '0', label: 'гидроударов за сезон' }, { value: '8 мес.', label: 'окупаемость' }], bg: 'gallery3', alt: 'ТЭС — обвязка калориферов', href: '#' }, { kicker: 'ИТП / ЖКХ', title: 'Автоматизированный ИТП для жилого комплекса в Москве', text: 'Устаревший тепловой пункт не обеспечивал нужных параметров ГВС. Поставили и ввели в эксплуатацию АИТП с погодозависимым регулированием.', metrics: [{ value: '−18%', label: 'расход тепла' }, { value: '24 мес.', label: 'окупаемость' }], bg: 'gallery1', alt: 'ИТП жилого комплекса', href: '#' }, { kicker: 'РОУ / Фармацевтика', title: 'Система редуцирования пара для фармпроизводства GMP', text: 'Требования GMP к качеству пара — чистый пар 2-го класса. Реализовали двухступенчатое редуцирование с сепараторами и автоматикой.', metrics: [{ value: '99.9%', label: 'чистота пара' }, { value: '16 мес.', label: 'окупаемость' }], bg: 'gallery2', alt: 'Фармпроизводство — РОУ', href: '#' }, { kicker: 'СВК / ЦБП', title: 'Возврат конденсата на целлюлозно-бумажном комбинате', text: 'Высокотемпературный конденсат сбрасывался в дренаж. Спроектировали напорную СВК с насосными агрегатами и системой очистки.', metrics: [{ value: '−22%', label: 'затраты на водоподготовку' }, { value: '18 мес.', label: 'окупаемость' }], bg: 'gallery3', alt: 'ЦБК — возврат конденсата', href: '#' }]

section.ss-section.ss-cases-catalog
	.ss-container.ss-wrapper
		.ss-section-header
			.ss-section-header__title
				h2.ss-h2 Реализованные проекты
			.ss-slider-nav.ss-slider-nav--accent
				+ssSwiperBtn('prev')
				+ssSwiperBtn('next')

		.swiper.swiper-pb.swiper-bars.js-cases-slider
			.swiper-wrapper
				each c in casesCatalog
					.swiper-slide
						article.ss-case-card.ss-case-card--portfolio
							.ss-case-card__image
								picture
									source(media='(max-width: 767px)' srcset=`${basePath}img/${c.bg}-mob.webp 1x, ${basePath}img/${c.bg}-mob@2x.webp 2x`)
									source(srcset=`${basePath}img/${c.bg}.webp 1x, ${basePath}img/${c.bg}@2x.webp 2x`)
									img(src=`${basePath}img/${c.bg}.webp` width='865' height='360' alt=c.alt loading='lazy' decoding='async')
							.ss-case-card__body
								p.ss-case-card__kicker= c.kicker
								h3.ss-case-card__title= c.title
								p.ss-case-card__text= c.text
								.ss-metrics
									each m in c.metrics
										.ss-metrics__item
											p.ss-metrics__value= m.value
											p.ss-metrics__label= m.label
							.ss-case-card__footer
								+ssLink('Читать кейс')(href=c.href)
			.swiper-pagination
