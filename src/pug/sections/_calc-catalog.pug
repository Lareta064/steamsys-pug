нны пара при известных ценах на топливо, воду и КПД котельной.' }, { title: 'Экономия от повышения КПД котла', text: 'Экономия топлива при повышении КПД котла на 1% и выше.' }] }, { id: 'calc-tables', title: 'Таблицы', count: 3, items: [{ title: 'Параметры насыщенного пара', text: 'Таблица температуры, теплосодержания и теплоты парообразования от 0 до 40 бар.' }, { title: 'Температура / давление пара', text: 'Пересчёт давления в температуру насыщения и обратно.' }, { title: 'Пересчёт единиц измерения', text: 'Калькулятор пересчёта давления, расхода, мощности и температуры в разных системах единиц.' }] }]

section.ss-doc-layout.ss-doc-layout--with-toc.ss-calc-catalog
	.ss-container.ss-container--narrow.ss-wrapper
		.ss-doc-layout__grid

			.ss-doc-layout__main
				each cat in calcCategories
					section(id=cat.id).ss-calc-catalog__group
						h2.ss-h5= cat.title
						.ss-grid.ss-grid--row-1
							each c in cat.items
								article.ss-calc-card
									.ss-calc-card__body
										h3.ss-calc-card__title= c.title
										p.ss-calc-card__text= c.text
									.ss-calc-card__action
										+ssBtn('Рассчитать', { variant: 'primary', icon: 'arrow-right', tag: 'a', href: '#' })

			aside.ss-sticky-side.ss-doc-layout__aside
				//- Якорная навигация по категориям. Reuse .ss-toc.
				//- Расширенная разметка ссылки: __label + __count (pill-счётчик
				//- в конце строки) — поддержано базовым компонентом.
				//- Scroll-spy — JS src/js/toc.js.
				nav.ss-toc.js-toc(aria-label='Категории калькуляторов')
					button.ss-toc__toggle(type='button', aria-expanded='false', aria-controls='calc-toc-body')
						span Разделы
						+svgIcon('chevron-down')
					h3.ss-toc__title Разделы
					.ss-toc__body#calc-toc-body(hidden)
						ul.ss-toc__list
							each cat in calcCategories
								li.ss-toc__item
									a.ss-toc__link(href=`#${cat.id}`)
										span.ss-toc__label= cat.title
										span.ss-toc__count= cat.count

			.ss-doc-layout__mobile-extras(data-doc-mobile-extras)
