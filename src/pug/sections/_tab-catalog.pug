- var tabs = [{ label: 'Конденсатоотводчики', img: 'tool1', desc: 'TLV, Yoshitake. Поплавковые, термостатические, термодинамические. Подбор по параметрам, наличие на складе, документация.', tags: ['TLV', 'DN15-DN100'] }, { label: 'Регулирующая арматура', img: 'tool2', desc: 'Клапаны регулирующие, отсечные и предохранительные. Baelz, отечественные аналоги. Технический подбор по параметрам.', tags: ['Baelz', 'Автоматика', 'DN15-DN300'] }, { label: 'КИПиА и измерения', img: 'tool3', desc: 'Датчики давления и температуры, расходомеры, вторичные приборы, системы мониторинга и учёта. Комплексные решения для контроля процессов.', tags: ['Датчики', 'Расходомеры'] }]

section.ss-section.ss-tab-catalog
	.ss-container.ss-wrapper
		p.ss-kicker Оборудование
		h2.ss-h2.ss-tab-catalog__title Оборудование для пара и конденсата
		.ss-tabs.ss-tab-catalog__grid
			.ss-tab-catalog__aside
				.ss-tabs__list
					each t, i in tabs
						button.ss-tabs__tab(type='button', class=(i === 0 ? 'is-active' : null))= t.label
			.ss-tabs__panels
				each t, i in tabs
					.ss-tabs__panel(class=(i === 0 ? 'is-active' : null))
						.ss-tab-catalog__panel
							.ss-tab-catalog__text
								h4.ss-h4.ss-tab-catalog__panel-title= t.label
								p.ss-tab-catalog__desc= t.desc
								.ss-tag-group
									each tag in t.tags
										span.ss-tag.ss-tag--dark= tag
								+ssLink('В каталог')
							picture.ss-tab-catalog__image
								source(media='(max-width: 767px)' srcset=`${basePath}img/${t.img}-mob.webp 1x, ${basePath}img/${t.img}-mob@2x.webp 2x`)
								source(media='(min-width: 768px)' srcset=`${basePath}img/${t.img}.webp 1x, ${basePath}img/${t.img}@2x.webp 2x`)
								img(src=`${basePath}img/${t.img}.webp`, width=418, height=388, alt=t.label, loading='lazy', decoding='async')
