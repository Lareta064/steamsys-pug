- var taskFormSteps = [{ title: 'Опишите задачу в свободной форме', desc: 'Что нужно сделать, какое оборудование, параметры пара если известны' }, { title: 'Инженер свяжется в течение 1 рабочего дня', desc: 'Уточнит детали и предложит решение с предварительным расчётом' }, { title: 'Получите КП и техническое решение', desc: 'Схема, спецификация, стоимость — без обязательств с вашей стороны' }]

section.ss-section.ss-section--tinted.ss-task-form
	.ss-container.ss-wrapper
		.ss-task-form__grid
			//- Левая колонка — intro + список шагов (ss-list--icon с цифрами в маркере).
			.ss-task-form__intro
				span.ss-kicker Индивидуальный подход
				h2.ss-h2 Не нашли нужное решение?
				p.ss-task-form__desc
					| Если ваша задача не вписывается в типовые системы — опишите её. Инженер разберётся в специфике объекта и предложит оптимальный вариант: адаптацию готового решения или индивидуальное проектирование.

				ul.ss-list.ss-list--icon.ss-task-form__steps
					each step, i in taskFormSteps
						li.ss-list__item
							span.ss-list__marker= i + 1
							.ss-task-form__step-body
								p.ss-task-form__step-title= step.title
								p.ss-task-form__step-desc= step.desc

			//- Правая колонка — белая коробка с заголовком + Битрикс-формой (светлая тема).
			.ss-task-form__card
				p.ss-task-form__form-title Опишите вашу задачу
				p.ss-task-form__form-subtitle Специалист подберёт решение и свяжется с вами

				.ss-b24-form.ss-b24-form--light
					.b24-form
						.b24-form-wrapper
							.b24-form-content
								.b24-form-padding-side

									.b24-form-field.b24-form-field-name.b24-form-field-string
										.b24-form-control-container
											.b24-form-control-label
												span.b24-form-control-label-name Ваше имя
												span.b24-form-control-label-required *
											input.b24-form-control.b24-form-control-string(type='text', name='NAME', placeholder=' ')

									.b24-form-field.b24-form-field-phone
										.b24-form-control-container
											.b24-form-control-label
												span.b24-form-control-label-name Телефон
												span.b24-form-control-label-required *
											input.b24-form-control.b24-form-control-string(type='tel', name='PHONE', placeholder=' ')

									.b24-form-field.b24-form-field-email
										.b24-form-control-container
											.b24-form-control-label
												span.b24-form-control-label-name Email
											input.b24-form-control.b24-form-control-string(type='email', name='EMAIL', placeholder=' ')

									//- File-поле — структура под реальный битрикс-DOM. В production
									//- битрикс-скрипт сам инжектит button и вешает JS-открытие диалога.
									//- В dev-моке используем <label>, оборачивающий скрытый
									//- <input type="file">, — нативное поведение браузера открывает
									//- диалог без JS. Скрепку рисует SCSS через ::before.
									.b24-form-field.b24-form-field-file
										.b24-form-control-container
											.b24-form-control-label
												span.b24-form-control-label-name Прикрепить файл
											.b24-form-control.b24-form-control-file
												label.b24-form-control-file-button
													input.b24-form-control-file-input(type='file', name='FILE', hidden)
													| Прикрепить файлы

									.b24-form-field.b24-form-field-text
										.b24-form-control-container
											.b24-form-control-label
												span.b24-form-control-label-name Опишите задачу: что нужно сделать, тип оборудования, параметры пара (если известны), объём
											textarea.b24-form-control.b24-form-control-textarea(name='COMMENTS', placeholder=' ')

									.b24-form-field.b24-form-field-agreement
										label.b24-form-field-agreement-label
											.b24-form-control-agreement
												.b24-form-control-agreement-checkbox
													input.b24-form-control-agreement-checkbox-input(type='checkbox', name='AGREEMENT')
													span.b24-form-control-agreement-checkbox-square
												.b24-form-control-agreement-text
													| Нажимая кнопку, вы соглашаетесь с
													a(href='#') политикой конфиденциальности

							.b24-form-btn-block
								.b24-form-btn-container
									button.b24-form-btn.b24-form-btn-shadow(type='submit')
										span.b24-form-btn-text Отправить задачу инженеру
