- var filterGroups = [{ id: 'filter-type', title: 'Тип', open: false, search: true, items: [{ label: 'Со свободноплавающим поплавком', count: 24, checked: true }, { label: 'Поплавковые для больших расходов', count: 18 }, { label: 'Термодинамические', count: 16 }, { label: 'Термостатические', count: 10 }, { label: 'Для сжатого воздуха', count: 8 }] }, { id: 'filter-brand', title: 'Бренд', open: false, search: true, items: [{ label: 'TLV', count: 24, checked: true }, { label: 'Yoshitake', count: 18 }] }, { id: 'filter-conn', title: 'Присоединение', open: false, type: 'radio', name: 'filter-conn', items: [{ label: 'Резьбовое' }, { label: 'Фланцевое' }, { label: 'Приварное' }] }, { id: 'filter-material', title: 'Материал корпуса', open: false, items: [{ label: 'Сталь' }, { label: 'Чугун' }, { label: 'Нерж. сталь' }] }, { id: 'filter-dn', title: 'DN, мм', open: false, type: 'range', range: { from: 15, to: 50, unit: 'DN' } }, { id: 'filter-pn', title: 'PN, бар', open: false, type: 'range', range: { from: 16, to: 40, unit: 'PN' } }, { id: 'filter-temp', title: 'Температура среды, °C', open: false, type: 'range', range: { from: 100, to: 400, unit: 'Температура' } }]

//- Трёхуровневая навигация по категориям в sidebar каталога.
//- Разметка — nav.ss-category-nav; поведение — src/js/accordion.js.
- var categoryNav = { title: 'Категория', panels: [{ id: 'category-root', aria: 'Первый уровень категорий', items: [{ label: 'Конденсатоотводчики', openPanel: 'category-condensate', selected: true }, { label: 'Конденсатные насосы' }, { label: 'Клапаны и арматура' }, { label: 'Автоматика' }] }, { id: 'category-condensate', aria: 'Второй уровень категорий', hidden: true, trail: [{ label: '← Конденсатоотводчики', backPanel: 'category-root' }], items: [{ label: 'Со свободноплавающим поплавком', openPanel: 'category-free-float', selected: true }, { label: 'Поплавковые для больших расходов' }, { label: 'Термодинамические' }, { label: 'Термостатические' }, { label: 'Для сжатого воздуха' }] }, { id: 'category-free-float', aria: 'Третий уровень категорий', hidden: true, trail: [{ label: '← Конденсатоотводчики', backPanel: 'category-root' }, { label: '← Со свободноплавающим поплавком', backPanel: 'category-condensate' }], items: [{ label: 'Конденсатоотводчики серии JX', href: '#catalog', selected: true }, { label: 'Конденсатоотводчики серии SJ', href: '#catalog' }, { label: 'Конденсатоотводчики серии SJH', href: '#catalog' }, { label: 'Конденсатоотводчики серии SS, SH', href: '#catalog' }, { label: 'Конденсатоотводчики для чистого пара', href: '#catalog' }, { label: 'Конденсатоотводчики серии JH', href: '#catalog' }] }] }

//- Триггер «Фильтры» — не здесь. Страница-потребитель (напр. _catalog.pug
//- в toolbar, /ui/filters.html рядом с колонкой) ставит его сама, чтобы
//- каждая раскладка могла позиционировать триггер по своим правилам.
//- CSS триггера (.ss-filters-trigger) живёт в _filters.scss.

//- Drawer-обёртка: на десктопе прозрачный контейнер (сайдбар виден штатно),
//- на <$xl превращается в fixed-панель справа с overlay.
.ss-filters-drawer#filters-drawer
	.ss-filters-drawer__overlay
	.ss-filters-drawer__panel
		button.ss-filters-drawer__close.js-filters-close(type='button' aria-label='Закрыть фильтры')
			+svgIcon('cross')
		aside.ss-filters
			//- Пошаговый селектор категорий (три уровня).
			//- JS — src/js/accordion.js: раскрытие/возврат панелей, подсветка selected.
			nav.ss-category-nav(aria-label='Категории оборудования')
				p.ss-category-nav__title= categoryNav.title
				each panel in categoryNav.panels
					section.ss-category-nav__panel(id=panel.id aria-label=panel.aria hidden=panel.hidden)
						if panel.trail
							.ss-category-nav__trail
								each t in panel.trail
									button.ss-category-nav__back(type='button' data-category-back=t.backPanel)!= t.label.replace('← ', '←&nbsp; ')
						ul.ss-category-nav__list
							each item in panel.items
								li
									if item.href
										a.ss-category-nav__link(class=item.selected ? 'is-selected' : '' href=item.href aria-current=item.selected ? 'page' : null)= item.label
									else
										button.ss-category-nav__button(class=item.selected ? 'is-selected' : '' type='button' data-category-open=item.openPanel aria-pressed=item.selected ? 'true' : null)= item.label

			.ss-filters__groups(data-accordion)
				each g in filterGroups
					- var optionsId = g.id + '-options'
					.ss-filters__group.ss-accordion__item
						button.ss-accordion__header(type='button' aria-expanded=g.open ? 'true' : 'false' aria-controls=g.id)
							span.ss-accordion__title= g.title
							+svgIcon('chevron-down')(class='ss-filters__chevron')
						.ss-accordion__body(id=g.id)
							.ss-accordion__body-inner
								.ss-accordion__body-content
									//- Range-группа — два input'а «От/До» вместо списка опций.
									if g.type === 'range'
										.ss-filters__range-labels(aria-hidden='true')
											span От
											span До
										.ss-filters__range-fields
											input(type='number' value=g.range.from aria-label=`${g.range.unit} от`)
											span.ss-filters__range-separator(aria-hidden='true') –
											input(type='number' value=g.range.to aria-label=`${g.range.unit} до`)
									else
										//- Поиск внутри списка опций (если group.search = true).
										if g.search
											label.ss-filters__search(data-filter-search=optionsId)
												span.ss-filters__search-icon(aria-hidden='true')
												span.ss-visually-hidden= `Поиск по: ${g.title}`
												input(type='search' placeholder=`Найти...`)
										ul.ss-filters__list(id=optionsId)
											each item in g.items
												li
													if g.type === 'radio'
														label.ss-radio.ss-radio--light
															input.ss-radio__input(type='radio' name=g.name checked=item.checked)
															span.ss-radio__box
															span.ss-radio__label= item.label
													else
														label.ss-checkbox.ss-checkbox--light
															input.ss-checkbox__input(type='checkbox' checked=item.checked)
															span.ss-checkbox__box
															span.ss-checkbox__label= item.label
													if item.count !== undefined
														span.ss-filters__count= item.count
			.ss-filters__footer
				+ssBtn('Применить фильтры', { variant: 'dark', full: true })
