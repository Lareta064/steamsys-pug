//- ============================================================
//- «Какие исходные данные нужны» — секция на странице кейса.
//- По структуре аналогично .ss-benefits на главной: section-header +
//- grid карточек с «шахматным» микс-паттерном (светлые + тёмные).
//- Карточки — наш .ss-comp-item с модификатором --active для тёмных
//- (как в .ss-case-delivery). Grid 3×2. Под карточками — 2 CTA-кнопки.
//- ============================================================
- var caseInputsItems = [{ title: 'Давление пара на входе / выходе', text: 'Давление перед РОУ (бар изб.) и требуемое давление после редуцирования. Допустимый диапазон колебаний.' }, { title: 'Расход пара', text: 'Объём потребления в т/ч или кг/ч. Максимальный, минимальный и средний расход при переменной нагрузке.', active: true }, { title: 'Температура пара (для БРОУ)', text: 'Температура на входе (°C) и требуемая температура после впрыска охладителя. Применимо для БРОУ с охлаждением.' }, { title: 'Режим работы', text: 'Непрерывный (24/7) или периодический. Количество запусков в сутки, критичность простоя, наличие резерва.', active: true }, { title: 'Требования к автоматике', text: 'Местное управление, электрический клапан с позиционером, ПЛК с HMI или интеграция в АСУ ТП (4–20 мА, Modbus).' }, { title: 'Файл / схема / опросный лист', text: 'P&ID или принципиальная схема пароснабжения, опросный лист — приложите к заявке для точного расчёта.', active: true }]

section.ss-section.ss-case-inputs
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				span.ss-kicker Для расчёта
				h2.ss-h2 Какие исходные данные нужны
				p.ss-case-inputs__desc
					| Подготовьте эти параметры — инженер подберёт РОУ/БРОУ и выдаст КП за 1 рабочий день.

		ul.ss-case-inputs__grid
			each item, i in caseInputsItems
				li(class='ss-comp-item' + (item.active ? ' ss-comp-item--active' : ''))
					span.ss-comp-item__num= ('0' + (i + 1)).slice(-2)
					.ss-comp-item__body
						h3.ss-comp-item__title= item.title
						p.ss-comp-item__text= item.text

		.ss-case-inputs__actions
			+ssBtn('Отправить параметры', { variant: 'dark', icon: 'arrow-right' })(data-modal='request-b24')
			+ssBtn('Заполнить опросный лист онлайн', { variant: 'outline-dark', icon: 'arrow-right' })
