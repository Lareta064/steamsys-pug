//- ============================================================
//- Секция одного кейса (используется в pages/single-case.pug).
//- Строится на универсальной раскладке .ss-doc-layout
//- (blocks/_doc-layout.scss): полоса крошек + двухколоночный grid
//- со sticky-sidebar справа.
//-
//- Специфика кейса:
//-   header — теги + h1 + 3 метрики результатов (стили в
//-            pages/_single-case.scss, классы .ss-single-case__*)
//-   main   — .ss-content с секциями кейса (объект → ситуация →
//-            входные параметры → решение → состав оборудования →
//-            результат → цитата → «что повторить»). Разметка внутри
//-            `.ss-content` — семантические теги (h2, p, ul, strong),
//-            стили авто-наследуются (рассчитано на HTML из админки).
//-   sidebar — TOC + CTA «Запросить» + .ss-case-details + solutions +
//-             .ss-help-card--tinted (CTA на калькулятор).
//-   mobile reflow: data-doc-extra / data-doc-mobile-extras
//-                  (JS — src/js/doc-layout.js)
//-
//- Под основной секцией — .ss-case-related с 2 карточками похожих кейсов.
//- ============================================================

//- ==================== Полоса хлебных крошек ====================
section.ss-doc-layout__crumbs
	.ss-container.ss-wrapper
		nav.ss-breadcrumbs(aria-label='Хлебные крошки')
			ol.ss-breadcrumbs__list
				li.ss-breadcrumbs__item
					a.ss-breadcrumbs__link(href='./') Главная
				li.ss-breadcrumbs__item
					a.ss-breadcrumbs__link(href='./cases-page.html') Кейсы
				li.ss-breadcrumbs__item.ss-breadcrumbs__item--current(aria-current='page') Диагностика и замена КО на молочном комбинате

//- ==================== Основная секция ====================
section.ss-doc-layout.ss-doc-layout--with-toc.ss-single-case
	.ss-container.ss-wrapper
		.ss-doc-layout__grid

			//- -------------------- Header (h1 + опциональная картинка) --------------------
			//- По макету fix-case.png / fix-case2.png — крупный заголовок,
			//- под ним опционально <figure> с картинкой и подписью. Если
			//- <figure> отсутствует — вёрстка не ломается (h1 просто имеет
			//- margin-bottom до следующего блока в main-колонке).
			header.ss-doc-layout__header.ss-single-case__hero
				h1.ss-h2.ss-single-case__hero-title Диагностика и замена конденсатоотводчиков на молочном комбинате — снижение потерь пара на&nbsp;15%

				figure.ss-single-case__hero-image
					img(src=`${basePath}img/gallery1.webp` width='865' height='400' alt='Устаревшее оборудование на объекте монтажа конденсатоотводчиков' loading='lazy' decoding='async')
					figcaption.ss-single-case__hero-caption Устаревшее оборудование на объекте монтажа конденсатоотводчиков

			//- -------------------- Main content (левая колонка) --------------------
			//- Внутри .ss-content — семантические теги. Стили заголовков,
			//- параграфов, списков, strong, цитат наследуются от _content.scss.
			//- Структурные блоки (fact-card, simple-table, metrics, quote-card,
			//- cta-row) — свои BEM-классы, живут между типографскими блоками.
			//-
			//- После .ss-content — слайдер «Похожие кейсы» (аналог cases-page):
			//- .ss-single-case__related-slider > .ss-case-card--portfolio
			//- Триггер .js-cases-slider подхватывается общим JS (cases-slider.js).
			.ss-doc-layout__main
				.ss-content

					//- ===== Паспорт проекта =====
					//- Page-level обёртка .ss-single-case__passport (стили в
					//- _single-case.scss). Внутри — универсальный UI-компонент
					//- .ss-info-grid (blocks/_info-grid.scss) с 9 полями.
					section#sec-passport.ss-single-case__passport
						h2 Паспорт проекта
						ul.ss-info-grid
							li.ss-info-grid__item
								span.ss-info-grid__icon(aria-hidden='true')
									img(src=`${basePath}img/user-blue-icon.webp` width='32' height='32' alt='' loading='lazy' decoding='async')
								.ss-info-grid__body
									p.ss-info-grid__label Клиент
									p.ss-info-grid__value Молочный комбинат «Вкусмол»
							li.ss-info-grid__item
								span.ss-info-grid__icon(aria-hidden='true')
									img(src=`${basePath}img/calendar-blue-icon.webp` width='32' height='32' alt='' loading='lazy' decoding='async')
								.ss-info-grid__body
									p.ss-info-grid__label Год реализации
									p.ss-info-grid__value 2023
							li.ss-info-grid__item
								span.ss-info-grid__icon(aria-hidden='true')
									img(src=`${basePath}img/tool-icon.webp` width='32' height='32' alt='' loading='lazy' decoding='async')
								.ss-info-grid__body
									p.ss-info-grid__label Оборудование
									p.ss-info-grid__value TLV, TUMA, фильтры Y-типа
							li.ss-info-grid__item
								span.ss-info-grid__icon(aria-hidden='true')
									img(src=`${basePath}img/shield-check-icon.webp` width='32' height='32' alt='' loading='lazy' decoding='async')
								.ss-info-grid__body
									p.ss-info-grid__label Отрасль
									p.ss-info-grid__value Молочная промышленность
							li.ss-info-grid__item
								span.ss-info-grid__icon(aria-hidden='true')
									img(src=`${basePath}img/doc-icon.webp` width='32' height='32' alt='' loading='lazy' decoding='async')
								.ss-info-grid__body
									p.ss-info-grid__label Тип объекта
									p.ss-info-grid__value Пищевое производство
							li.ss-info-grid__item
								span.ss-info-grid__icon(aria-hidden='true')
									img(src=`${basePath}img/cog-blue-icon.webp` width='32' height='32' alt='' loading='lazy' decoding='async')
								.ss-info-grid__body
									p.ss-info-grid__label Масштаб
									p.ss-info-grid__value 48 конденсатоотводчиков
							li.ss-info-grid__item
								span.ss-info-grid__icon(aria-hidden='true')
									img(src=`${basePath}img/target-icon.webp` width='32' height='32' alt='' loading='lazy' decoding='async')
								.ss-info-grid__body
									p.ss-info-grid__label Регион
									p.ss-info-grid__value Краснодарский край
							li.ss-info-grid__item
								span.ss-info-grid__icon(aria-hidden='true')
									img(src=`${basePath}img/center-icon-blue.webp` width='32' height='32' alt='' loading='lazy' decoding='async')
								.ss-info-grid__body
									p.ss-info-grid__label Вид работ
									p.ss-info-grid__value Диагностика и замена конденсатоотводчиков
							li.ss-info-grid__item
								span.ss-info-grid__icon(aria-hidden='true')
									img(src=`${basePath}img/chart-blue-icon.webp` width='32' height='32' alt='' loading='lazy' decoding='async')
								.ss-info-grid__body
									p.ss-info-grid__label Срок реализации
									p.ss-info-grid__value 6 месяцев

					//- ===== Ситуация (callout) =====
					section#sec-situation
						h2 Ситуация
						.ss-callout
							.ss-callout__body
								p На молочном комбинате «Вкусный» (Краснодарский край) эксплуатировалась пароконденсатная система с 48 конденсатоотводчиками различных типов. По данным энергетика предприятия, потери конденсата составляли около 35% от общего расхода пара. Часть оборудования не обслуживалась более 5 лет. Ни разу не проводилась инструментальная диагностика состояния КО. Руководство предприятия хотело понять реальный масштаб потерь и обосновать бюджет на замену.

					//- ===== Входные параметры (таблица с чередованием рядов) =====
					section#sec-input
						h2 Входные параметры
						.ss-simple-table.ss-simple-table--striped.ss-mob-bleed
							table
								thead
									tr
										th Параметр
										th Значение
								tbody
									tr
										th(scope='row') Рабочее давление пара
										td 6 бар
									tr
										th(scope='row') Количество конденсатоотводчиков
										td 48 шт.
									tr
										th(scope='row') Оценочные потери конденсата
										td 35% от расхода
									tr
										th(scope='row') Типы КО
										td Смешанные: поплавковые и термодинамические
									tr
										th(scope='row') Время эксплуатации без обслуживания
										td Более 5 лет
									tr
										th(scope='row') Расход пара предприятия
										td ~4,5 т/час

					//- ===== Предложенное решение =====
					section#sec-solution
						h2 Предложенное решение
						p Мы предложили провести инструментальную диагностику всех 48 конденсатоотводчиков с помощью ультразвукового оборудования и термографии. По итогам диагностики — составить карту состояния КО с рекомендациями по очерёдности замены.
						p Диагностика выявила 12 конденсатоотводчиков в режиме «открыт» (непрерывный пропуск пара) и 8 — в режиме «закрыт» (накопление конденсата, гидроудары). Итого 20 из 48 КО работали некорректно.
						p Приоритетом первой очереди стала замена 12 «открытых» КО — именно они давали основной объём прямых потерь пара. Для замены подобраны поплавковые конденсатоотводчики TLV серии J3S с учётом рабочего давления и расхода конденсата на каждой точке, а также арматура и смотровые стёкла для контроля работы системы.

					//- ===== Что установили =====
					section#sec-equipment
						h2 Что установили
						ul
							li
								| Конденсатоотводчик поплавковый&nbsp;
								strong TLV J3S
								|  — 12 шт.
							li
								| Фильтр-сепаратор&nbsp;
								strong TLV A3
								|  — 4 шт.
							li
								| Смотровые стёкла&nbsp;
								strong TLV SG10
								|  — 16 шт.
							li Сетчатые фильтры Y-типа — 12 шт.

					//- ===== Результат (3 метрики + текст) =====
					//- Метрики — тот же универсальный .ss-metrics.--light, что в header'е.
					section#sec-result
						h2 Результат
						.ss-metrics.ss-metrics--light
							.ss-metrics__item
								p.ss-metrics__value −15%
								p.ss-metrics__label снижение расхода пара
							.ss-metrics__item
								p.ss-metrics__value 12
								p.ss-metrics__label КО заменено в&nbsp;первой очереди
							.ss-metrics__item
								p.ss-metrics__value 6 мес.
								p.ss-metrics__label окупаемость замены
						p После замены 12 конденсатоотводчиков первой очереди расход пара снизился на 15% — что полностью совпало с прогнозом, сделанным по итогам диагностики. Предприятие получило экономию порядка 1,8 млн руб. в год при стоимости замены около 900 тыс. руб.
						p Замена второй очереди (8 «закрытых» КО) запланирована на следующий плановый останов. По расчётам, суммарный эффект после завершения полной замены составит до 22% экономии пара.

					//- ===== Цитата (без TOC-ссылки) =====
					//- Нативный <blockquote> внутри .ss-content — стили из _content.scss:
					//- серый фон, accent2 левая полоса, p курсивом, <cite> мелким серым.
					blockquote
						p «Мы ожидали найти проблемы, но не ожидали, что 12 конденсатоотводчиков работают в открытом режиме. После замены котельная сразу показала снижение нагрузки — это было видно по приборам учёта. Расчёт окупаемости, который предоставили специалисты, оказался точным.»
						cite — Главный энергетик, молочный комбинат «Вкусный»

					//- ===== Что можно повторить (текст + CTA-ряд) =====
					//- ===== CTA «Хотите такой же результат?» =====
					//- Reuse .ss-cta-card с модификаторами --promo (горизонтальная
					//- раскладка) + --dark (тёмно-синяя плашка, инверсный текст).
					//- Якорь #sec-repeat сохранён — ссылка в TOC продолжает работать.
					section#sec-repeat
						.ss-cta-card.ss-cta-card--promo.ss-cta-card--dark
							.ss-cta-card__content
								p.ss-cta-card__title Хотите такой же результат на&nbsp;вашем объекте?
								p.ss-cta-card__text Проведём диагностику вашей паровой системы, подберём решение под параметры и&nbsp;рассчитаем экономический эффект.
							.ss-cta-card__action
								+ssBtn('Запросить похожее решение', { variant: 'primary', icon: 'arrow-right', tag: 'a', href: '#' })(data-modal='request-b24')
								+ssLink('Получить консультацию инженера', { variant: 'white', size: 'md' })(href='#')

				//- -------------------- Слайдер «Похожие кейсы» (внутри main-колонки) --------------------
				//- Серый фон, карточки .ss-case-card--portfolio, навигация стрелками сверху
				//- (.ss-slider-nav--accent) + пагинация-полоски. Инициализация — общая
				//- (js-cases-slider из src/js/cases-slider.js), конфиг тот же,
				//- что в .ss-cases-catalog на cases-page.
				- var caseSliderItems = [{ kicker: 'Деревообработка · Вологда', title: 'Обвязка 24 паровых калориферов в сушильных камерах', text: 'Диагностика и замена КО в сушильных камерах. Устранение гидроударов и потерь тепла.', metrics: [{ value: '0', label: 'замерзаний за 3 зимы' }, { value: '−15%', label: 'брак' }], bg: 'gallery1', alt: 'Кейс: деревообработка', href: '#' }, { kicker: 'Химическое производство · Тула', title: 'СВК для возврата конденсата от теплообменников производства лаков', text: 'Организация замкнутого контура возврата конденсата. Снижение затрат на водоподготовку.', metrics: [{ value: '95%', label: 'возврат конденсата' }, { value: '11 мес.', label: 'окупаемость' }], bg: 'gallery2', alt: 'Кейс: химпроизводство', href: '#' }, { kicker: 'ЦБП · Архангельская область', title: 'БРОУ 40→12 бар для сушильной части бумагоделательной машины', text: 'Охлаждение пара для сушки без перегрева полотна. Автоматический контроль температуры.', metrics: [{ value: '−18%', label: 'расход пара' }, { value: '9 мес.', label: 'окупаемость' }], bg: 'gallery3', alt: 'Кейс: ЦБП', href: '#' }]

				.ss-single-case__related-slider
					.ss-section-header
						.ss-section-header__title
							h2 Похожие кейсы
						.ss-slider-nav.ss-slider-nav--accent
							+ssSwiperBtn('prev')
							+ssSwiperBtn('next')

					.swiper.swiper-pb.swiper-bars.js-cases-slider-inline
						.swiper-wrapper
							each c in caseSliderItems
								.swiper-slide
									article.ss-case-card.ss-case-card--portfolio.ss-case-card--compact
										.ss-case-card__image
											picture
												source(media='(max-width: 767px)' srcset=`${basePath}img/${c.bg}-mob.webp 1x, ${basePath}img/${c.bg}-mob@2x.webp 2x`)
												source(srcset=`${basePath}img/${c.bg}.webp 1x, ${basePath}img/${c.bg}@2x.webp 2x`)
												img(src=`${basePath}img/${c.bg}.webp` width='865' height='360' alt=c.alt loading='lazy' decoding='async')
										.ss-case-card__body
											p.ss-case-card__kicker= c.kicker
											h3.ss-case-card__title= c.title
											p.ss-case-card__text= c.text
											.ss-metrics
												each m in c.metrics
													.ss-metrics__item
														p.ss-metrics__value= m.value
														p.ss-metrics__label= m.label
										.ss-case-card__footer
											+ssLink('Читать кейс')(href=c.href)
						.swiper-pagination

			//- -------------------- Sticky sidebar --------------------
			//- Идёт в DOM после main-контента, чтобы natural reading-order
			//- левой колонки (header → content) не рвался элементом правой.
			//- Grid-areas ставит aside визуально в правую колонку.
			//-
			//- По макету fix-case1.png — только TOC «Навигация по кейсу»
			//- (reuse .ss-toc, scroll-spy из src/js/toc.js). Пункты ведут
			//- на #sec-* якоря секций в main-колонке.
			aside.ss-sticky-side.ss-doc-layout__aside

				//- Навигация по кейсу — reuse .ss-toc. Scroll-spy активной
				//- ссылки — JS src/js/toc.js по мере скролла страницы.
				nav.ss-toc.js-toc(aria-label='Навигация по кейсу')
					button.ss-toc__toggle(type='button', aria-expanded='false', aria-controls='ss-case-toc-body')
						span Навигация по кейсу
						+svgIcon('chevron-down')
					h3.ss-toc__title Навигация по кейсу
					.ss-toc__body#ss-case-toc-body(hidden)
						ul.ss-toc__list
							li.ss-toc__item: a.ss-toc__link(href='#sec-passport') Паспорт проекта
							li.ss-toc__item: a.ss-toc__link(href='#sec-situation') Ситуация
							li.ss-toc__item: a.ss-toc__link(href='#sec-input') Входные параметры
							li.ss-toc__item: a.ss-toc__link(href='#sec-solution') Предложенное решение
							li.ss-toc__item: a.ss-toc__link(href='#sec-equipment') Что установили
							li.ss-toc__item: a.ss-toc__link(href='#sec-result') Результат
							li.ss-toc__item: a.ss-toc__link(href='#sec-repeat') Что можно повторить


			//- -------------------- Мобильный контейнер для extras --------------------
			//- Пуст на десктопе. На < $lg JS (src/js/doc-layout.js) переносит сюда
			//- блоки [data-doc-extra] из sticky-side (details + solutions + help-card).
			.ss-doc-layout__mobile-extras(data-doc-mobile-extras)


//- ==================== Похожие кейсы ====================
//- Full-width секция под основной: 2 карточки .ss-case-card--portfolio
//- (kicker + title + text + метрики + «Читать кейс»). Данные локальные —
//- отдельная секция случайно совпадает по разметке с _case-related.pug
//- (используется в single-system), но здесь свой контент.
- var singleCaseRelated = [{ kicker: 'Деревообработка · Вологда', title: 'Обвязка 24 паровых калориферов в сушильных камерах', text: 'Диагностика и замена КО в сушильных камерах. Устранение гидроударов и потерь тепла.', metrics: [{ value: '0', label: 'замерзаний за 3 зимы' }, { value: '−15%', label: 'брак' }], bg: 'gallery1', alt: 'Кейс: деревообработка', href: '#' }, { kicker: 'Химическое производство · Тула', title: 'СВК для возврата конденсата от теплообменников производства лаков', text: 'Организация замкнутого контура возврата конденсата. Снижение затрат на водоподготовку.', metrics: [{ value: '95%', label: 'возврат конденсата' }, { value: '11 мес.', label: 'окупаемость' }], bg: 'gallery2', alt: 'Кейс: химпроизводство', href: '#' }]

