//- ============================================================
//- «Кейсы на оборудовании TLV» — reuse слайдера cases-catalog
//- (JS: cases-slider.js по триггеру .js-cases-slider). Карточка —
//- .ss-case-card--portfolio (та же, что на cases-page.html).
//- ============================================================

- var brandCases = [{ kicker: 'Пищевая промышленность — Нижегородская обл.', title: 'Замена 48 конденсатоотводчиков на TLV J-серию на молочном комбинате', text: 'Устаревшие биметаллические конденсатоотводчики пропускали пар и требовали замены каждые 6 месяцев. Установлены TLV J7S — поплавковые с термостатическим удалением воздуха. Плановое ТО раз в 3 года.', metrics: [{ value: '48 шт.', label: 'замена за 4 дня' }, { value: '−30%', label: 'потребление пара' }, { value: '18 мес.', label: 'окупаемость' }], bg: 'gallery1', alt: 'Молочный комбинат — замена КО', href: '#' }, { kicker: 'Фармацевтика — Санкт-Петербург', title: 'СВК с TLV Power Trap GP на фармпроизводстве класса GMP', text: 'Проектирование и монтаж станции возврата конденсата с насосными конденсатоотводчиками TLV GP. Возврат 95% конденсата при перепадах давления менее 0,1 бар. Вся документация TLV включена в паспорт установки для GMP-аудита.', metrics: [{ value: '95%', label: 'возврат конденсата' }, { value: '0', label: 'сбоев в GMP-аудите' }, { value: '12 мес.', label: 'окупаемость' }], bg: 'gallery2', alt: 'Фармпроизводство — СВК', href: '#' }]

section.ss-section.ss-single-brand__cases
	.ss-container.ss-wrapper
		.ss-section-header
			.ss-section-header__title
				h2.ss-h2 Кейсы на&nbsp;оборудовании TLV
			.ss-slider-nav.ss-slider-nav--accent
				+ssSwiperBtn('prev')
				+ssSwiperBtn('next')

		.swiper.swiper-pb.swiper-bars.js-cases-slider
			.swiper-wrapper
				each c in brandCases
					.swiper-slide
						article.ss-case-card.ss-case-card--portfolio
							.ss-case-card__image
								picture
									source(media='(max-width: 767px)' srcset=`${basePath}img/${c.bg}-mob.webp 1x, ${basePath}img/${c.bg}-mob@2x.webp 2x`)
									source(srcset=`${basePath}img/${c.bg}.webp 1x, ${basePath}img/${c.bg}@2x.webp 2x`)
									img(src=`${basePath}img/${c.bg}.webp` width='865' height='360' alt=c.alt loading='lazy' decoding='async')
							.ss-case-card__body
								p.ss-case-card__kicker= c.kicker
								h3.ss-case-card__title= c.title
								p.ss-case-card__text= c.text
								.ss-metrics
									each m in c.metrics
										.ss-metrics__item
											p.ss-metrics__value= m.value
											p.ss-metrics__label= m.label
							.ss-case-card__footer
								+ssLink('Читать кейс')(href=c.href)
			.swiper-pagination
