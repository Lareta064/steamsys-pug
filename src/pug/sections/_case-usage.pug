//- ============================================================
//- «Где устанавливается РОУ/БРОУ» — секция на странице кейса.
//- 2 карточки .ss-pills-card в ряд (grid 1fr 1fr), на <$md в стек.
//- Карточка — заголовок-метка + flex-wrap из .ss-pill (статичные span).
//- ============================================================
- var caseUsageEquipment = ['Теплообменники', 'Паровые калориферы', 'Реакторы', 'Варочные котлы', 'Сушильные камеры', 'Теплопункты', 'Паровые линии ГВС', 'Стерилизационные тоннели']
- var caseUsageIndustries = ['Пищевая промышленность', 'Целлюлозно-бумажная (ЦБП)', 'Химическая', 'Деревообработка', 'Нефтепереработка', 'Энергетика', 'Фармацевтика']

section.ss-section.ss-case-usage
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				span.ss-kicker Применение
				h2.ss-h2 Где устанавливается РОУ/БРОУ

		.ss-case-usage__grid
			.ss-pills-card
				p.ss-pills-card__header Типы оборудования и процессов
				ul.ss-pills-card__list
					each item in caseUsageEquipment
						li: span.ss-pill= item

			.ss-pills-card
				p.ss-pills-card__header Отрасли промышленности
				ul.ss-pills-card__list
					each item in caseUsageIndustries
						li: span.ss-pill= item
