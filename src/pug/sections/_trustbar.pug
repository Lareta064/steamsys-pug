- var trustbarItems = [{ value: '13+', label: 'типов готовых решений', icon: 'chart-blue-icon' }, { value: '1 день', label: 'срок расчёта системы', icon: 'calendar-blue-icon' }, { value: 'Блочная', label: 'поставка в сборе', icon: 'tool-icon' }, { value: 'В&nbsp;комплекте', label: 'вся документация', icon: 'doc-icon' }]

section.ss-trustbar.ss-wrapper
	.ss-container
		.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1
			each item in trustbarItems
				.ss-feature-card
					span.ss-feature-card__icon(aria-hidden='true')
						img(src=`${basePath}img/${item.icon}.webp` width='48' height='48' alt='' loading='lazy' decoding='async')
					.ss-feature-card__body
						p.ss-feature-card__title !{item.value}
						p.ss-feature-card__text= item.label
