//- ============================================================
//- Hero страницы «Документация» (docs.html).
//- Светлый .ss-hero-inner--light + фоновая картинка bg_docs.webp
//- (подключается в src/scss/pages/_docs.scss через image-set).
//- Текст: заголовок/лид — --primary, kicker — accent1.
//- ============================================================

section.ss-hero-inner.ss-hero-inner--light.ss-docs__hero
	.ss-hero-inner__crumbs
		.ss-container.ss-wrapper
			nav.ss-breadcrumbs(aria-label='Хлебные крошки')
				ol.ss-breadcrumbs__list
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='./') Главная
					li.ss-breadcrumbs__item.ss-breadcrumbs__item--current(aria-current='page') Документация

	.ss-hero-inner__body
		.ss-container.ss-wrapper
			.ss-hero-inner__body-inner
				span.ss-kicker Технические материалы
				h1.ss-h1 Документация
				p.ss-hero-inner__lead
					| Паспорта, сертификаты, типовые схемы, инструкции и&nbsp;таблицы подбора.
					br
					| CAD/3D/BIM&nbsp;— по&nbsp;запросу за&nbsp;1&nbsp;рабочий день.
				//- .ss-hero-inner__actions
				//- 	+ssBtn('Найти документ', { variant: 'primary' })(type='button')
				//- 	+ssBtn('Запросить CAD / 3D / BIM', { variant: 'outline-white' })(type='button' data-modal='request-b24')
