//- ============================================================
//- ss-feedback--b24 (inner-вариант для внутренних страниц).
//- Отличается от базовой только левой колонкой:
//-   - убран kicker «Обратная связь»
//-   - убран .ss-contacts-list (телефон/почта/режим работы)
//-   - лид «Заполните форму или отправьте опросный лист…» перенесён
//-     с правой колонки (был form-title) на левую под h2
//- Правая колонка — тот же b24-form-виджет без form-title.
//-
//- Использование: подключить вместо _section-feedback-b24.pug на страницах
//- База знаний / статья / отрасль / кейс и т.п.
//- ============================================================
section.ss-section.ss-section--tinted.ss-feedback.ss-feedback--b24.ss-feedback--inner
	.ss-container.ss-wrapper
		.ss-feedback__grid
			//- ==================== Левая колонка — только заголовок + лид ====================
			.ss-feedback__left
				.ss-feedback__header
					h2.ss-h2 Подберите готовую систему под&nbsp;параметры объекта
					p.ss-feedback__lead Заполните форму или отправьте опросный лист — инженер подберёт оптимальное решение и рассчитает стоимость в течение 1 рабочего дня

			//- ==================== Правая колонка — Bitrix-форма (без form-title) ====================
			.ss-feedback__form-box
				.ss-b24-form
					//- === РЕАЛЬНАЯ БИТРИКС-ФОРМА (inline/30/w7g773) ===
					script(data-b24-form='inline/30/w7g773', data-skip-moving='true').
						(function(w,d,u){var s=d.createElement('script');s.async=true;s.src=u+'?'+(Date.now()/180000|0);var h=d.getElementsByTagName('script')[0];h.parentNode.insertBefore(s,h);})(window,document,'https://portal.steamsys.ru/upload/crm/form/loader_30_w7g773.js');
