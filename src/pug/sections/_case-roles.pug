//- ============================================================
//- «Как читать страницу» — секция по ролям на странице одного кейса.
//- Визуально 1:1 с .ss-roles на главной (badge-иконка + заголовок +
//- коробка со списком и ссылкой, сквозная синяя линия сверху).
//- Контент — вопросы к РОУ/БРОУ от разных участников проекта.
//- ============================================================
- var caseRoleItems = [{ title: 'Главный инженер', list: ['Риски остановов', 'Ответственность за готовый узел', 'Опыт на похожих объектах'], link: 'Смотреть кейсы' }, { title: 'Энергетик', list: ['Стабильность давления', 'Потери пара', 'Окупаемость модернизации'], link: 'Оценить эффект' }, { title: 'Технолог', list: ['Повторяемость режима', 'Температура в процессе', 'Снижение брака'], link: 'Где применяется' }, { title: 'Закупщик', list: ['КП, сроки поставки', 'Комплект документов', 'Понятная спецификация'], link: 'Запросить КП' }, { title: 'Проектировщик', list: ['Опросный лист, P&ID, паспорт', 'CAD/3D/BIM', 'Параметры для проекта'], link: 'Получить файлы' }]

section.ss-section.ss-section--tinted.ss-roles.ss-bg-gray
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				span.ss-kicker Как читать страницу
				h2.ss-h2 РОУ/БРОУ закрывает разные задачи внутри предприятия
				p.ss-case-roles__desc
					| У разных участников проекта разные вопросы к РОУ/БРОУ. Выберите свою роль — покажем нужные данные и следующий шаг.

		.ss-role-card-group
			each item in caseRoleItems
				.ss-role-card
					.ss-role-card__badge
						+svgIcon('user')
					p.ss-role-card__title= item.title
					.ss-role-card__box
						.ss-role-card__body
							ul.ss-list
								each i in item.list
									li.ss-list__item= i
							+ssLink(item.link, { size: 'md' })
