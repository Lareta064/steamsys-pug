//- ============================================================
//- Модалка «Получить КП» — Bitrix-версия.
//- Мок повторяет реальный DOM битрикс-скрипта (см. prototype/bitrix-form/
//- script-form.html + input-file.html). Селекторы в _b24-form.scss заточены
//- под ЭТУ структуру: <form> сверху, поля в <div><div>, .b24-form-field-<name>
//- на поле (name/phone/email/text/agreement/file), кнопка файла =
//- <button.b24-form-control-file-button>, не <input type="file">.
//-
//- id="modal-request-b24" — открывается по data-modal="request-b24".
//- Триггеры в шапке / hero / футере уже указывают на этот id.
//-
//- Обёртка .ss-b24-form держит темизацию через CSS-переменные --b24-*
//- (см. _b24-form.scss). Тёмная тема — дефолт.
//-
//- При интеграции: заменить <form>-блок ниже на:
//-     script(data-b24-form='click/N/hash', data-skip-moving='true')
//- (variant 'click' открывает форму по клику — подходит для модалок).
//- ============================================================
.ss-modal#modal-request-b24(role='dialog', aria-modal='true', aria-labelledby='modal-request-b24-title', hidden)
	button.ss-modal__close(type='button', aria-label='Закрыть модальное окно', data-modal-close)
		+svgIcon('cross')

	.ss-modal__inner
		h2.ss-modal__title#modal-request-b24-title Хотите получить коммерческое предложение?
		p.ss-modal__desc Заполните форму или отправьте опросный лист — инженер подберёт оптимальное решение и рассчитает стоимость в течение 1 рабочего дня

		//- ===== BITRIX-МОК (структура из реального скрипта) =====
		.ss-b24-form
			form
				div
					//- NAME
					.b24-form-field.b24-form-field-name.b24-form-control-string
						div
							.b24-form-control-container
								.b24-form-control-label
									span.b24-form-control-label-name Ваше имя
									span.b24-form-control-required *
								input.b24-form-control.b24-form-control-string(type='text', name='NAME', placeholder=' ')

					//- PHONE
					.b24-form-field.b24-form-field-phone.b24-form-control-string
						div
							.b24-form-control-container
								.b24-form-control-label
									span.b24-form-control-label-name Телефон
									span.b24-form-control-required *
								input.b24-form-control.b24-form-control-string(type='tel', name='PHONE', placeholder=' ')

					//- EMAIL
					.b24-form-field.b24-form-field-email.b24-form-control-string
						div
							.b24-form-control-container
								.b24-form-control-label
									span.b24-form-control-label-name Email для отправки КП
								input.b24-form-control.b24-form-control-string(type='email', name='EMAIL', placeholder=' ')

					//- FILE — empty state: только <button>, без видимого input type="file".
					//- Битрикс инжектит скрытый input через JS. Filled state (карточка файла
					//- .b24-form-control-file-item) появляется после клика — тоже генерит Битрикс.
					.b24-form-field.b24-form-field-file.b24-form-control-file
						div
							.b24-form-control-container
								.b24-form-control-label
									span.b24-form-control-label-name Прикрепить ТЗ, спецификацию или опросный лист
							.b24-form-control-file-item-empty
								button.b24-form-control.b24-form-control-file-button(type='button') Прикрепить ТЗ, спецификацию или опросный лист

					//- TEXTAREA (comments)
					.b24-form-field.b24-form-field-comments.b24-form-control-text
						div
							.b24-form-control-container
								.b24-form-control-label
									span.b24-form-control-label-name Комментарий к файлу или краткое описание задачи
								textarea.b24-form-control.b24-form-control-textarea(name='COMMENTS', placeholder=' ')

					//- AGREEMENT
					.b24-form-field.b24-form-field-agreement
						label
							input(type='checkbox', name='AGREEMENT')
							span.b24-form-control-desc
								| Нажимая кнопку, вы соглашаетесь с&nbsp;
								a.b24-form-field-agreement-link(href='#') политикой конфиденциальности

				//- SUBMIT
				.b24-form-btn-block
					.b24-form-btn-container
						button.b24-form-btn.b24-form-btn-shadow(type='submit') Получить КП
