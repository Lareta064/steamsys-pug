- var catalogProducts = [{ img: 'tool1', brand: 'TLV', title: 'JX45', alt: 'Конденсатоотводчик TLV JX45', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '25 бар' }, { k: 'Температура', v: 'до 220 °C' }] }, { img: 'tool2', brand: 'Spirax Sarco', title: 'FT14', alt: 'Конденсатоотводчик Spirax Sarco FT14', specs: [{ k: 'DN', v: '15–25' }, { k: 'PN', v: '40 бар' }, { k: 'Температура', v: 'до 400 °C' }] }, { img: 'tool3', brand: 'Gestra', title: 'UNA 45', alt: 'Конденсатоотводчик Gestra UNA 45', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '16 бар' }, { k: 'Температура', v: 'до 250 °C' }] }, { img: 'tool1', brand: 'ADCA', title: 'IB12', alt: 'Конденсатоотводчик ADCA IB12', specs: [{ k: 'DN', v: '15–25' }, { k: 'PN', v: '40 бар' }, { k: 'Температура', v: 'до 300 °C' }] }]

section.ss-section.ss-section--tinted.ss-catalog
	.ss-container.ss-wrapper
		.ss-catalog__layout
			aside.ss-catalog__sidebar
				include _filters.pug
			.ss-catalog__main
				//- Top toolbar: [Фильтры (trigger)] ... [Сортировка]
				.ss-catalog__toolbar
					button.ss-filters-trigger.js-filters-trigger(type='button' aria-controls='filters-drawer' aria-expanded='false')
						+svgIcon('sliders')
						span Фильтры
					.ss-catalog__toolbar-right
						.ss-select-labeled
							span.ss-select-labeled__label Сортировка:
							.ss-select(data-select)
								button.ss-select__control(type='button', aria-haspopup='listbox', aria-expanded='false')
									span.ss-select__value По DN
									span.ss-select__chevron
										+svgIcon('chevron-down')
								ul.ss-select__list(role='listbox', hidden)
									li.ss-select__option(role='option', aria-selected='true',  tabindex='-1', data-value='dn')   По DN
									li.ss-select__option(role='option', aria-selected='false', tabindex='-1', data-value='pn')   По PN
									li.ss-select__option(role='option', aria-selected='false', tabindex='-1', data-value='temp') По температуре

				//- Чипы применённых фильтров — кликабельна только иконка «×»
				//- (кнопка снимает соответствующий фильтр). Сам чип — обычный span.
				//- Исключение: «Сбросить всё» — самостоятельная button (модификатор --reset).
				.ss-catalog__toolbar-meta(aria-label='Применённые фильтры')
					span.ss-filter-chip
						span.ss-filter-chip__label Тип:
						span.ss-filter-chip__value Конденсатоотводчик
						button.ss-filter-chip__icon(type='button' aria-label='Убрать фильтр: тип, конденсатоотводчик')
							+svgIcon('cross')
					span.ss-filter-chip
						span.ss-filter-chip__label Подбор:
						span.ss-filter-chip__value По параметрам
						button.ss-filter-chip__icon(type='button' aria-label='Убрать фильтр: подбор по параметрам')
							+svgIcon('cross')
					button.ss-filter-chip.ss-filter-chip--reset(type='button') Сбросить всё

				//- Products grid — 4 в ряд на десктопе. Карточка .ss-product-card:
				//- media + brand + title + specs. Equal-height в ряду обеспечивает height:100%.
				.ss-grid.ss-grid--row-4.ss-grid--xl-row-3.ss-grid--lg-row-2.ss-grid--md-row-1
					each item in catalogProducts
						article.ss-product-card
							a.ss-product-card__media(href='#' aria-label=`Открыть карточку товара ${item.title}`)
								picture
									source(srcset=`${basePath}img/${item.img}.webp 1x, ${basePath}img/${item.img}@2x.webp 2x`)
									img(src=`${basePath}img/${item.img}.webp` width='235' height='160' alt=item.alt loading='lazy' decoding='async')
							p.ss-product-card__brand= item.brand
							h3.ss-product-card__title
								a(href='#')= item.title
							dl.ss-product-card__specs
								each s in item.specs
									.ss-product-card__specs-row
										dt= s.k
										dd= s.v

				//- Bottom toolbar: белая карточка с summary слева и .ss-pagination справа.
				//- Квадратные стрелки prev/next, radius 8 кнопкам, nowrap-ряд.
				.ss-pagination-toolbar
					p.ss-pagination-toolbar__summary
						| Показано&nbsp;
						strong 24
						|  из&nbsp;
						strong 126
						span.ss-pagination-toolbar__summary-models  моделей
					nav.ss-pagination(aria-label='Страницы каталога')
						ol.ss-pagination__list
							li.ss-pagination__item
								span.ss-pagination__link.ss-pagination__link--nav.ss-pagination__arrow--prev(aria-disabled='true' aria-label='Предыдущая страница')
									+svgIcon('arrow-right')
							li.ss-pagination__item
								a.ss-pagination__link(href='#' aria-current='page') 1
							li.ss-pagination__item
								a.ss-pagination__link(href='#') 2
							li.ss-pagination__item
								a.ss-pagination__link(href='#') 3
							li.ss-pagination__item.ss-pagination-toolbar__item--compact-hidden
								a.ss-pagination__link(href='#') 4
							li.ss-pagination__item.ss-pagination-toolbar__item--compact-hidden
								a.ss-pagination__link(href='#') 5
							li.ss-pagination__item
								span.ss-pagination__dots(aria-hidden='true') …
							li.ss-pagination__item
								a.ss-pagination__link(href='#') 11
							li.ss-pagination__item
								a.ss-pagination__link.ss-pagination__link--nav(href='#' aria-label='Следующая страница')
									+svgIcon('arrow-right')
