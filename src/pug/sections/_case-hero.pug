//- ============================================================
//- Hero-секция страницы одного кейса (case-page).
//- Шаблон .ss-hero-inner--dark (как portfolio-page): полоса крошек +
//- тёмный body с bg-image + 4 равных факта внизу. Внутри body
//- дополнительно — ряд pill-тегов под actions.
//- BG image + градиентная завеса — в src/scss/pages/_case-page.scss
//- (пока используем solution-hero.webp от portfolio-page).
//- ============================================================
section.ss-hero-inner.ss-hero-inner--dark.case-page__hero
	.ss-hero-inner__crumbs
		.ss-container.ss-wrapper
			nav.ss-breadcrumbs(aria-label='Хлебные крошки')
				ol.ss-breadcrumbs__list
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='/') Главная
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='#solutions') Решения
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='#branches') Отрасли
					li.ss-breadcrumbs__item.ss-breadcrumbs__item--current(aria-current='page') РОУ и БРОУ

	.ss-hero-inner__body
		.ss-container.ss-wrapper
			.ss-hero-inner__body-inner
				span.ss-kicker.ss-txt-accent3 Готовые инженерные решения
				h1.ss-h1 Редукционно-охладительные установки РОУ и&nbsp;БРОУ
				p.ss-hero-inner__lead
					| Снижаем давление и температуру пара до рабочих параметров. Стабилизируем подачу в технологический процесс. Защищаем оборудование от гидроударов и аварийных режимов.
				.ss-hero-inner__actions
					+ssBtn('Получить расчёт РОУ', { variant: 'accent5', icon: 'arrow-right', xsFull: true })(data-modal='request-b24')
					+ssBtn('Отправить параметры', { variant: 'outline-light', icon: 'arrow-right', xsFull: true })
					+ssBtn('Заполнить опросный лист онлайн', { variant: 'outline-light', xsFull: true })
				ul.case-page__hero-tags
					li: span.ss-pill Производство под проект
					li: span.ss-pill Документация в комплекте
					li: span.ss-pill Партнёр TLV (Япония)

			.ss-hero-inner__facts
				.ss-hero-inner__facts-inner
					.ss-hero-inner__fact
						.ss-hero-inner__fact-text
							p.ss-hero-inner__fact-value DN 15–500
							p.ss-hero-inner__fact-label Диапазон диаметров
					.ss-hero-inner__fact
						.ss-hero-inner__fact-text
							p.ss-hero-inner__fact-value до 100 бар
							p.ss-hero-inner__fact-label Давление на входе
					.ss-hero-inner__fact
						.ss-hero-inner__fact-text
							p.ss-hero-inner__fact-value до 550°C
							p.ss-hero-inner__fact-label Температура пара
					.ss-hero-inner__fact
						.ss-hero-inner__fact-text
							p.ss-hero-inner__fact-value 15+
							p.ss-hero-inner__fact-label лет на рынке
