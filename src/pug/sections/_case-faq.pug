//- ============================================================
//- «Часто спрашивают о РОУ/БРОУ» — FAQ-секция на странице кейса.
//- Переиспользуем компонент .ss-accordion. Фон — белый (без --tinted).
//- ============================================================
- var caseFaqItems = [{ q: 'В чём разница между РОУ и БРОУ?', a: 'РОУ снижает только давление пара, температура при этом повышается (закон термодинамики). БРОУ снижает и давление, и температуру — за счёт впрыска охлаждающей воды. Если на выходе нужен насыщенный или охлаждённый пар — только БРОУ.' }, { q: 'Какие параметры нужны для расчёта?', a: 'Давление на входе, требуемое давление на выходе, температура, расход пара (т/ч), режим работы (непрерывный/прерывистый), требования к точности регулирования. Для БРОУ — также параметры охлаждающей воды. Чем больше данных — тем точнее подбор.' }, { q: 'Можно ли встроить новую РОУ в действующую систему?', a: 'Да. Мы анализируем существующий трубопровод, стыковочные фланцы, место установки и режим работы. Блочная поставка позволяет встроить установку с минимальной остановкой производства.' }, { q: 'Какие документы предоставляются с поставкой?', a: 'Паспорт изделия, принципиальная схема, сертификаты качества на оборудование, инструкция по монтажу и эксплуатации, опросный лист с ответами. По запросу — CAD/3D/BIM для проектировщика.' }, { q: 'Как проходит процесс подбора?', a: 'Отправляете параметры → инженер анализирует в течение 1 рабочего дня → получаете предварительный расчёт и схему → согласовываем КП → производство → поставка. Сопровождение на всех этапах.' }]

section.ss-section.ss-case-faq
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				span.ss-kicker Вопросы и ответы
				h2.ss-h2 Часто спрашивают о РОУ/БРОУ
		.ss-accordion(data-accordion)
			each item, i in caseFaqItems
				+ssAccordionItem(item.q, 'case-faq-' + (i + 1))
					p= item.a
