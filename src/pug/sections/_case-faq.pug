//- ============================================================
//- FAQ-секция на странице кейса. Единый компонент .ss-faq
//- (разметка — в _faq.scss, аккордеон — ss-accordion).
//- Отличается от других FAQ-секций только контентом.
//- ============================================================
- var caseFaqItems = [{ q: 'Чем РОУ отличается от БРОУ?', a: 'РОУ снижает только давление пара, температура при этом повышается (закон термодинамики). БРОУ снижает и давление, и температуру — за счёт впрыска охлаждающей воды. Если на выходе нужен насыщенный или охлаждённый пар — только БРОУ.' }, { q: 'Какие исходные данные нужны для подбора РОУ/БРОУ?', a: 'Для расчёта необходимы давление, температура и расход пара на входе и выходе, режим работы установки, требования к точности регулирования, а для БРОУ также параметры питательной воды.' }, { q: 'Как определить необходимую производительность?', a: 'Производительность определяется из теплового и материального баланса потребителей. Если данных нет — инженер подберёт по аналогичному объекту или проведёт замеры.' }, { q: 'Где устанавливается РОУ/БРОУ?', a: 'РОУ/БРОУ размещается на выходе из котельной перед распределительным коллектором, перед технологическим потребителем или на входе в сетевые теплообменники.' }, { q: 'Что входит в комплект поставки?', a: 'Паспорт изделия, принципиальная схема, сертификаты качества на оборудование, инструкция по монтажу и эксплуатации, опросный лист с ответами. По запросу — CAD/3D/BIM для проектировщика.' }, { q: 'Сколько занимает проектирование и изготовление?', a: 'Расчёт и КП — 1 рабочий день для типовых решений, 3–5 дней для нестандартных. Изготовление блочной РОУ/БРОУ — от 4 до 10 недель в зависимости от DN и комплектации.' }, { q: 'Можно ли изготовить РОУ/БРОУ под существующий трубопровод?', a: 'Да. Мы анализируем существующий трубопровод, стыковочные фланцы, место установки и режим работы. Блочная поставка позволяет встроить установку с минимальной остановкой производства.' }]

section.ss-section.ss-section--tinted.ss-faq.ss-bg-gray
	.ss-container.ss-wrapper
		.ss-faq__grid
			.ss-faq__intro
				span.ss-kicker Вопросы и ответы
				h2.ss-h2 Часто спрашивают о&nbsp;РОУ/БРОУ
				p.ss-faq__desc
					| Ответили на самые частые вопросы по подбору, проектированию и эксплуатации РОУ/БРОУ.

				.ss-faq__contact
					span.ss-faq__contact-icon(aria-hidden='true')
						+svgIcon('message')
					.ss-faq__contact-body
						h3.ss-faq__contact-title Не нашли ответа на&nbsp;свой вопрос?
						p.ss-faq__contact-text
							| Напишите вашу задачу — наши инженеры изучат ваш запрос и ответят по вашему случаю.
						.ss-faq__contact-action
							+ssBtn('Задать вопрос', { variant: 'primary', icon: 'arrow-right' })(data-modal='request-b24')

			.ss-faq__list
				.ss-accordion(data-accordion)
					each item, i in caseFaqItems
						+ssAccordionItem(item.q, 'case-faq-' + (i + 1))
							p= item.a
