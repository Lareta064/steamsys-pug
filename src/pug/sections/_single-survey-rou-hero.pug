section.ss-hero-inner.ss-single-survey__hero.ss-hero-inner--dark
	.ss-hero-inner__crumbs
		.ss-container.ss-wrapper
			nav.ss-breadcrumbs(aria-label='Хлебные крошки')
				ol.ss-breadcrumbs__list
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='./') Главная
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='./docs.html') Документация
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='./surveys.html') Опросные листы
					li.ss-breadcrumbs__item.ss-breadcrumbs__item--current(aria-current='page') РОУ и БРОУ

	.ss-hero-inner__body
		.ss-container.ss-wrapper
			.ss-hero-inner__body-inner
				span.ss-kicker.ss-txt-secondary Опросный лист
				h1.ss-h2 РОУ и&nbsp;БРОУ&nbsp;— Редукционно-охладительные установки
				p.ss-hero-inner__lead Заполните параметры&nbsp;— инженер подберёт систему РОУ/БРОУ и&nbsp;пришлёт КП в&nbsp;течение 1&nbsp;рабочего дня.
				.ss-hero-inner__actions
					+ssBtn('О системе РОУ/БРОУ', { variant: 'primary', tag: 'a', href: '#' })
