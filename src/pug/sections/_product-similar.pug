- var productSimilarItems = [{ img: 'tool1', brand: 'TLV', title: 'JX6S', alt: 'Поплавковый конденсатоотводчик TLV JX6S', specs: [{ k: 'DN', v: '15–80' }, { k: 'PN', v: '40 бар' }, { k: 'Температура', v: 'до 220 °C' }], href: '#' }, { img: 'tool2', brand: 'Spirax Sarco', title: 'JX7S', alt: 'Термодинамический конденсатоотводчик Spirax JX7S', specs: [{ k: 'DN', v: '25–100' }, { k: 'PN', v: '16 бар' }, { k: 'Температура', v: 'до 300 °C' }], href: '#' }, { img: 'tool3', brand: 'Gestra', title: 'A3N', alt: 'Термостатический конденсатоотводчик Gestra A3N', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '40 бар' }, { k: 'Температура', v: 'до 250 °C' }], href: '#' }, { img: 'tool1', brand: 'ADCA', title: 'L21S', alt: 'Биметаллический конденсатоотводчик ADCA L21S', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '16 бар' }, { k: 'Температура', v: 'до 300 °C' }], href: '#' }]

section.ss-section.ss-products-slider
	.ss-container.ss-wrapper
		.ss-section-header
			.ss-section-header__title
				h2.ss-h2 Похожие товары
			.ss-slider-nav.ss-slider-nav--accent
				+ssSwiperBtn('prev')
				+ssSwiperBtn('next')

		.swiper.swiper-pb.swiper-bars.js-similar-slider
			.swiper-wrapper
				each item in productSimilarItems
					.swiper-slide
						article.ss-product-card
							a.ss-product-card__media(href=item.href aria-label=`Открыть карточку товара ${item.title}`)
								picture
									source(srcset=`./img/${item.img}.webp 1x, ./img/${item.img}@2x.webp 2x`)
									img(src=`./img/${item.img}.webp` width='235' height='160' alt=item.alt loading='lazy' decoding='async')
							p.ss-product-card__brand= item.brand
							h3.ss-product-card__title
								a(href=item.href)= item.title
							dl.ss-product-card__specs
								each s in item.specs
									.ss-product-card__specs-row
										dt= s.k
										dd= s.v
			.swiper-pagination
