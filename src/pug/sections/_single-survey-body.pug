//- ============================================================
//- Опросник Конденсатоотводчика — основной контент.
//- Структура: прогресс (full-width) + grid 2 колонки (форма + sticky aside).
//-
//- Все поля (name / required / value для radio/checkbox / hidden) соответствуют
//- продакшн-шаблону Bitrix: опросники-php/index1.php (admin dump).
//- Программист переносит разметку в Bitrix «как есть» — атрибуты уже правильные.
//- ============================================================

- var surveySections = [{ num: 1, title: 'Контактная информация', badge: 'required' }, { num: 2, title: 'Конденсатоотводчик №1', badge: 'required' }, { num: 3, title: 'Конденсатоотводчик №2', badge: 'optional' }, { num: 4, title: 'Конденсатоотводчик №3', badge: 'optional' }, { num: 5, title: 'Примечание', badge: 'optional' }]

- var surveyGetItems = ['Подбор модели конденсатоотводчика', 'Технический расчёт по параметрам', 'Коммерческое предложение', 'Срок поставки', 'CAD/3D файлы по запросу']

//- Параметры одного блока «Конденсатоотводчик №N» (повторяется 3 раза).
//- requiredFirst: поле обязательно только для №1 (так в проде).
- var koFields = [{ name: 'krashod', label: 'Расход конденсата', unit: 'кг/ч', placeholder: 'кг/ч', requiredFirst: true }, { name: 'davpered', label: 'Давление перед конденсатоотводчиком', unit: 'бар изб.', placeholder: 'бар изб.' }, { name: 'davza', label: 'Давление за конденсатоотводчиком (противодавление в конденсатной линии)', unit: 'бар изб.', placeholder: 'бар изб.' }, { name: 'mint', label: 'Минимальная температура окружающей среды', unit: '°C', placeholder: 'градусов C' }, { name: 'part', label: 'Температура пара (указать только если пар перегретый)', unit: '°C', placeholder: 'градусов C', requiredFirst: true }]

//- Чекбоксы доп. оборудования — по 3 отдельных на каждую деталь (filter1/filter2/filter3 и т.д.)
- var koAccessories = [{ name: 'filter', label: 'Фильтр' }, { name: 'obrklap', label: 'Обратный клапан' }, { name: 'ventil', label: 'Отсечные вентили / байпасный вентиль' }, { name: 'prokran', label: 'Продувочный кран' }, { name: 'prervak', label: 'Прерыватель вакуума' }]

//- Миксин блока «Конденсатоотводчик №N» — одинаковая разметка для №1-3,
//- суффикс N подставляется в name/id. Параметры + радио типа присоединения +
//- чекбоксы доп. оборудования — всё в одном блоке.
mixin koSection(num, isRequired)
	-
		var suffix = num - 1;
		var badge = isRequired ? 'Обязательно' : 'Необязательно';
		var modCls = isRequired ? 'ss-form-section--required' : 'ss-form-section--optional';
	section(class='ss-form-section ' + modCls id='section-' + num)
		.ss-form-section__head
			span.ss-form-section__num= num
			h3.ss-form-section__title Конденсатоотводчик №#{suffix}
			span.ss-form-section__badge= badge
		p.ss-form-section__sub #{isRequired ? 'Параметры первого конденсатоотводчика' : 'Если нужно подобрать ещё один — заполните этот блок'}
		.ss-form-section__body

			//- Поля-параметры (text input c unit-suffix)
			.ss-form-section__row
				each f in koFields
					.ss-form-field.ss-form-field--unit
						label.ss-form-field__label(for=`${f.name}${suffix}`)
							| #{f.label}
							if isRequired && f.requiredFirst
								span.ss-form-field__req *
						.ss-form-field__row
							input.ss-form-field__input(type='text' id=`${f.name}${suffix}` name=`${f.name}${suffix}` placeholder=f.placeholder required=(isRequired && f.requiredFirst))
							span.ss-form-field__unit= f.unit
				//- Место установки — всегда text, required для КО №1
				.ss-form-field.ss-form-field--full
					label.ss-form-field__label(for=`mplace${suffix}`)
						| Место установки (дренаж паропровода, теплообменник, пароспутник, другое)
						if isRequired
							span.ss-form-field__req *
					input.ss-form-field__input(type='text' id=`mplace${suffix}` name=`mplace${suffix}` required=isRequired placeholder='укажите место установки')

			//- Тип присоединения — radio value='1'/'2'/'3' (прод)
			.ss-form-field.ss-form-field--full
				span.ss-form-field__label Тип присоединения
				.ss-form-field__radios
					label.ss-radio-opt
						input(type='radio' name=`tipp${suffix}` value='1')
						span Резьбовой
					label.ss-radio-opt
						input(type='radio' name=`tipp${suffix}` value='2')
						span Фланцевый
					label.ss-radio-opt
						input(type='radio' name=`tipp${suffix}` value='3')
						span Приварной

			//- Доп. оборудование — чекбоксы value='1' (прод)
			.ss-form-field.ss-form-field--full
				span.ss-form-field__label Дополнительное оборудование
				.ss-checkbox-grid
					each a in koAccessories
						label.ss-check-opt
							input(type='checkbox' name=`${a.name}${suffix}` value='1')
							span= a.label

section.ss-section.ss-single-survey__body
	.ss-container.ss-wrapper

		//- Прогресс заполнения (на всю ширину над колонками)
		.ss-single-survey__progress
			.ss-single-survey__progress-row
				span.ss-single-survey__progress-label Прогресс заполнения
				span.ss-single-survey__progress-value(data-progress-value) 0%
			.ss-single-survey__progress-bar(aria-hidden='true')
				.ss-single-survey__progress-fill(data-progress-fill style='width:0%')
			p.ss-single-survey__progress-hint
				| Обязательных полей: #[strong 7]. Остальное&nbsp;— уточним при общении.

		.ss-single-survey__wrap

			//- ─── MAIN: форма ───────────────────────────────────────
			//- action='' — форма сабмитится на свою страницу (в Bitrix PHP установит URL).
			form.ss-single-survey__main#ss-single-survey-form(method='POST' action='')

				//- Hidden-поля для Bitrix nimdaCreateLead():
				//-   PAGE  — URL страницы (PHP: SERVER_NAME + REQUEST_URI)
				//-   save  — флаг обработки ('Y')
				//-   TITLE — название опросника (приходит в лид)
				//-   rand  — анти-дубль (PHP: rand())
				input(type='hidden' name='save' value='Y')
				input(type='hidden' name='TITLE' value='Опросный лист Конденсатоотводчик')
				input(type='hidden' name='PAGE' value='')
				input(type='hidden' name='rand' value='')

				//- Section 1 — Контактная информация
				section.ss-form-section.ss-form-section--required#section-1
					.ss-form-section__head
						span.ss-form-section__num 1
						h3.ss-form-section__title Контактная информация
						span.ss-form-section__badge Обязательно
					p.ss-form-section__sub Кто вы и для какого предприятия подбираем конденсатоотводчик
					.ss-form-section__body
						.ss-form-section__row
							.ss-form-field
								label.ss-form-field__label(for='COMPANY_TITLE')
									| Организация
									span.ss-form-field__req *
								input.ss-form-field__input(type='text' id='COMPANY_TITLE' name='COMPANY_TITLE' required placeholder='название компании')
							.ss-form-field
								label.ss-form-field__label(for='NAME')
									| Контактное лицо
									span.ss-form-field__req *
								input.ss-form-field__input(type='text' id='NAME' name='NAME' required placeholder='контактное лицо')
							.ss-form-field
								label.ss-form-field__label(for='PHONE')
									| Телефон / факс
									span.ss-form-field__req *
								input.ss-form-field__input(type='tel' id='PHONE' name='PHONE' required placeholder='+7 (000) 000-00-00')
							.ss-form-field
								label.ss-form-field__label(for='EMAIL')
									| E-mail
									span.ss-form-field__req *
								input.ss-form-field__input(type='text' id='EMAIL' name='EMAIL' required placeholder='Ваш e-mail')

				//- Section 2-4 — три блока «Конденсатоотводчик №1/2/3»
				+koSection(2, true)
				+koSection(3, false)
				+koSection(4, false)

				//- Section 5 — Примечание
				section.ss-form-section.ss-form-section--optional#section-5
					.ss-form-section__head
						span.ss-form-section__num 5
						h3.ss-form-section__title Примечание
						span.ss-form-section__badge Необязательно
					p.ss-form-section__sub Опишите задачу подробнее
					.ss-form-section__body
						.ss-form-field.ss-form-field--full
							label.ss-form-field__label(for='COMMENTS') Комментарий
							textarea.ss-form-field__input.ss-form-field__input--textarea(id='COMMENTS' name='COMMENTS' rows='4' placeholder='Опишите задачу: особенности объекта, пожелания по подбору')

				//- Submit-блок (тёмный)
				//- legal_top — чекбокс согласия (required в проде). Текст и ссылка 1-в-1 с index1.php.
				.ss-form-submit
					h3.ss-form-submit__title Готово&nbsp;— отправить инженеру?
					p.ss-form-submit__text Расчёт и&nbsp;КП пришлём в&nbsp;течение 1&nbsp;рабочего дня. Если параметров мало&nbsp;— уточним по&nbsp;телефону.
					label.ss-check-opt.ss-check-opt--light.ss-form-submit__consent
						input(type='checkbox' name='legal_top' value='Y' required)
						span
							| Нажимая «Отправить», принимаю согласие на&nbsp;обработку&nbsp;
							a(href='/include/licenses_detail.php' target='_blank') персональных данных
					+ssBtn('Отправить', { variant: 'white', full: true, tag: 'button' })(type='submit')
					p.ss-form-submit__note Без обязательств. Данные конфиденциальны.

			//- ─── ASIDE: sticky-сайдбар ──────────────────────────
			aside.ss-sticky-side.ss-single-survey__aside

				//- 1) Nav «Разделы опросного листа»
				//- .js-toc + .ss-toc__link — подхватывается src/js/toc.js:
				//- smooth-scroll по клику (CSS scroll-behavior: smooth в _base)
				//- + scroll-spy подсвечивает активный пункт через [aria-current="location"].
				nav.ss-form-nav.js-toc(aria-label='Разделы опросного листа')
					h3.ss-form-nav__title Разделы опросного листа
					ol.ss-form-nav__list
						each sec in surveySections
							li.ss-form-nav__item
								a.ss-form-nav__link.ss-toc__link(href='#section-' + sec.num)
									span.ss-form-nav__num= sec.num
									span.ss-form-nav__label= sec.title

				//- 2) Инфо-карточка «Что получите в ответ»
				.ss-info-card.ss-single-survey__results
					h3.ss-info-card__title Что получите в&nbsp;ответ
					ul.ss-single-survey__results-list
						each t in surveyGetItems
							li.ss-single-survey__results-item
								span.ss-single-survey__results-check(aria-hidden='true') ✓
								span= t
					p.ss-single-survey__results-term
						span.ss-single-survey__results-term-icon(aria-hidden='true') ⏱
						|  Срок:&nbsp;
						strong 1 рабочий день
						|  с&nbsp;момента получения параметров
