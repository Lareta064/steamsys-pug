//- ============================================================
//- Опросник Конденсатоотводчика — основной контент.
//- Структура: прогресс (full-width) + grid 2 колонки (форма + sticky aside).
//-
//- Поля формы (name / id / required / value) соответствуют продакшн-форме:
//- https://www.steamsys.ru/forms/index1.php — для бесшовной интеграции
//- с текущим Bitrix-обработчиком. UX-слой (Section 0 «Кто заполняет»,
//- progress-bar, sidebar «Что получите / Минимум для расчёта») — redesign-only.
//- ============================================================

- var surveySections = [{ num: 1, title: 'Контактная информация', badge: 'required' }, { num: 2, title: 'Конденсатоотводчик №1', badge: 'required' }, { num: 3, title: 'Конденсатоотводчик №2', badge: 'optional' }, { num: 4, title: 'Конденсатоотводчик №3', badge: 'optional' }, { num: 5, title: 'Доп. оборудование', badge: 'optional' }, { num: 6, title: 'Дополнительно для проектировщика', badge: 'optional' }]

- var surveyMustFields = ['Название компании', 'Контактное лицо', 'Телефон', 'E-mail', 'Параметры хотя бы одного конденсатоотводчика']

- var surveyGetItems = ['Подбор модели конденсатоотводчика', 'Технический расчёт по параметрам', 'Коммерческое предложение', 'Срок поставки', 'CAD/3D файлы по запросу']

//- Параметры одного блока «Конденсатоотводчик №N» (повторяется 3 раза)
- var koFields = [{ name: 'condensate_flow', label: 'Расход конденсата', unit: 'кг/ч', placeholder: 'например, 500' }, { name: 'inlet_pressure', label: 'Давление перед КО', unit: 'бар изб', placeholder: 'например, 8' }, { name: 'outlet_pressure', label: 'Давление за КО', unit: 'бар изб', placeholder: 'например, 1' }, { name: 'min_ambient_temp', label: 'Мин. температура окр. среды', unit: '°C', placeholder: 'например, -30' }, { name: 'steam_temp', label: 'Температура пара', unit: '°C', placeholder: 'например, 175' }]

//- Чекбоксы доп. оборудования (name='accessories[]', value — согласно продакшн-форме)
- var accessories = [{ value: 'filter', label: 'Фильтр' }, { value: 'check_valve', label: 'Обратный клапан' }, { value: 'isolation_bypass', label: 'Отсечные вентили / байпасный вентиль' }, { value: 'drain_cock', label: 'Продувочный кран' }, { value: 'vacuum_breaker', label: 'Прерыватель вакуума' }]

//- Миксин блока «Конденсатоотводчик №N» — одинаковая разметка для №1-3
mixin koSection(num, isRequired)
	-
		var badge = isRequired ? 'Обязательно' : 'Необязательно';
		var modCls = isRequired ? 'ss-form-section--required' : 'ss-form-section--optional';
	section(class='ss-form-section ' + modCls id='section-' + num)
		.ss-form-section__head
			span.ss-form-section__num= num
			h3.ss-form-section__title Конденсатоотводчик №#{num - 1}
			span.ss-form-section__badge= badge
		p.ss-form-section__sub #{isRequired ? 'Параметры первого конденсатоотводчика' : 'Если нужно подобрать ещё один — заполните этот блок'}
		.ss-form-section__body
			.ss-form-section__row
				each f in koFields
					.ss-form-field.ss-form-field--unit
						label.ss-form-field__label(for=`${f.name}_${num - 1}`)
							| #{f.label}
						.ss-form-field__row
							input.ss-form-field__input(type='number' step='any' id=`${f.name}_${num - 1}` name=`${f.name}_${num - 1}` placeholder=f.placeholder)
							span.ss-form-field__unit= f.unit
				.ss-form-field.ss-form-field--full
					label.ss-form-field__label(for=`installation_location_${num - 1}`) Место установки
					input.ss-form-field__input(type='text' id=`installation_location_${num - 1}` name=`installation_location_${num - 1}` placeholder='дренаж, теплообменник, пароспутник, другое')
			.ss-form-field.ss-form-field--full
				span.ss-form-field__label Тип присоединения
				.ss-form-field__radios
					label.ss-radio-opt
						input(type='radio' name=`connection_type_${num - 1}` value='threaded')
						span Резьбовой
					label.ss-radio-opt
						input(type='radio' name=`connection_type_${num - 1}` value='flanged')
						span Фланцевый
					label.ss-radio-opt
						input(type='radio' name=`connection_type_${num - 1}` value='welded')
						span Приварной

section.ss-section.ss-single-survey__body
	.ss-container.ss-wrapper

		//- Прогресс заполнения (на всю ширину над колонками)
		.ss-single-survey__progress
			.ss-single-survey__progress-row
				span.ss-single-survey__progress-label Прогресс заполнения
				span.ss-single-survey__progress-value(data-progress-value) 0%
			.ss-single-survey__progress-bar(aria-hidden='true')
				.ss-single-survey__progress-fill(data-progress-fill style='width:0%')
			p.ss-single-survey__progress-hint
				| Обязательных полей: #[strong 4]. Остальное&nbsp;— уточним при общении.

		.ss-single-survey__wrap

			//- ─── MAIN: форма ───────────────────────────────────────
			form.ss-single-survey__main#ss-single-survey-form(method='POST' action='/forms/index1.php' enctype='multipart/form-data')

				//- Section 1 — Контактная информация
				section.ss-form-section.ss-form-section--required#section-1
					.ss-form-section__head
						span.ss-form-section__num 1
						h3.ss-form-section__title Контактная информация
						span.ss-form-section__badge Обязательно
					p.ss-form-section__sub Кто вы и для какого предприятия подбираем конденсатоотводчик
					.ss-form-section__body
						.ss-form-section__row
							.ss-form-field
								label.ss-form-field__label(for='company_name')
									| Название компании
									span.ss-form-field__req *
								input.ss-form-field__input(type='text' id='company_name' name='company_name' required placeholder='ООО «Название предприятия»')
							.ss-form-field
								label.ss-form-field__label(for='contact_person')
									| Контактное лицо
									span.ss-form-field__req *
								input.ss-form-field__input(type='text' id='contact_person' name='contact_person' required placeholder='Александр Иванов')
							.ss-form-field
								label.ss-form-field__label(for='phone_fax')
									| Телефон
									span.ss-form-field__req *
								input.ss-form-field__input(type='tel' id='phone_fax' name='phone_fax' required placeholder='+7 (___) ___-__-__')
							.ss-form-field
								label.ss-form-field__label(for='email')
									| E-mail
									span.ss-form-field__req *
								input.ss-form-field__input(type='email' id='email' name='email' required placeholder='engineer@company.ru')

				//- Section 2-4 — три блока «Конденсатоотводчик №1/2/3»
				+koSection(2, true)
				+koSection(3, false)
				+koSection(4, false)

				//- Section 5 — Дополнительное оборудование (чекбоксы)
				section.ss-form-section.ss-form-section--optional#section-5
					.ss-form-section__head
						span.ss-form-section__num 5
						h3.ss-form-section__title Дополнительное оборудование
						span.ss-form-section__badge Необязательно
					p.ss-form-section__sub Какие сопутствующие компоненты включить в&nbsp;подбор
					.ss-form-section__body
						.ss-checkbox-grid
							each a in accessories
								label.ss-check-opt
									input(type='checkbox' name='accessories[]' value=a.value)
									span= a.label

				//- Section 6 — Дополнительно для проектировщика
				section.ss-form-section.ss-form-section--optional#section-6
					.ss-form-section__head
						span.ss-form-section__num 6
						h3.ss-form-section__title Дополнительно для&nbsp;проектировщика
						span.ss-form-section__badge Необязательно
					p.ss-form-section__sub Опишите задачу подробнее или прикрепите схему / спецификацию / чертёж
					.ss-form-section__body
						.ss-form-field.ss-form-field--full
							label.ss-form-field__label(for='notes') Комментарий или описание задачи
							textarea.ss-form-field__input.ss-form-field__input--textarea(id='notes' name='notes' rows='4' placeholder='Опишите задачу в свободной форме: симптомы проблемы, ограничения по месту установки, особенности объекта. Чем больше контекста — тем точнее подбор.')
						.ss-form-field.ss-form-field--full
							span.ss-form-field__label Прикрепить файлы (схема, чертёж, фото, спецификация)
							input.ss-form-field__file(type='file' id='attachments' name='attachments[]' multiple accept='.pdf,.dwg,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png')
							p.ss-form-field__hint До 5 файлов. Форматы: PDF, DWG, Word, Excel, JPG, PNG. Максимум 10 МБ.

				//- Submit-блок (тёмный)
				.ss-form-submit
					h3.ss-form-submit__title Готово&nbsp;— отправить инженеру?
					p.ss-form-submit__text Расчёт и&nbsp;КП пришлём в&nbsp;течение 1&nbsp;рабочего дня. Если параметров мало&nbsp;— уточним по&nbsp;телефону.
					label.ss-check-opt.ss-check-opt--light.ss-form-submit__consent
						input(type='checkbox' name='privacy_consent' required)
						span
							| Согласен с&nbsp;
							a(href='#' target='_blank') политикой конфиденциальности
					+ssBtn('Отправить параметры инженеру →', { variant: 'white', full: true, tag: 'button' })(type='submit')
					p.ss-form-submit__note Без обязательств. Данные конфиденциальны.

			//- ─── ASIDE: sticky-сайдбар ──────────────────────────
			aside.ss-sticky-side.ss-single-survey__aside

				//- 1) Nav «Разделы опросного листа»
				//- .js-toc + .ss-toc__link — подхватывается src/js/toc.js:
				//- smooth-scroll по клику (CSS scroll-behavior: smooth в _base)
				//- + scroll-spy подсвечивает активный пункт через [aria-current="location"].
				nav.ss-form-nav.js-toc(aria-label='Разделы опросного листа')
					h3.ss-form-nav__title Разделы опросного листа
					ol.ss-form-nav__list
						each sec in surveySections
							li.ss-form-nav__item
								a.ss-form-nav__link.ss-toc__link(href='#section-' + sec.num)
									span.ss-form-nav__num= sec.num
									span.ss-form-nav__label= sec.title

				//- 2) Инфо-карточка «Что получите в ответ»
				.ss-info-card.ss-single-survey__results
					h3.ss-info-card__title Что получите в&nbsp;ответ
					ul.ss-single-survey__results-list
						each t in surveyGetItems
							li.ss-single-survey__results-item
								span.ss-single-survey__results-check(aria-hidden='true') ✓
								span= t
					p.ss-single-survey__results-term
						span.ss-single-survey__results-term-icon(aria-hidden='true') ⏱
						|  Срок:&nbsp;
						strong 1 рабочий день
						|  с&nbsp;момента получения параметров

				//- 3) Callout «Минимум для расчёта»
				.ss-callout.ss-callout--warning.ss-callout--stacked
					.ss-callout__body
						p.ss-callout__kicker.ss-single-survey__min-title
							span.ss-single-survey__min-icon 💡
							|  Минимум для расчёта
						p.ss-single-survey__min-lead Достаточно заполнить только 5&nbsp;обязательных полей:
						ul.ss-single-survey__min-list
							each f in surveyMustFields
								li
									span.ss-single-survey__min-star(aria-hidden='true') *
									span= f

				//- 4) Тёмная CTA «Параметры заполнены?»
				.ss-cta-card.ss-cta-card--dark.ss-single-survey__submit
					p.ss-cta-card__title Параметры заполнены?
					p.ss-cta-card__text Отправьте&nbsp;— инженер ответит в&nbsp;течение 1&nbsp;рабочего дня с&nbsp;расчётом и&nbsp;КП.
					.ss-single-survey__submit-actions
						+ssBtn('↓ Скачать заполненный PDF', { variant: 'outline-white', full: true, tag: 'button' })(type='button')
