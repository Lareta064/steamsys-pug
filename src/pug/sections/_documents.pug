//- ============================================================
//- «Документы по конденсатоотводчикам» — секция каталога.
//- Стилистика 1:1 с .ss-designer (блок «Для проектировщиков»):
//- слева intro + CTA, справа grid плашек с emoji-иконкой + title + ссылкой.
//- ============================================================
- var docItems = [{ icon: '📋', title: 'Паспорта', cta: 'Запросить', href: '#doc-passports' }, { icon: '📄', title: 'Сертификаты', cta: 'Запросить', href: '#doc-certs' }, { icon: '📊', title: 'Таблицы подбора', cta: 'Скачать', href: '#doc-tables' }, { icon: '📝', title: 'Опросный лист', cta: 'Заполнить онлайн', href: '#doc-form' }]

section.ss-section.ss-section--tinted.ss-designer.ss-documents
	.ss-container.ss-wrapper
		.ss-designer__grid
			.ss-designer__intro
				span.ss-kicker Документация
				h2.ss-h3 Документы по&nbsp;конденсато&shy;отвод&shy;чикам
				
				
			ul.ss-designer__list
				each item in docItems
					li
						a.ss-designer__item(href=item.href)
							span.ss-designer__icon(aria-hidden='true')
								i= item.icon
							.ss-designer__body
								p.ss-designer__title= item.title
								span.ss-link.ss-link--sm
									span= item.cta
									+svgIcon('arrow-right')
