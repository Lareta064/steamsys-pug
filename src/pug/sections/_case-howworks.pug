//- ============================================================
//- «Как работает редукционно-охладительная установка» — секция
//- принципа работы на странице кейса. Структурно повторяет
//- .ss-how-to-pick с portfolio-page (2 колонки: слева картинка-схема,
//- справа список шагов), но справа — не плашки .ss-comp-item,
//- а наш типовой список с иконкой (.ss-list--icon) с цифрами в маркере.
//- Картинка — та же process.webp, что в «Как подобрать систему».
//- ============================================================
- var caseHowWorksSteps = [{ title: 'Пар высокого давления поступает из магистрали', text: 'Давление на входе — от 3 до 100 бар. Фильтры и сепаратор очищают поток перед редуцированием.' }, { title: 'Редукционный клапан снижает давление', text: 'Регулируется автоматически. Давление на выходе поддерживается в заданном диапазоне ±0,1 бар.' }, { title: 'Охладитель снижает температуру (БРОУ)', text: 'Впрыск питательной воды, температура снижается до рабочей. Датчик температуры управляет клапаном впрыска.' }, { title: 'КИПиА контролирует параметры онлайн', text: 'Давление, температура и расход отслеживаются непрерывно. При отклонении — автоматическая корректировка.' }, { title: 'Пар с рабочими параметрами подаётся в процесс', text: 'На выходе — стабильные давление и температура точно под требования технологии.' }]

section.ss-section.ss-case-howworks
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				span.ss-kicker Принцип работы
				h2.ss-h2 Как работает редукционно-охладительная установка

		.ss-case-howworks__grid
			//- Левая колонка — та же картинка-схема, что в «Как подобрать систему».
			.ss-case-howworks__media
				picture
					source(srcset=`${basePath}img/process.webp 1x, ${basePath}img/process@2x.webp 2x`)
					img(src=`${basePath}img/process.webp` width='720' height='560' alt='Принципиальная схема РОУ' loading='lazy' decoding='async')

			//- Правая колонка — универсальный .ss-list--step
			//- (поверх .ss-list--icon). Размеры title/text задаём
			//- типографика-утилитами на самих <p>.
			ul.ss-list.ss-list--icon.ss-list--step
				each step, i in caseHowWorksSteps
					li.ss-list__item
						span.ss-list__marker= i + 1
						.ss-list__step
							p.ss-semi-18= step.title
							p.ss-reg-14.ss-txt-secondary= step.text
