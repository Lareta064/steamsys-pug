//- ============================================================
//- «Какие проблемы решает РОУ/БРОУ» — секция на странице кейса.
//- Визуально карточки = .ss-feature-card из _feature.pug на главной.
//- Иконки — растровые img (src/img/prob1.svg … prob8.svg).
//- Grid 4×2 на десктопе → 2×4 на планшете → 1×8 на моб.
//- ============================================================
- var caseProblemItems = [{ icon: 'prob1', title: 'Нестабильное давление пара', text: 'Давление в сети скачет, оборудование работает в аварийных режимах, производительность падает' }, { icon: 'prob2', title: 'Перегретый пар в процессе', text: 'Температура выше допустимой для технологии — продукт бракуется, оборудование выходит из строя' }, { icon: 'prob3', title: 'Риск повреждения оборудования', text: 'Гидроудары и перепады давления разрушают трубопроводы, теплообменники, запорную арматуру' }, { icon: 'prob4', title: 'Аварийные остановы', text: 'Плановое производство срывается из-за внеплановых остановок, ремонты дорогостоящие' }, { icon: 'prob5', title: 'Ручное регулирование', text: 'Оператор вручную поддерживает параметры — нет стабильности, есть человеческий фактор' }, { icon: 'prob6', title: 'Нет безопасной подачи пара', text: 'Высокое давление из магистрали нельзя напрямую подать в процесс — нужна ступень редуцирования' }, { icon: 'prob7', title: 'Сложный подбор компонентов', text: 'Подобранные по отдельности клапан, охладитель и автоматика не работают как система' }, { icon: 'prob8', title: 'Высокие эксплуатационные затраты', text: 'Неэффективная работа системы ведёт к перерасходу пара и росту затрат на энергоносители' }]

section.ss-section.ss-case-problems
	.ss-container.ss-wrapper
		.ss-section-header.ss-section-header--column
			.ss-section-header__title
				span.ss-kicker Почему обращаются
				h2.ss-h2 Какие проблемы решает РОУ/БРОУ
				p.ss-case-problems__desc
					| Если вы сталкиваетесь хотя бы с одним из этих сценариев — установка РОУ или БРОУ закрывает задачу.

		.ss-grid.ss-grid--row-4.ss-grid--xxl-row-3.ss-grid--lg-row-2.ss-grid--md-row-1
			each item in caseProblemItems
				.ss-feature-card
					span.ss-feature-card__icon
						img(src=`${basePath}img/${item.icon}.svg` width='40' height='40' alt='' loading='lazy' decoding='async')
					.ss-feature-card__body
						p.ss-feature-card__title= item.title
						p.ss-feature-card__text= item.text
