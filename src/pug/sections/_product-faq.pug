- var productFaqItems = [{ q: 'Есть ли аналог JX4S у других производителей?', a: 'Ближайший аналог — Spirax Sarco FT14 и Yoshitake GP-200. Подбираем по DN, PN и расходу. Укажите параметры — инженер сформирует таблицу аналогов с ценами и сроками поставки.' }, { q: 'Какой срок поставки?', a: 'Стандартные размеры (DN15–50, PN16) — со склада в Санкт-Петербурге, срок 2–5 рабочих дней. Нестандартные исполнения и крупные партии — под заказ, срок уточняется при запросе КП.' }, { q: 'Где применяется JX4S в обвязках?', a: 'Поплавковый КО JX4S применяется в обвязке паровых калориферов и теплообменников, на дренажных линиях РОУ/БРОУ и в узлах СВК при давлении пара до 16 бар. Подходит для непрерывного режима отвода конденсата.' }, { q: 'Когда нужен инженерный расчёт, а не просто выбор из каталога?', a: 'Расчёт обязателен при: противодавлении в конденсатопроводе, переменной нагрузке, работе в составе СВК, давлении выше 6 бар. В этих случаях стандартный подбор по каталогу может привести к подтоплению или неполному дренажу.' }, { q: 'Какие документы нужны для аккредитации нового поставщика?', a: 'Предоставляем: карточку компании, ИНН/КПП, устав, сертификаты дилера TLV, паспорта на оборудование. Комплект документов — по запросу на электронную почту.' }]

section.ss-section.ss-section--tinted.ss-faq.ss-bg-gray
	.ss-container.ss-wrapper
		.ss-faq__grid
			.ss-faq__intro
				span.ss-kicker Поддержка
				h2.ss-h2 Часто спрашивают по&nbsp;этой позиции

				.ss-faq__contact
					span.ss-faq__contact-icon(aria-hidden='true')
						+svgIcon('message')
					.ss-faq__contact-body
						h3.ss-faq__contact-title Не нашли ответа на&nbsp;свой вопрос?
						p.ss-faq__contact-text
							| Напишите вашу задачу — наши инженеры изучат ваш запрос и ответят по вашему случаю.
						.ss-faq__contact-action
							+ssBtn('Задать вопрос', { variant: 'primary', icon: 'arrow-right' })(data-modal='request-b24')

			.ss-faq__list
				.ss-accordion(data-accordion)
					each item, i in productFaqItems
						+ssAccordionItem(item.q, 'product-faq-' + (i + 1))
							p= item.a
