section.ss-section.ss-reviews__list
	.ss-container.ss-wrapper
		h2.ss-h2.ss-reviews__list-title Отзывы по&nbsp;проектам

		ul.ss-reviews__grid
			each r in reviewsData
				li
					article.ss-reviews__card
						.ss-reviews__card-stars
							img(src=`${basePath}img/stars-rating.webp` width='80' height='20' alt='Рейтинг 5 из 5' loading='lazy' decoding='async')
						blockquote.ss-reviews__card-quote
							p= '«' + r.quote + '»'
						.ss-reviews__card-author
							p.ss-reviews__card-name= r.name
							p.ss-reviews__card-role= r.role.join(' · ')
						.ss-reviews__card-foot
							//- Ряд 1: тег слева, метрики справа
							.ss-reviews__card-foot-row
								span.ss-tag.ss-tag--mini= r.tag
								.ss-reviews__card-metrics
									each m in r.metrics
										.ss-reviews__card-metric
											p.ss-reviews__card-metric-value= m.value
											p.ss-reviews__card-metric-label= m.label
							//- Ряд 2: ссылки слева + «Читать отзыв» (текст, открывает модалку) справа
							.ss-reviews__card-foot-row
								.ss-reviews__card-links
									if r.links && r.links.length
										each l in r.links
											a.ss-reviews__card-link(href=l.href)= l.label
								button.ss-link.ss-link--md(type='button' data-modal='review-screenshot') Читать отзыв

		.ss-reviews__more
			+ssBtn('Показать ещё', { variant: 'primary' })(type='button')
