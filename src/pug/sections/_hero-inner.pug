//- ============================================================
//- Hero-секция страницы «База знаний» (внутренняя).
//- Тёмный вариант (--dark): фон --primary1 + белый текст.
//- Внутри: kicker + h1 + описание + строка поиска.
//- ============================================================
section.ss-hero-inner.ss-hero-inner--dark
	.ss-hero-inner__crumbs
		.ss-container.ss-wrapper
			nav.ss-breadcrumbs(aria-label='Хлебные крошки')
				ol.ss-breadcrumbs__list
					li.ss-breadcrumbs__item
						a.ss-breadcrumbs__link(href='/') Главная
					li.ss-breadcrumbs__item.ss-breadcrumbs__item--current(aria-current='page') База знаний

	.ss-hero-inner__body
		.ss-container.ss-wrapper
			.ss-hero-inner__body-inner
				span.ss-kicker.ss-txt-secondary1 Техническая библиотека
				h1.ss-h1 База знаний
				p.ss-hero-inner__lead Инженерные статьи о паровых системах: конденсатоотводчики, обвязка, РОУ/БРОУ, возврат конденсата. Написано практикующими инженерами — без воды, с расчётами и схемами.

				.ss-search-wrapper.ss-input-bg-white
					input.ss-search__input(type='search', placeholder='Найти статью — например, «гидроудары» или «поплавковый конденсатоотводчик»')
					+ssBtn('Найти', { variant: 'accent5' })
