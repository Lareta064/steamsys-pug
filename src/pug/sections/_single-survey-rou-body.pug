//- ============================================================
//- Опросник РОУ/БРОУ — основной контент.
//- Структура: прогресс (full-width) + grid 2 колонки (форма + sticky aside).
//-
//- Поля формы (name / id / required / value) соответствуют продакшн-форме:
//- https://www.steamsys.ru/forms/index8.php — для бесшовной интеграции
//- с текущим Bitrix-обработчиком. UX-слой (progress-bar, sidebar
//- «Что получите / Минимум для расчёта») — redesign-only.
//- ============================================================

- var surveySections = [{ num: 1, title: 'Контактная информация', badge: 'required' }, { num: 2, title: 'Параметры пара', badge: 'optional' }, { num: 3, title: 'КИПиА', badge: 'optional' }, { num: 4, title: 'Доп. оборудование', badge: 'optional' }, { num: 5, title: 'Дополнительно для проектировщика', badge: 'optional' }]

- var surveyGetItems = ['Состав системы РОУ/БРОУ', 'Принципиальная схема P&ID', 'Коммерческое предложение', 'Срок поставки', 'CAD/3D файлы по запросу']

//- Параметры пара (Section 2) — name/id из продакшн-формы index8.php
- var steamParams = [{ name: 'flow_rate', label: 'Расход пара (min / nom / max)', unit: 'т/ч', placeholder: '0.5 / 2 / 4', type: 'text' }, { name: 'pressure', label: 'Давление пара (min / max)', unit: 'бар', placeholder: '8 / 14', type: 'text' }, { name: 'inlet_temp', label: 'Температура пара на входе', unit: '°C', placeholder: 'например, 220', type: 'number' }, { name: 'outlet_pressure', label: 'Давление пара на выходе', unit: 'бар', placeholder: '3 / 6', type: 'text' }, { name: 'outlet_temp', label: 'Температура пара на выходе', unit: '°C', placeholder: 'например, 150', type: 'number' }, { name: 'cool_pressure', label: 'Давление охлаждающей воды', unit: 'бар', placeholder: 'например, 6', type: 'text' }, { name: 'cool_temp', label: 'Температура охлаждающей воды', unit: '°C', placeholder: 'например, 20', type: 'number' }, { name: 'backpressure', label: 'Противодавление в конденсатной линии', unit: 'бар', placeholder: 'например, 0.5', type: 'text' }]

//- КИПиА — чекбоксы Section 3 (name/id — продакшн-форма)
- var instrumentsSet = [{ name: 'cabinet', label: 'Шкаф автоматики' }, { name: 'temp_sensor', label: 'Датчик температуры' }, { name: 'thermometers', label: 'Термометры' }, { name: 'gauges', label: 'Манометры' }, { name: 'pressure_sensor', label: 'Датчик давления' }]

//- Доп. оборудование — чекбоксы Section 4 (name/id — продакшн-форма)
- var additionalSet = [{ name: 'shutoff', label: 'Запорная арматура' }, { name: 'insulation', label: 'Теплоизоляция' }, { name: 'flanges', label: 'Фланцы и крепёж' }, { name: 'trap', label: 'Конденсатоотводчик' }, { name: 'relief', label: 'Предохранительный клапан' }]

section.ss-section.ss-single-survey__body
	.ss-container.ss-wrapper

		//- Прогресс заполнения (на всю ширину над колонками)
		.ss-single-survey__progress
			.ss-single-survey__progress-row
				span.ss-single-survey__progress-label Прогресс заполнения
				span.ss-single-survey__progress-value(data-progress-value) 0%
			.ss-single-survey__progress-bar(aria-hidden='true')
				.ss-single-survey__progress-fill(data-progress-fill style='width:0%')
			p.ss-single-survey__progress-hint
				| Обязательных полей: #[strong 4]. Остальное&nbsp;— уточним при общении.

		.ss-single-survey__wrap

			//- ─── MAIN: форма ───────────────────────────────────────
			form.ss-single-survey__main#ss-single-survey-form(method='POST' action='/forms/index8.php' enctype='multipart/form-data')

				//- Section 1 — Контактная информация
				section.ss-form-section.ss-form-section--required#section-1
					.ss-form-section__head
						span.ss-form-section__num 1
						h3.ss-form-section__title Контактная информация
						span.ss-form-section__badge Обязательно
					p.ss-form-section__sub Кто вы и для какого предприятия подбираем РОУ/БРОУ
					.ss-form-section__body
						.ss-form-section__row
							.ss-form-field
								label.ss-form-field__label(for='company')
									| Название компании
									span.ss-form-field__req *
								input.ss-form-field__input(type='text' id='company' name='company' required placeholder='ООО «Название предприятия»')
							.ss-form-field
								label.ss-form-field__label(for='contact')
									| Контактное лицо
									span.ss-form-field__req *
								input.ss-form-field__input(type='text' id='contact' name='contact' required placeholder='Александр Иванов')
							.ss-form-field
								label.ss-form-field__label(for='phone')
									| Телефон
									span.ss-form-field__req *
								input.ss-form-field__input(type='tel' id='phone' name='phone' required placeholder='+7 (___) ___-__-__')
							.ss-form-field
								label.ss-form-field__label(for='email')
									| E-mail
									span.ss-form-field__req *
								input.ss-form-field__input(type='email' id='email' name='email' required placeholder='engineer@company.ru')

				//- Section 2 — Параметры пара
				section.ss-form-section.ss-form-section--optional#section-2
					.ss-form-section__head
						span.ss-form-section__num 2
						h3.ss-form-section__title Параметры пара
						span.ss-form-section__badge Желательно
					p.ss-form-section__sub Основные режимы работы установки — на входе, на выходе и охлаждающая среда
					.ss-form-section__body
						.ss-form-section__row
							each f in steamParams
								.ss-form-field.ss-form-field--unit
									label.ss-form-field__label(for=f.name)= f.label
									.ss-form-field__row
										input.ss-form-field__input(type=f.type step='any' id=f.name name=f.name placeholder=f.placeholder)
										span.ss-form-field__unit= f.unit
						.ss-form-field.ss-form-field--full
							span.ss-form-field__label Расположение установки
							.ss-form-field__radios
								label.ss-radio-opt
									input(type='radio' name='location' value='indoor')
									span В помещении
								label.ss-radio-opt
									input(type='radio' name='location' value='outdoor')
									span На открытом воздухе
						.ss-form-field.ss-form-field--full
							span.ss-form-field__label Привод регулирующего клапана
							.ss-form-field__radios
								label.ss-radio-opt
									input(type='radio' name='drive' value='electric')
									span Электрический
								label.ss-radio-opt
									input(type='radio' name='drive' value='pneumatic')
									span Пневматический

				//- Section 3 — КИПиА
				section.ss-form-section.ss-form-section--optional#section-3
					.ss-form-section__head
						span.ss-form-section__num 3
						h3.ss-form-section__title КИПиА
						span.ss-form-section__badge Необязательно
					p.ss-form-section__sub Контрольно-измерительные приборы и автоматика&nbsp;— что включить в&nbsp;состав поставки
					.ss-form-section__body
						.ss-checkbox-grid
							each item in instrumentsSet
								label.ss-check-opt
									input(type='checkbox' name=item.name value='1')
									span= item.label

				//- Section 4 — Доп. оборудование
				section.ss-form-section.ss-form-section--optional#section-4
					.ss-form-section__head
						span.ss-form-section__num 4
						h3.ss-form-section__title Дополнительное оборудование
						span.ss-form-section__badge Необязательно
					p.ss-form-section__sub Сопутствующие компоненты для системы РОУ/БРОУ
					.ss-form-section__body
						.ss-checkbox-grid
							each item in additionalSet
								label.ss-check-opt
									input(type='checkbox' name=item.name value='1')
									span= item.label

				//- Section 5 — Дополнительно для проектировщика
				section.ss-form-section.ss-form-section--optional#section-5
					.ss-form-section__head
						span.ss-form-section__num 5
						h3.ss-form-section__title Дополнительно для&nbsp;проектировщика
						span.ss-form-section__badge Необязательно
					p.ss-form-section__sub Опишите задачу подробнее или прикрепите схему / спецификацию / чертёж
					.ss-form-section__body
						.ss-form-field.ss-form-field--full
							label.ss-form-field__label(for='notes') Комментарий или описание задачи
							textarea.ss-form-field__input.ss-form-field__input--textarea(id='notes' name='notes' rows='4' placeholder='Опишите задачу в свободной форме: симптомы проблемы, ограничения по месту установки, особенности объекта. Чем больше контекста — тем точнее подбор.')
						.ss-form-field.ss-form-field--full
							span.ss-form-field__label Прикрепить файлы (схема, чертёж, фото, спецификация)
							input.ss-form-field__file(type='file' id='attachments' name='attachments[]' multiple accept='.pdf,.dwg,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png')
							p.ss-form-field__hint До 5 файлов. Форматы: PDF, DWG, Word, Excel, JPG, PNG. Максимум 10 МБ.

				//- Submit-блок (тёмный)
				.ss-form-submit
					h3.ss-form-submit__title Готово&nbsp;— отправить инженеру?
					p.ss-form-submit__text Расчёт и&nbsp;КП пришлём в&nbsp;течение 1&nbsp;рабочего дня. Если параметров мало&nbsp;— уточним по&nbsp;телефону.
					label.ss-check-opt.ss-check-opt--light.ss-form-submit__consent
						input(type='checkbox' name='privacy' required)
						span
							| Согласен с&nbsp;
							a(href='#' target='_blank') политикой конфиденциальности
					+ssBtn('Отправить параметры инженеру →', { variant: 'white', full: true, tag: 'button' })(type='submit')
					p.ss-form-submit__note Без обязательств. Данные конфиденциальны.

			//- ─── ASIDE: sticky-сайдбар ──────────────────────────
			aside.ss-sticky-side.ss-single-survey__aside

				//- 1) Nav «Разделы опросного листа»
				nav.ss-form-nav.js-toc(aria-label='Разделы опросного листа')
					h3.ss-form-nav__title Разделы опросного листа
					ol.ss-form-nav__list
						each sec in surveySections
							li.ss-form-nav__item
								a.ss-form-nav__link.ss-toc__link(href='#section-' + sec.num)
									span.ss-form-nav__num= sec.num
									span.ss-form-nav__label= sec.title

				//- 2) Инфо-карточка «Что получите в ответ»
				.ss-info-card.ss-single-survey__results
					h3.ss-info-card__title Что получите в&nbsp;ответ
					ul.ss-single-survey__results-list
						each t in surveyGetItems
							li.ss-single-survey__results-item
								span.ss-single-survey__results-check(aria-hidden='true') ✓
								span= t
					p.ss-single-survey__results-term
						span.ss-single-survey__results-term-icon(aria-hidden='true') ⏱
						|  Срок:&nbsp;
						strong 1 рабочий день
						|  с&nbsp;момента получения параметров

