//- ============================================================
//- CTA «Нужна точность?» на хабе калькуляторов.
//- Reuse .ss-cta-card с модификатором --promo:
//-   · горизонтальная раскладка (content | action)
//-   · серый фон (--secondary3), крупные паддинги
//-   · kicker, title, text слева + button + footnote справа
//- Фон секции — белый (не --tinted), т.к. серый живёт на самой карточке.
//- ============================================================
section.ss-section.ss-calc-cta
	.ss-container.ss-container--narrow.ss-wrapper
		.ss-cta-card.ss-cta-card--promo
			.ss-cta-card__content
				p.ss-cta-card__kicker Нужна точность?
				p.ss-cta-card__title Точный расчёт от инженера — за 24 часа, бесплатно
				p.ss-cta-card__text Калькуляторы дают оценку ±30%. Для обоснования перед руководством нужен точный расчёт с учётом реальных параметров вашей системы. Инженер подготовит расчёт в формате A4 — с цифрами, рекомендациями и сроком окупаемости.
			.ss-cta-card__action
				+ssBtn('Получить точный расчёт', { variant: 'dark', tag: 'a', href: '#calc-form' })
				p.ss-cta-card__footnote Ответ в течение 24 часов
