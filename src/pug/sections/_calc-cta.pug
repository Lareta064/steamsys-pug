//- ============================================================
//- CTA «Нужна точность?» на хабе калькуляторов. Reuse .ss-cta-card
//- (универсальная плашка с заголовком + описанием + кнопкой).
//- ============================================================
section.ss-section.ss-section--tinted.ss-calc-cta
	.ss-container.ss-wrapper
		.ss-cta-card
			p.ss-cta-card__title Нужна точность выше ±30%?
			p.ss-cta-card__text Пришлите спецификацию или опросный лист — инженер подготовит точный расчёт за 1 рабочий день с подбором конкретного оборудования под параметры объекта.
			+ssBtn('Заказать точный расчёт', { variant: 'primary', icon: 'arrow-right', tag: 'a', href: '#calc-form' })
