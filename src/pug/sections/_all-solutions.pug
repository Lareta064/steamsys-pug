- var allSolutions = [{ kicker: 'Снижение давления', title: 'РОУ — Редукционные установки', text: 'Снижают давление пара от высокого к среднему или низкому. Поставляются в блочном исполнении с запорной арматурой, регулятором давления и контрольно-измерительными приборами.', bg: 'gallery1', href: '#solution-roy' }, { kicker: 'Редуцирование + охлаждение', title: 'БРОУ — Редукционно-охладительные установки', text: 'Одновременно снижают давление и температуру пара. Применяются на выходе котлов и в схемах распределения пара по цехам с разными параметрами.', bg: 'gallery2', href: '#solution-brou' }, { kicker: 'Охлаждение пара', title: 'ОУ — Охладительные установки', text: 'Охлаждают перегретый пар до состояния насыщенного или до заданной температуры. Используются в технологических линиях с требованиями к качеству пара.', bg: 'gallery3', href: '#solution-oy' }, { kicker: 'Компактное редуцирование', title: 'РУ — Редукционные установки (компактный формат)', text: 'Компактные редукционные узлы для небольших расходов пара. Готовые блоки для установки в стеснённых условиях или на вспомогательных объектах.', bg: 'gallery1', href: '#solution-ru' }, { kicker: 'Горячее водоснабжение', title: 'ИТП ГВС — Индивидуальные тепловые пункты', text: 'Тепловые пункты пар/вода для систем горячего водоснабжения и отопления. Включают теплообменник, насосный блок, автоматику управления и учёт тепла.', bg: 'gallery2', href: '#solution-itp' }, { kicker: 'Возврат конденсата', title: 'СВК — Станции возврата конденсата', text: 'Собирают и перекачивают конденсат обратно в котельную. Снижают затраты на водоподготовку и расход топлива — экономия до 10% на теплогенерации.', bg: 'gallery3', href: '#solution-svk' }, { kicker: 'Стабильный нагрев воздуха', title: 'Обвязка калориферов', text: 'Узлы подключения паровых калориферов с регулирующим клапаном, конденсатоотводчиком, запорной арматурой. Исключают гидроудары и обеспечивают стабильную теплоотдачу.', bg: 'gallery1', href: '#solution-calorifer' }, { kicker: 'Передача тепла', title: 'Обвязка теплообменников', text: 'Узлы обвязки пластинчатых и кожухотрубных теплообменников с регулируемой температурой нагрева. Подходят для нагрева воды, масел и технологических жидкостей.', bg: 'gallery2', href: '#solution-heat-exchanger' }, { kicker: 'Теплоснабжение', title: 'Теплопункты парораспределительные', text: 'Комплексные пункты распределения тепла и пара по нескольким контурам. Для крупных промышленных предприятий и объектов ЖКХ.', bg: 'gallery3', href: '#solution-tp' }, { kicker: 'Сушильные процессы', title: 'Обвязка сушилок', text: 'Специализированная обвязка для вращающихся и конвейерных сушилок с учётом особенностей движения конденсата во вращающихся элементах и температурного режима.', bg: 'gallery1', href: '#solution-dryer' }, { kicker: 'Химические процессы', title: 'Обвязка реакторов и варочных котлов', text: 'Узлы подачи пара в паровые рубашки и змеевики. Точное регулирование температуры в реакционной зоне.', bg: 'gallery2', href: '#solution-reactor' }, { kicker: 'Осушка трубопроводов', title: 'Паросушители', text: 'Системы парового отбора влаги для поддержания температуры трубопроводов и предотвращения замерзания технологической воды.', bg: 'gallery3', href: '#solution-dryer-pipe' }, { kicker: 'Специализированные системы', title: 'Вакуумные системы нагрева TLV', text: 'Системы нагрева на основе вакуумного пара TLV — японская технология для высокоточного контроля температуры. Идеальны для фармацевтики и тонкой химии.', bg: 'gallery1', href: '#solution-tlv' }, { kicker: 'Котельные системы', title: 'Модульные паровые котельные', text: 'Блочные котельные заводской готовности на базе паровых котлов. Быстрый монтаж, полная комплектация, возможность расширения мощности.', bg: 'gallery2', href: '#solution-modular' }]

section.ss-section.ss-section--tinted.ss-all-solutions
	.ss-container.ss-wrapper
		.ss-section-header
			.ss-section-header__title
				h2.ss-h2 Все готовые решения
				p.ss-all-solutions__desc 13 типов систем — от стандартных узлов до комплексных установок под конкретные параметры
			.ss-slider-nav.ss-slider-nav--accent
				+ssSwiperBtn('prev')
				+ssSwiperBtn('next')

		.swiper.swiper-pb.swiper-bars.js-all-solutions-slider
			.swiper-wrapper
				each s in allSolutions
					.swiper-slide
						article.ss-all-solution-card
							picture.ss-all-solution-card__bg
								source(media='(max-width: 767px)' srcset=`${basePath}img/${s.bg}-mob.webp 1x, ${basePath}img/${s.bg}-mob@2x.webp 2x`)
								source(media='(min-width: 768px)' srcset=`${basePath}img/${s.bg}.webp 1x, ${basePath}img/${s.bg}@2x.webp 2x`)
								img(src=`${basePath}img/${s.bg}.webp` width='567' height='480' alt='', loading='lazy', decoding='async')
							a.ss-all-solution-card__overlay(href=s.href aria-label=s.title)
							.ss-all-solution-card__content
								span.ss-tag.ss-tag--mini-primary= s.kicker
								.ss-all-solution-card__body
									h3.ss-all-solution-card__title= s.title
									p.ss-all-solution-card__text= s.text
									span.ss-all-solution-card__cta
										| Получить расчёт
										+svgIcon('arrow-right')
			.swiper-pagination
