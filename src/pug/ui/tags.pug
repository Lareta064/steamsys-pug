extends ../layouts/layout-ui.pug

block content
	.container-dashboard.ss-wrapper
		h2.db-h2 Tags

		.container-dashboard__content

			p.tags-catalog__intro.ss-reg-14.ss-txt-secondary
				| Статичная плашка-метка. Стили — в
				code src/scss/base/_tag.scss
				| . Используем
				code span.ss-tag
				| .

			//- ===== Одиночные варианты =====
			h3.tags-catalog__section-title Варианты

			h4.tags-catalog__subtitle .ss-tag (default — белая, accent1)
			.tags-catalog__demo.ss-bg-primary
				span.ss-tag TLV
				|
				span.ss-tag DN15-DN100

			h4.tags-catalog__subtitle .ss-tag.ss-tag--primary (accent1 + white)
			.tags-catalog__demo.ss-bg-gray
				span.ss-tag.ss-tag--primary # news tag
				|
				span.ss-tag.ss-tag--primary TLV

			h4.tags-catalog__subtitle .ss-tag.ss-tag--light (accent3 + white)
			.tags-catalog__demo.ss-bg-gray
				span.ss-tag.ss-tag--light # news tag
				|
				span.ss-tag.ss-tag--light TLV

			h4.tags-catalog__subtitle .ss-tag.ss-tag--dark (primary + white)
			.tags-catalog__demo.ss-bg-gray
				span.ss-tag.ss-tag--dark TLV
				|
				span.ss-tag.ss-tag--dark DN15-DN100

			h4.tags-catalog__subtitle .ss-tag.ss-tag--plain (без фона, цвет через .ss-txt-*)
			.tags-catalog__demo.ss-bg-gray
				span.ss-tag.ss-tag--plain.ss-txt-accent1 # news tag
				|
				span.ss-tag.ss-tag--plain.ss-txt-accent3 # news tag

			//- ===== Группа =====
			h3.tags-catalog__section-title Группа (.ss-tag-group)
			p.tags-catalog__hint.ss-reg-14.ss-txt-secondary
				| Родитель с
				code flex-wrap
				| и
				code gap: 10
				| . Тэги переносятся при нехватке ширины.

			h4.tags-catalog__subtitle Светлые
			.tags-catalog__demo.ss-bg-gray
				.ss-tag-group
					span.ss-tag до 90% возврата
					span.ss-tag Авт. управление
					span.ss-tag Расчёт за 4 часа
					span.ss-tag Блочная поставка

			h4.tags-catalog__subtitle Тёмные
			.tags-catalog__demo.ss-bg-gray
				.ss-tag-group
					span.ss-tag.ss-tag--dark TLV
					span.ss-tag.ss-tag--dark DN15-DN100
					span.ss-tag.ss-tag--dark 16 бар
					span.ss-tag.ss-tag--dark нерж. сталь

			h4.tags-catalog__subtitle На тёмном фоне (белые плашки)
			.tags-catalog__demo.ss-bg-primary(style="padding:24px;")
				.ss-section-hero__head
					span.ss-kicker.ss-txt-accent3 Каталог
					h2.ss-h2 Готовые системы
					.ss-tag-group
						span.ss-tag 13 типов готовых решений
						span.ss-tag Расчёт за 1 день
						span.ss-tag Блочная поставка

			//- ===== Сниппет =====
			h3.tags-catalog__section-title Сниппеты
			pre.tags-catalog__snippet
				code
					| span.ss-tag Текст
					|
					| span.ss-tag.ss-tag--dark Текст
					|
					| .ss-tag-group
					|     span.ss-tag Первый
					|     span.ss-tag Второй
					|     span.ss-tag Третий
