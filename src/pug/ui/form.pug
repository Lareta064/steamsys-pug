extends ../layouts/layout-ui.pug

block content
	.container-dashboard.ss-wrapper
		h2.db-h2 Элементы формы

		.container-dashboard__content

			p.form-catalog__intro.ss-reg-14.ss-txt-secondary
				| Стили —
				code src/scss/base/_form.scss
				| . Компоненты рассчитаны на тёмный фон (текст/иконки — светлые, border —
				code --secondary
				| ). Демо ниже — на подложке
				code .ss-bg-primary
				| .

			//- ========== Оглавление ==========
			nav.form-catalog__toc
				h3.form-catalog__toc-title Оглавление
				ul.form-catalog__toc-list
					li: a(href='#input') .ss-input
					li: a(href='#textarea') .ss-textarea
					li: a(href='#file') .ss-file
					li: a(href='#form-row') .ss-form-row — тёмная / светлая
					li: a(href='#checkbox') .ss-checkbox — тёмный / светлый
					li: a(href='#radio') .ss-radio — тёмный / светлый
					li: a(href='#composed') Полный пример
					li: a(href='#search') .ss-search-wrapper — поиск
					li: a(href='#b24-form') .ss-b24-form — светлая тема

			//- ========== Input ==========
			section.form-catalog__section#input
				h3.form-catalog__section-title .ss-input
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Однострочное поле. Высота 65, скругление 10, прозрачный фон,
					code border: 1px solid --secondary
					| , текст ввода — белый.
					br
					| Подсказка рисуется плавающим label'ом (
					code span.ss-form-label
					|  как соседний узел). В покое label лежит внутри поля как placeholder, при фокусе / когда в поле что-то напечатано — уезжает в top-left. Механика полностью на CSS через
					code :focus-within
					|  +
					code :has(:not(:placeholder-shown))
					| . Именно поэтому у input'а
					strong обязателен
					code placeholder=" "
					|  (пробел) — без него
					code :placeholder-shown
					|  не отличает пустое поле от заполненного.

				.form-catalog__demo.ss-bg-primary
					.ss-form-item
						input.ss-input(type='text', placeholder=' ')
						span.ss-form-label Ваше имя

				pre.form-catalog__snippet
					code
						| .ss-form-item
						|     input.ss-input(type='text', placeholder=' ')
						|     span.ss-form-label Ваше имя

			//- ========== Textarea ==========
			section.form-catalog__section#textarea
				h3.form-catalog__section-title .ss-textarea
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Многострочное поле. Высота 120,
					code resize: none
					| . Плавающий label — как у
					code .ss-input
					| , только в покое стоит у верхнего края (не по центру).

				.form-catalog__demo.ss-bg-primary
					.ss-form-item
						textarea.ss-textarea(placeholder=' ')
						span.ss-form-label Комментарий к файлу или краткое описание задачи

				pre.form-catalog__snippet
					code
						| .ss-form-item
						|     textarea.ss-textarea(placeholder=' ')
						|     span.ss-form-label Комментарий…

			//- ========== File ==========
			section.form-catalog__section#file
				h3.form-catalog__section-title .ss-file
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					|
					code &lt;label&gt;
					|  с визуально скрытым
					code &lt;input type="file"&gt;
					| . Квадратная кнопка с иконкой
					code clip
					|  + подпись справа. Клик на всём лейбле открывает диалог выбора файла.
					br
					| После выбора файла (JS
					code src/js/file-input.js
					| ): подпись меняется на имя файла + справа появляется кнопка удаления (
					code svg-delete
					| ). Клик по кнопке очищает input и возвращает всё в дефолт.

				.form-catalog__demo.ss-bg-primary
					.ss-form-item
						label.ss-file
							input.ss-file__input(type='file')
							span.ss-file__icon
								+svgIcon('clip')
							span.ss-file__label Прикрепить ТЗ, спецификацию или опросный лист
							button.ss-file__remove(type='button', aria-label='Удалить прикреплённый файл')
								+svgIcon('delete')

				pre.form-catalog__snippet
					code
						| .ss-form-item
						|     label.ss-file
						|         input.ss-file__input(type='file')
						|         span.ss-file__icon
						|             +svgIcon('clip')
						|         span.ss-file__label Прикрепить …
						|         button.ss-file__remove(type='button', aria-label='Удалить прикреплённый файл')
						|             +svgIcon('delete')

			//- ========== Form row (dark) ==========
			section.form-catalog__section#form-row
				h3.form-catalog__section-title .ss-form-row
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Секционная плашка «Есть спецификация от инженера?» — быстрый путь для закупщика на странице каталога (по референсу
					code /steamsys/wireframes/wireframe_07_kategoriya_oborudovaniya.html
					|  → div.spec-strip). Обёртка
					code .ss-form-row
					|  — на 100% ширины экрана (dark bg), внутри — стандартный
					code .ss-container
					| , внутри —
					code .ss-form-row__inner
					|  (grid из 3 колонок: label auto | fields 1fr | submit auto).
					br
					| Fields — 3
					code .ss-form-item
					|  с
					code .ss-input
					|  и плавающим label (
					code .ss-form-label
					| ) + компонент
					code .ss-file
					|  (label + hidden input + иконка + подпись + кнопка удаления). Всё — наши общие UI-компоненты формы.
					br
					| Drag&amp;drop нет — клик по
					code .ss-file
					|  открывает диалог выбора файла (нативно). Подмена подписи на имя файла + показ кнопки удаления — существующим
					code src/js/file-input.js
					| .
					br
					| Раскладка:
					code ≥1600
					|  — 3 колонки (label | fields | submit);
					code 1200–1599
					|  — label наверх на всю ширину, ниже fields + submit;
					code &lt; $xl
					|  — всё в столбик.
					br
					| Светлая тема — модификатор
					code .ss-form-row--light
					|  (фон
					code --secondary3
					| , текст
					code --primary
					| , focus/hover у полей —
					code --accent1
					| , submit-кнопка
					code variant: 'primary'
					| ).

				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Живой пример — на отдельной секционной странице
					code /ui/form-row.html
					|  (layout-ui-sections, без sidebar — блок на 100% ширины выглядит корректно). Здесь не дублируем: узкий каталог с левой панелью «съедает» плашку.

				pre.form-catalog__snippet
					code
						| .ss-form-row
						|     .ss-container
						|         .ss-form-row__inner
						|             .ss-form-row__label
						|                 p.ss-semi-18 Есть спецификация от инженера?
						|                 p.ss-reg-14.ss-txt-secondary1 Загрузите файл — пришлём КП по каждой позиции
						|             .ss-form-row__fields
						|                 .ss-form-item
						|                     input.ss-input.ss-input--sm(type='text' placeholder=' ')
						|                     span.ss-form-label Ваше имя
						|                 .ss-form-item
						|                     input.ss-input.ss-input--sm(type='tel' placeholder=' ')
						|                     span.ss-form-label Телефон
						|                 .ss-form-item
						|                     input.ss-input.ss-input--sm(type='email' placeholder=' ')
						|                     span.ss-form-label Email
						|                 label.ss-file.ss-file--sm
						|                     input.ss-file__input(type='file' accept='.pdf,.xls,.xlsx,.doc,.docx')
						|                     span.ss-file__icon
						|                         +svgIcon('clip')
						|                     span.ss-file__label Прикрепить файл
						|                     button.ss-file__remove(type='button', aria-label='Удалить прикреплённый файл')
						|                         +svgIcon('delete')
						|             +ssBtn('Получить КП', { variant: 'white', icon: 'arrow-right' })

			//- ========== Checkbox ==========
			section.form-catalog__section#checkbox
				h3.form-catalog__section-title .ss-checkbox
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Кастомный чекбокс: скрытый нативный
					code &lt;input&gt;
					|  + видимый
					code span.ss-checkbox__box
					| . В подпись можно вложить ссылку.
					br
					| Checked-состояние одинаковое у обоих вариантов: border + bg =
					code --accent3
					| , галочка белая.

				h4.form-catalog__subtitle Тёмный фон (default) —
					code .ss-checkbox
				.form-catalog__demo.ss-bg-primary
					label.ss-checkbox
						input.ss-checkbox__input(type='checkbox')
						span.ss-checkbox__box
						span.ss-checkbox__label
							| Нажимая кнопку, вы соглашаетесь с
							a(href='#') политикой конфиденциальности

				h4.form-catalog__subtitle Светлый фон —
					code .ss-checkbox--light
				.form-catalog__demo
					label.ss-checkbox.ss-checkbox--light
						input.ss-checkbox__input(type='checkbox')
						span.ss-checkbox__box
						span.ss-checkbox__label
							| Нажимая кнопку, вы соглашаетесь с
							a(href='#') политикой конфиденциальности

				pre.form-catalog__snippet
					code
						| //- Тёмный
						| label.ss-checkbox
						|     input.ss-checkbox__input(type='checkbox')
						|     span.ss-checkbox__box
						|     span.ss-checkbox__label Подпись
						|
						| //- Светлый — добавляем модификатор --light
						| label.ss-checkbox.ss-checkbox--light
						|     input.ss-checkbox__input(type='checkbox')
						|     span.ss-checkbox__box
						|     span.ss-checkbox__label Подпись

			//- ========== Radio ==========
			section.form-catalog__section#radio
				h3.form-catalog__section-title .ss-radio
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Круглая радиокнопка 20×20 с внутренним индикатором — закрашенный круг 10×10.
					br
					strong Unchecked:
					|  только внешняя рамка (
					code --secondary
					|  для тёмного фона /
					code --primary
					|  для светлого), внутренний круг прозрачный.
					br
					strong Checked:
					|  внешняя рамка становится
					code --accent3
					| , внутренний круг заливается
					code --accent3
					| . В отличие от чекбокса, наружная область НЕ заливается.
					br
					| Радиокнопки одной группы объединяются через одинаковый атрибут
					code name
					| .

				h4.form-catalog__subtitle Тёмный фон (default) —
					code .ss-radio
				.form-catalog__demo.ss-bg-primary
					label.ss-radio
						input.ss-radio__input(type='radio', name='demo-dark', checked)
						span.ss-radio__box
						span.ss-radio__label Первый вариант
					label.ss-radio(style='margin-left: 20px')
						input.ss-radio__input(type='radio', name='demo-dark')
						span.ss-radio__box
						span.ss-radio__label Второй вариант

				h4.form-catalog__subtitle Светлый фон —
					code .ss-radio--light
				.form-catalog__demo
					label.ss-radio.ss-radio--light
						input.ss-radio__input(type='radio', name='demo-light', checked)
						span.ss-radio__box
						span.ss-radio__label Первый вариант
					label.ss-radio.ss-radio--light(style='margin-left: 20px')
						input.ss-radio__input(type='radio', name='demo-light')
						span.ss-radio__box
						span.ss-radio__label Второй вариант

				pre.form-catalog__snippet
					code
						| //- Тёмный
						| label.ss-radio
						|     input.ss-radio__input(type='radio', name='group1')
						|     span.ss-radio__box
						|     span.ss-radio__label Вариант
						|
						| //- Светлый — модификатор --light
						| label.ss-radio.ss-radio--light
						|     input.ss-radio__input(type='radio', name='group2')
						|     span.ss-radio__box
						|     span.ss-radio__label Вариант

			//- ========== Composed ==========
			section.form-catalog__section#composed
				h3.form-catalog__section-title Полный пример
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Собранная форма по макету
					code temps/form.png
					| . Раскладка (2 в ряд для имени/телефона) — на консьюмере (grid / flex),
					| компоненты никак от неё не зависят.

				.form-catalog__demo.ss-bg-primary
					form.form-catalog__form
						.form-catalog__row
							.ss-form-item
								input.ss-input(type='text', placeholder=' ')
								span.ss-form-label Ваше имя
							.ss-form-item
								input.ss-input(type='tel', placeholder=' ')
								span.ss-form-label Телефон
						.ss-form-item
							input.ss-input(type='email', placeholder=' ')
							span.ss-form-label Email для отправки КП
						.ss-form-item
							label.ss-file
								input.ss-file__input(type='file')
								span.ss-file__icon
									+svgIcon('clip')
								span.ss-file__label Прикрепить ТЗ, спецификацию или опросный лист
								button.ss-file__remove(type='button', aria-label='Удалить прикреплённый файл')
									+svgIcon('delete')
						.ss-form-item
							textarea.ss-textarea(placeholder=' ')
							span.ss-form-label Комментарий к файлу или краткое описание задачи
						.ss-form-item
							label.ss-checkbox
								input.ss-checkbox__input(type='checkbox')
								span.ss-checkbox__box
								span.ss-checkbox__label
									| Нажимая кнопку, вы соглашаетесь с
									a(href='#') политикой конфиденциальности

			//- ========== Search ==========
			section.form-catalog__section#search
				h3.form-catalog__section-title .ss-search-wrapper
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Строка поиска: инпут + акцентная кнопка «Найти» в одной пилюле.
					| Обёртка
					code .ss-search-wrapper
					|  держит flex-раскладку, радиус и
					code overflow: hidden
					|  — благодаря чему скругляются внешние углы, а внутренние элементы могут иметь свои собственные border-radius (значения не важны, обрезаются).
					br
					| Кнопка использует новый вариант
					code .ss-btn--accent5
					|  (оранжевый
					code --accent5 = #F0A000
					| ).

				h4.form-catalog__subtitle С белым фоном инпута —
					code .ss-search-wrapper.ss-input-bg-white
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Модификатор
					code .ss-input-bg-white
					|  вешается на обёртку (не на сам input). Причина: если внутренний
					code input
					|  однажды заменит виджет (битрикс или сторонний search-скрипт), стилевой якорь останется на обёртке — визуал не поплывёт.

				.form-catalog__demo.ss-bg-primary
					.ss-search-wrapper.ss-input-bg-white
						input.ss-search__input(type='search', placeholder='Найти статью — например, «гидроудары» или «поплавковый конденсатоотводчик»')
						+ssBtn('Найти', { variant: 'accent5' })

				pre.form-catalog__snippet
					code
						| .ss-search-wrapper.ss-input-bg-white
						|     input.ss-search__input(type='search', placeholder='Найти…')
						|     +ssBtn('Найти', { variant: 'accent5' })

			//- ========== Bitrix-форма (светлая тема) ==========
			section.form-catalog__section#b24-form
				h3.form-catalog__section-title .ss-b24-form
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Мок разметки, которую генерирует битрикс-скрипт CRM-формы (
					code .b24-form-*
					| ), внутри нашей обёртки
					code .ss-b24-form
					| . При интеграции всё содержимое
					code .b24-form
					|  заменяется на одну строчку —
					code &lt;script data-b24-form="..."&gt;
					| . Обёртка и модификатор темы остаются.
					br
					| Темизация — через локальные CSS-переменные
					code --b24-*
					| . По дефолту тёмная тема; для светлого фона — модификатор
					code .ss-b24-form--light
					| . Полное описание с таблицей переменных и правилами интеграции — в
					code /ui/docs.html#bitrix-form
					| .

				h4.form-catalog__subtitle Тёмная тема —
					code .ss-b24-form
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Живой пример — на страницах каталога
					code /ui/section-feedback-b24.html
					|  (секция) и
					code /ui/modal-request-b24.html
					|  (модалка). Здесь не дублируем — разметка длинная, задваивать страницу нет смысла.

				h4.form-catalog__subtitle Светлая тема —
					code .ss-b24-form.ss-b24-form--light
				.form-catalog__demo.form-catalog__demo--b24-light
					.ss-b24-form.ss-b24-form--light
						.b24-form
							.b24-form-wrapper
								.b24-form-content
									.b24-form-padding-side

										.b24-form-field.b24-form-field-string
											.b24-form-control-container
												.b24-form-control-label
													span.b24-form-control-label-name Ваше имя
													span.b24-form-control-label-required *
												input.b24-form-control.b24-form-control-string(type='text', name='NAME', placeholder=' ')

										.b24-form-field.b24-form-field-phone
											.b24-form-control-container
												.b24-form-control-label
													span.b24-form-control-label-name Телефон
													span.b24-form-control-label-required *
												input.b24-form-control.b24-form-control-string(type='tel', name='PHONE', placeholder=' ')

										.b24-form-field.b24-form-field-email
											.b24-form-control-container
												.b24-form-control-label
													span.b24-form-control-label-name Email для отправки КП
												input.b24-form-control.b24-form-control-string(type='email', name='EMAIL', placeholder=' ')

										.b24-form-field.b24-form-field-file
											.b24-form-control-container
												label.b24-form-control-file
													input.b24-form-control-file-input(type='file', name='FILE')
													span.b24-form-control-file-icon
														+svgIcon('clip')
													span.b24-form-control-file-label Прикрепить ТЗ, спецификацию или опросный лист
													button.b24-form-control-file-remove(type='button', aria-label='Удалить прикреплённый файл')
														+svgIcon('delete')

										.b24-form-field.b24-form-field-text
											.b24-form-control-container
												.b24-form-control-label
													span.b24-form-control-label-name Комментарий к файлу или краткое описание задачи
												textarea.b24-form-control.b24-form-control-textarea(name='COMMENTS', placeholder=' ')

										.b24-form-field.b24-form-field-agreement
											label.b24-form-field-agreement-label
												.b24-form-control-agreement
													.b24-form-control-agreement-checkbox
														input.b24-form-control-agreement-checkbox-input(type='checkbox', name='AGREEMENT')
														span.b24-form-control-agreement-checkbox-square
													.b24-form-control-agreement-text
														| Нажимая кнопку, вы соглашаетесь с
														a(href='#') политикой конфиденциальности

								.b24-form-btn-block
									.b24-form-btn-container
										button.b24-form-btn.b24-form-btn-shadow(type='submit')
											span.b24-form-btn-icon
												+svgIcon('mail')
											span.b24-form-btn-text Получить расчёт

				pre.form-catalog__snippet
					code
						| .ss-b24-form.ss-b24-form--light
						|     .b24-form
						|         .b24-form-wrapper
						|             .b24-form-content
						|                 .b24-form-padding-side
						|                     .b24-form-field.b24-form-field-string
						|                         .b24-form-control-container
						|                             .b24-form-control-label
						|                                 span.b24-form-control-label-name Ваше имя
						|                                 span.b24-form-control-label-required *
						|                             input.b24-form-control(type='text', name='NAME', placeholder=' ')
						|                     .b24-form-field.b24-form-field-phone
						|                         ... (аналогично, name='PHONE')
						|                     .b24-form-field.b24-form-field-email  ... (name='EMAIL')
						|                     .b24-form-field.b24-form-field-file   ... (label+input[type=file])
