extends ../layouts/layout-ui.pug

block content
	.container-dashboard.ss-wrapper
		h2.db-h2 Элементы формы

		.container-dashboard__content

			p.form-catalog__intro.ss-reg-14.ss-txt-secondary
				| Стили —
				code src/scss/base/_form.scss
				| . Компоненты рассчитаны на тёмный фон (текст/иконки — светлые, border —
				code --secondary
				| ). Демо ниже — на подложке
				code .ss-bg-primary
				| .

			//- ========== Оглавление ==========
			nav.form-catalog__toc
				h3.form-catalog__toc-title Оглавление
				ul.form-catalog__toc-list
					li: a(href='#input') .ss-input
					li: a(href='#textarea') .ss-textarea
					li: a(href='#file') .ss-file
					li: a(href='#checkbox') .ss-checkbox — тёмный / светлый
					li: a(href='#radio') .ss-radio — тёмный / светлый
					li: a(href='#composed') Полный пример

			//- ========== Input ==========
			section.form-catalog__section#input
				h3.form-catalog__section-title .ss-input
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Однострочное поле. Высота 65, скругление 10, прозрачный фон,
					code border: 1px solid --secondary
					| . Placeholder — цвет
					code --secondary
					| , текст ввода — белый.

				.form-catalog__demo.ss-bg-primary
					.ss-form-item
						input.ss-input(type='text', placeholder='Ваше имя')

				pre.form-catalog__snippet
					code
						| .ss-form-item
						|     input.ss-input(type='text', placeholder='Ваше имя')

			//- ========== Textarea ==========
			section.form-catalog__section#textarea
				h3.form-catalog__section-title .ss-textarea
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Многострочное поле. Высота 120,
					code resize: none
					| . Остальные стили — как у
					code .ss-input
					| .

				.form-catalog__demo.ss-bg-primary
					.ss-form-item
						textarea.ss-textarea(placeholder='Комментарий к файлу или краткое описание задачи')

				pre.form-catalog__snippet
					code
						| .ss-form-item
						|     textarea.ss-textarea(placeholder='Комментарий…')

			//- ========== File ==========
			section.form-catalog__section#file
				h3.form-catalog__section-title .ss-file
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					|
					code &lt;label&gt;
					|  с визуально скрытым
					code &lt;input type="file"&gt;
					| . Квадратная кнопка с иконкой
					code clip
					|  + подпись справа. Клик на всём лейбле открывает диалог выбора файла.

				.form-catalog__demo.ss-bg-primary
					.ss-form-item
						label.ss-file
							input.ss-file__input(type='file')
							span.ss-file__icon
								+svgIcon('clip')
							span.ss-file__label Прикрепить ТЗ, спецификацию или опросный лист

				pre.form-catalog__snippet
					code
						| .ss-form-item
						|     label.ss-file
						|         input.ss-file__input(type='file')
						|         span.ss-file__icon
						|             +svgIcon('clip')
						|         span.ss-file__label Прикрепить …

			//- ========== Checkbox ==========
			section.form-catalog__section#checkbox
				h3.form-catalog__section-title .ss-checkbox
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Кастомный чекбокс: скрытый нативный
					code &lt;input&gt;
					|  + видимый
					code span.ss-checkbox__box
					| . В подпись можно вложить ссылку.
					br
					| Checked-состояние одинаковое у обоих вариантов: border + bg =
					code --accent3
					| , галочка белая.

				h4.form-catalog__subtitle Тёмный фон (default) —
					code .ss-checkbox
				.form-catalog__demo.ss-bg-primary
					label.ss-checkbox
						input.ss-checkbox__input(type='checkbox')
						span.ss-checkbox__box
						span.ss-checkbox__label
							| Нажимая кнопку, вы соглашаетесь с
							a(href='#') политикой конфиденциальности

				h4.form-catalog__subtitle Светлый фон —
					code .ss-checkbox--light
				.form-catalog__demo
					label.ss-checkbox.ss-checkbox--light
						input.ss-checkbox__input(type='checkbox')
						span.ss-checkbox__box
						span.ss-checkbox__label
							| Нажимая кнопку, вы соглашаетесь с
							a(href='#') политикой конфиденциальности

				pre.form-catalog__snippet
					code
						| //- Тёмный
						| label.ss-checkbox
						|     input.ss-checkbox__input(type='checkbox')
						|     span.ss-checkbox__box
						|     span.ss-checkbox__label Подпись
						|
						| //- Светлый — добавляем модификатор --light
						| label.ss-checkbox.ss-checkbox--light
						|     input.ss-checkbox__input(type='checkbox')
						|     span.ss-checkbox__box
						|     span.ss-checkbox__label Подпись

			//- ========== Radio ==========
			section.form-catalog__section#radio
				h3.form-catalog__section-title .ss-radio
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Круглая радиокнопка 20×20 с внутренним индикатором — закрашенный круг 10×10.
					br
					strong Unchecked:
					|  только внешняя рамка (
					code --secondary
					|  для тёмного фона /
					code --primary
					|  для светлого), внутренний круг прозрачный.
					br
					strong Checked:
					|  внешняя рамка становится
					code --accent3
					| , внутренний круг заливается
					code --accent3
					| . В отличие от чекбокса, наружная область НЕ заливается.
					br
					| Радиокнопки одной группы объединяются через одинаковый атрибут
					code name
					| .

				h4.form-catalog__subtitle Тёмный фон (default) —
					code .ss-radio
				.form-catalog__demo.ss-bg-primary
					label.ss-radio
						input.ss-radio__input(type='radio', name='demo-dark', checked)
						span.ss-radio__box
						span.ss-radio__label Первый вариант
					label.ss-radio(style='margin-left: 20px')
						input.ss-radio__input(type='radio', name='demo-dark')
						span.ss-radio__box
						span.ss-radio__label Второй вариант

				h4.form-catalog__subtitle Светлый фон —
					code .ss-radio--light
				.form-catalog__demo
					label.ss-radio.ss-radio--light
						input.ss-radio__input(type='radio', name='demo-light', checked)
						span.ss-radio__box
						span.ss-radio__label Первый вариант
					label.ss-radio.ss-radio--light(style='margin-left: 20px')
						input.ss-radio__input(type='radio', name='demo-light')
						span.ss-radio__box
						span.ss-radio__label Второй вариант

				pre.form-catalog__snippet
					code
						| //- Тёмный
						| label.ss-radio
						|     input.ss-radio__input(type='radio', name='group1')
						|     span.ss-radio__box
						|     span.ss-radio__label Вариант
						|
						| //- Светлый — модификатор --light
						| label.ss-radio.ss-radio--light
						|     input.ss-radio__input(type='radio', name='group2')
						|     span.ss-radio__box
						|     span.ss-radio__label Вариант

			//- ========== Composed ==========
			section.form-catalog__section#composed
				h3.form-catalog__section-title Полный пример
				p.form-catalog__hint.ss-reg-14.ss-txt-secondary
					| Собранная форма по макету
					code temps/form.png
					| . Раскладка (2 в ряд для имени/телефона) — на консьюмере (grid / flex),
					| компоненты никак от неё не зависят.

				.form-catalog__demo.ss-bg-primary
					form.form-catalog__form
						.form-catalog__row
							.ss-form-item: input.ss-input(type='text', placeholder='Ваше имя')
							.ss-form-item: input.ss-input(type='tel', placeholder='Телефон')
						.ss-form-item
							input.ss-input(type='email', placeholder='Email для отправки КП')
						.ss-form-item
							label.ss-file
								input.ss-file__input(type='file')
								span.ss-file__icon
									+svgIcon('clip')
								span.ss-file__label Прикрепить ТЗ, спецификацию или опросный лист
						.ss-form-item
							textarea.ss-textarea(placeholder='Комментарий к файлу или краткое описание задачи')
						.ss-form-item
							label.ss-checkbox
								input.ss-checkbox__input(type='checkbox')
								span.ss-checkbox__box
								span.ss-checkbox__label
									| Нажимая кнопку, вы соглашаетесь с
									a(href='#') политикой конфиденциальности
