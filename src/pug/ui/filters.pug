extends ../layouts/layout-ui-sections.pug

block content
	//- Демо-раскладка: сайдбар слева (~280) + пустая main-зона справа.
	//- В реальном каталоге сетку задаёт страница; здесь inline-стили только
	//- ради быстрого визуального контекста.
	.ss-container.ss-wrapper(style='padding-block: 40px;')
		div(style='display: grid; grid-template-columns: 280px 1fr; gap: 30px; align-items: start;')
			include ../sections/_filters.pug
			div(style='min-height: 400px; border: 1px dashed var(--secondary2); border-radius: 10px; padding: 30px; color: var(--secondary);')
				p Main-контент каталога (карточки товаров, сортировка, пагинация).
