extends ../layouts/layout-ui.pug

block content
	//- Единый образец текста для всех превью
	- var sampleH = 'Съешь ещё этих мягких французских булок'
	- var sampleB = 'Съешь ещё этих мягких французских булок, да выпей чаю'

	//- Заголовки — fluid: mobile→desktop через clamp() (744↔1920 viewport)
	- var headings = [{ c: 'ss-h1', s: 'SemiBold · 32→62 fluid · 1.25' }, { c: 'ss-h2', s: 'SemiBold · 28→50 fluid · 1.25' }, { c: 'ss-h3', s: 'SemiBold · 28→46 fluid · 1.25' }, { c: 'ss-h4', s: 'SemiBold · 24→40 fluid · 1.25' }, { c: 'ss-h5', s: 'SemiBold · 22→32 fluid · 1.3' }, { c: 'ss-h6', s: 'SemiBold · 20→28 fluid · 1.3' }]

	- var sizes = [{ n: 28, lh: 130 }, { n: 24, lh: 130 }, { n: 22, lh: 130 }, { n: 20, lh: 140 }, { n: 18, lh: 140 }, { n: 16, lh: 140 }, { n: 14, lh: 140 }, { n: 12, lh: 140 }]

	.container-dashboard.ss-wrapper
		h2.db-h2 Типографика

		.container-dashboard__content

			//- ===== Заголовки =====
			h3(style="margin-top:32px; margin-bottom:16px;") Заголовки
			.ss-wrapper
				each h in headings
					div(style="display:flex; flex-direction:column; gap:4px; margin-bottom:24px;")
						div(class=h.c)= sampleH
						p.ss-reg-14.ss-txt-secondary .#{h.c} — #{h.s}

			//- ===== Body — Regular (400) =====
			h3(style="margin-top:48px; margin-bottom:16px;") Body — Regular (400)
			.ss-wrapper
				each s in sizes
					div(style="display:flex; flex-direction:column; gap:4px; margin-bottom:20px;")
						p(class='ss-reg-' + s.n)= sampleB
						p.ss-reg-14.ss-txt-secondary .ss-reg-#{s.n} — Regular, #{s.n}/#{s.lh}/0

			//- ===== Body — Medium (500) =====
			h3(style="margin-top:48px; margin-bottom:16px;") Body — Medium (500)
			.ss-wrapper
				each s in sizes
					div(style="display:flex; flex-direction:column; gap:4px; margin-bottom:20px;")
						p(class='ss-medi-' + s.n)= sampleB
						p.ss-reg-14.ss-txt-secondary .ss-medi-#{s.n} — Medium, #{s.n}/#{s.lh}/0

			//- ===== Body — SemiBold (600) =====
			h3(style="margin-top:48px; margin-bottom:16px;") Body — SemiBold (600)
			.ss-wrapper
				each s in sizes
					div(style="display:flex; flex-direction:column; gap:4px; margin-bottom:20px;")
						p(class='ss-semi-' + s.n)= sampleB
						p.ss-reg-14.ss-txt-secondary .ss-semi-#{s.n} — SemiBold, #{s.n}/#{s.lh}/0
