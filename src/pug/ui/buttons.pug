extends ../layouts/layout-ui.pug

block content
	//- Все варианты кнопок из макета.
	- var variants = [{ code: 'primary', label: 'Primary' }, { code: 'secondary', label: 'Secondary' }, { code: 'outline', label: 'Outline' }, { code: 'outline-dark', label: 'Outline dark' }, { code: 'dark', label: 'Dark' }, { code: 'light', label: 'Light' }, { code: 'outline-light', label: 'Outline light' }, { code: 'white', label: 'White' }]

	.container-dashboard.ss-wrapper
		h2.db-h2 Кнопки
		.container-dashboard__content
			.menu-toggle#menu-toggle(style="display: flex!important;")
				span
			p.buttons-catalog__intro.ss-reg-14.ss-txt-secondary
				| Кнопки подключаются через миксин
				code +ssBtn('Текст', { variant: 'primary' })
				| из
				code src/pug/mixins/_ss-button.pug

			//- ===== Варианты (по умолчанию — 65px) =====
			h3.buttons-catalog__section-title Варианты · 65px (базовый размер, без опции)
			ul.buttons-catalog
				each v in variants
					li.buttons-catalog__item
						.buttons-catalog__preview
							+ssBtn('Текст кнопки', { variant: v.code, icon: 'plus-circle' })
						.buttons-catalog__meta
							span.buttons-catalog__label= v.label
							code.buttons-catalog__name .ss-btn.ss-btn--#{v.code}
							pre.buttons-catalog__snippet
								code +ssBtn('Текст', { variant: '#{v.code}', icon: 'plus-circle' })

			//- ===== Варианты (big — 74px) =====
			h3.buttons-catalog__section-title Варианты · big — 74px (модификатор
				code .ss-btn--big
				|, используется только для двух кнопок в hero)
			ul.buttons-catalog
				each v in variants
					li.buttons-catalog__item
						.buttons-catalog__preview
							+ssBtn('Текст кнопки', { variant: v.code, size: 'big', icon: 'plus-circle' })
						.buttons-catalog__meta
							span.buttons-catalog__label= v.label + ' · big'
							code.buttons-catalog__name .ss-btn.ss-btn--#{v.code}.ss-btn--big
							pre.buttons-catalog__snippet
								code +ssBtn('Текст', { variant: '#{v.code}', size: 'big', icon: 'plus-circle' })

			//- ===== Иконка: справа / слева / без =====
			h3.buttons-catalog__section-title Иконка
			.buttons-catalog__row
				+ssBtn('Иконка справа', { variant: 'primary', icon: 'plus-circle' })
				+ssBtn('Иконка слева', { variant: 'primary', icon: 'plus-circle', iconSide: 'left' })
				+ssBtn('Без иконки', { variant: 'primary' })

			//- ===== Состояния =====
			h3.buttons-catalog__section-title Состояния
			.buttons-catalog__row
				+ssBtn('Normal', { variant: 'primary' })
				+ssBtn('Disabled', { variant: 'primary', disabled: true })
				+ssBtn('Link disabled', { variant: 'primary', tag: 'a', href: '#', disabled: true })
			p.buttons-catalog__hint.ss-reg-14.ss-txt-secondary Наведи мышью — hover. Нажми Tab — focus-visible.

			//- ===== Тег: button / a =====
			h3.buttons-catalog__section-title Тег
			.buttons-catalog__row
				+ssBtn('button', { variant: 'primary' })
				+ssBtn('ссылка', { variant: 'primary', tag: 'a', href: '#' })

			//- ===== Full width =====
			h3.buttons-catalog__section-title На всю ширину
			+ssBtn('Кнопка на всю ширину', { variant: 'primary', full: true, icon: 'plus-circle' })

			//- ===== Квадратная кнопка с иконкой =====
			h3.buttons-catalog__section-title Квадратная кнопка (.ss-icon-btn)
			p.buttons-catalog__intro.ss-reg-14.ss-txt-secondary
				| Отдельный компонент — квадратная кнопка 65×64 с иконкой (svg 24×24) по центру. Используется на карточке решения и в тулбарах. Миксин
				code +ssIconBtn(iconName, { variant, tag, href, label, disabled })
				|  из
				code src/pug/mixins/_ss-icon-btn.pug
				| . Два варианта:
				code default
				|  — тёмный фон
				code --primary
				|  → hover
				code --accent1
				| .
				code accent
				|  — фон
				code --accent1
				|  → hover
				code --accent2
				| .

			h4.buttons-catalog__subtitle default
			.buttons-catalog__row(style="gap:16px;")
				+ssIconBtn('arrow-up-right', { label: 'Перейти к решению' })
				+ssIconBtn('arrow-right', { label: 'Далее' })
				+ssIconBtn('plus-circle', { label: 'Добавить' })
				+ssIconBtn('arrow-up-right', { tag: 'a', href: '#', label: 'Ссылка' })
				+ssIconBtn('arrow-up-right', { label: 'Disabled', disabled: true })

			h4.buttons-catalog__subtitle --accent
			.buttons-catalog__row(style="gap:16px;")
				+ssIconBtn('arrow-up-right', { variant: 'accent', label: 'Перейти' })
				+ssIconBtn('plus-circle', { variant: 'accent', label: 'Добавить' })


			//- ===== Стрелки Swiper-слайдера =====
			h3.buttons-catalog__section-title Стрелки Swiper (.ss-swiper-btn)
			p.buttons-catalog__intro.ss-reg-14.ss-txt-secondary
				| Универсальные стрелки навигации Swiper-слайдеров. Один класс на кнопку — визуал и позиционирование внутри слайдера. Модификатор
				code --prev
				|  /
				code --next
				|  задаёт и chevron-иконку, и absolute-позицию (left/right 20px, top center). Родитель-слайдер должен быть
				code position: relative
				| . 65×64, radius 10, svg 24×24, bg
				code --secondary3
				|  → hover
				code --accent1
				| . Скрыты на
				code < $lg
				|  (моб/планшет — работает свайп). Стили —
				code src/scss/blocks/_swiper-btn.scss
				| , миксин —
				code src/pug/mixins/_ss-swiper-btn.pug
				| .

			.buttons-catalog__row(style="position: relative; gap: 16px;")
				+ssSwiperBtn('prev')(style='position: static; transform: none;')
				+ssSwiperBtn('next')(style='position: static; transform: none;')

			p.buttons-catalog__intro.ss-reg-14.ss-txt-secondary(style="margin-top: 10px;")
				| В демо выше — inline-стили обнуляют position, чтобы стрелки показались бок о бок без слайдера-родителя. В реальной разметке position/transform уже включены в модификаторы
				code --prev/--next
				| .

			pre.buttons-catalog__snippet(style="margin-top:16px;")
				code
					| +ssSwiperBtn('prev')
					| +ssSwiperBtn('next')
