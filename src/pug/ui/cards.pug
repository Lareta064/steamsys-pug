extends ../layouts/layout-ui.pug

block content
	//- Данные для feature-card demo
	- var featureItems = [{ icon: 'target', title: 'Аудит и диагностика', text: 'Анализируем систему, выявляем потери и точки роста эффективности' }, { icon: 'doc', title: 'Проектирование', text: 'Проектируем надёжные системы под задачи вашего производства' }, { icon: 'tool', title: 'Внедрение', text: 'Поставляем оборудование, выполняем монтаж и пусконаладочные работы' }, { icon: 'headset', title: 'Сервис и поддержка', text: 'Обслуживаем системы и обеспечиваем стабильную работу 24/7' }]

	.container-dashboard.ss-wrapper
		h2.db-h2 Cards

		.container-dashboard__content

			p.cards-catalog__intro.ss-reg-14.ss-txt-secondary
				| Компоненты-карточки редизайна. Раскладку N в ряд решает родительский
				code .ss-grid
				| .

			//- ========== Оглавление ==========
			nav.cards-catalog__toc
				h3.cards-catalog__toc-title Оглавление
				ul.cards-catalog__toc-list
					li: a(href='#feature-card') .ss-feature-card
					li: a(href='#task-card') .ss-task-card
					li: a(href='#solution-card') .ss-solution-card
					li: a(href='#experience-card') .ss-experience-card
					li: a(href='#stage-card') .ss-stage-card
					li: a(href='#role-card') .ss-role-card
					li: a(href='#benefit-card') .ss-benefit-card

			//- ========== Feature card ==========
			section.cards-catalog__section#feature-card
				h3.cards-catalog__section-title .ss-feature-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Универсальная карточка «иконка + заголовок + описание». Для этапов, преимуществ, услуг. На
					code &lt; $md
					| иконка съезжает влево (в ряд).

				//- Раскладка: 4 в ряд (≥1024) / 2 (768–1023) / 1 (<768)
				h4.cards-catalog__subtitle 4 / 2 / 1 в ряд (.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1)
				.cards-catalog__demo.ss-bg-gray
					.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1
						each item in featureItems
							.ss-feature-card
								+svgIcon(item.icon)
								.ss-feature-card__body
									p.ss-feature-card__title= item.title
									p.ss-feature-card__text= item.text

				//- Одиночная карточка (для наглядности)
				h4.cards-catalog__subtitle Одиночная (для сравнения desktop/mobile — сузь окно)
				.cards-catalog__demo.ss-bg-gray
					.ss-feature-card(style="max-width:280px;")
						+svgIcon('target')
						.ss-feature-card__body
							p.ss-feature-card__title Аудит и диагностика
							p.ss-feature-card__text Анализируем систему, выявляем потери и точки роста эффективности

				//- Сниппет
				pre.cards-catalog__snippet
					code
						| .ss-feature-card
						|     +svgIcon('target')
						|     .ss-feature-card__body
						|         p.ss-feature-card__title Заголовок
						|         p.ss-feature-card__text Описание

			//- ========== Task card ==========
			- var taskItems = [{ img: 'task-icon1', title: 'Потери конденсата', text: 'Организуем возврат конденсата до 90%, снижаем нагрузку на химводоподготовку и расход воды', link: 'Станция возврата конденсата' }, { img: 'task-icon2', title: 'Нестабильное давление и температура', text: 'Обеспечиваем стабильные параметры пара для технологических процессов — исключаем брак и аварии', link: 'РОУ / БРОУ' }, { img: 'task-icon3', title: 'Неравномерный нагрев теплообменников', text: 'Выравниваем температуру по поверхности нагрева — точная теплопередача без перегретых зон', link: 'Обвязка калориферов и ТО' }, { img: 'task-icon4', title: 'Высокие эксплуатационные затраты', text: 'Рассчитываем экономию пара, воды и энергии — КП с инженерным расчётом за 4 часа', link: 'Калькуляторы экономии' }]

			section.cards-catalog__section#task-card
				h3.cards-catalog__section-title .ss-task-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка задачи с картинкой сверху и ссылкой прижатой к низу. Высота фиксирована — 534 desktop / 440 mobile.
					| Картинка через
					code &lt;picture&gt;
					| с
					code srcset
					| 1x/2x для retina. Ссылка —
					code +ssLink(text, {variant: 'light'})
					| .

				h4.cards-catalog__subtitle 4 в ряд (.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1)
				.cards-catalog__demo.ss-bg-gray
					.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1
						each item in taskItems
							.ss-task-card
								picture.ss-task-card__image
									source(srcset='/img/' + item.img + '.webp 1x, /img/' + item.img + '@2x.webp 2x')
									img(src='/img/' + item.img + '.webp' alt=item.title)
								.ss-task-card__body
									p.ss-task-card__title= item.title
									p.ss-task-card__text= item.text
								.ss-task-card__footer
									+ssLink(item.link, { variant: 'light' })

				pre.cards-catalog__snippet
					code
						| .ss-task-card
						|     picture.ss-task-card__image
						|         source(srcset='/img/name.webp 1x, /img/name@2x.webp 2x')
						|         img(src='/img/name.webp' alt='...')
						|     .ss-task-card__body
						|         p.ss-task-card__title Заголовок
						|         p.ss-task-card__text Описание
						|     .ss-task-card__footer
						|         +ssLink('Ссылка', { variant: 'light' })

			//- ========== Solution card ==========
			section.cards-catalog__section#solution-card
				h3.cards-catalog__section-title .ss-solution-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка «Готового решения»: фон-картинка внутри карточки (
					code &lt;picture&gt;
					| — своя для каждой карточки) + два градиента поверх, по hover картинка/градиенты плавно исчезают. Вся карточка кликабельна (через
					code __overlay
					| ), кнопка «Получить расчёт» кликается отдельно.

				h4.cards-catalog__subtitle Одиночная карточка (наведи мышь — фон меняется)
				.cards-catalog__demo.ss-bg-gray
					article.ss-solution-card
						picture.ss-solution-card__bg
							source(media='(max-width: 767px)' srcset='/img/solution1-mob.webp 1x, /img/solution1-mob@2x.webp 2x')
							source(media='(min-width: 768px)' srcset='/img/solution1.webp 1x, /img/solution1@2x.webp 2x')
							img(src='/img/solution1.webp' width='865' height='320' alt='')
						a.ss-solution-card__overlay(href='#solution-page' aria-label='Готовое решение — Станция возврата конденсата')
						.ss-solution-card__content
							.ss-solution-card__head
								h3.ss-solution-card__title Станция возврата конденсата (СВК)
								p.ss-solution-card__text Организуем возврат конденсата в котельную. Снижение расхода воды и химреагентов, экономия до 90% тепловой энергии конденсата.
							.ss-tag-group
								span.ss-tag до 90% возврата
								span.ss-tag Авт. управление
							.ss-solution-card__footer
								+ssBtn('Получить расчёт', { variant: 'primary', size: 'mini', tag: 'a', href: '#calc-page' })
								span.ss-icon-btn(aria-hidden='true')
									+svgIcon('arrow-up-right')

				pre.cards-catalog__snippet
					code
						| article.ss-solution-card
						|     picture.ss-solution-card__bg
						|         source(media='(max-width: 767px)' srcset='/img/sol1-mob.webp 1x, /img/sol1-mob@2x.webp 2x')
						|         source(media='(min-width: 768px)' srcset='/img/sol1.webp 1x, /img/sol1@2x.webp 2x')
						|         img(src='/img/sol1.webp' width='865' height='320' alt='')
						|     a.ss-solution-card__overlay(href='/solutions/svk' aria-label='…')
						|     .ss-solution-card__content
						|         .ss-solution-card__head
						|             h3.ss-solution-card__title Заголовок
						|             p.ss-solution-card__text Описание
						|         .ss-tag-group
						|             span.ss-tag Тег 1
						|         .ss-solution-card__footer
						|             +ssBtn('Получить расчёт', { variant: 'primary', size: 'mini', tag: 'a', href: '/calc' })
						|             span.ss-icon-btn(aria-hidden='true')
						|                 +svgIcon('arrow-up-right')

			//- ========== Experience card ==========
			section.cards-catalog__section#experience-card
				h3.cards-catalog__section-title .ss-experience-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка отраслевого опыта: фон-картинка (
					code &lt;picture&gt;
					| — своя для каждой карточки) с градиентом снизу, сверху справа декоративный CTA (текст «Смотреть решение» скрыт, появляется на hover), снизу — заголовок отрасли + список особенностей (реюзаем
					code .ss-list
					| ). Вся карточка — одна ссылка.

				h4.cards-catalog__subtitle Одиночная карточка (наведи мышь — плашка «выедет» с текстом)
				.cards-catalog__demo.ss-bg-gray
					article.ss-experience-card(style="max-width: 400px;")
						picture.ss-experience-card__bg
							source(media='(max-width: 767px)' srcset='/img/gallery1-mob.webp 1x, /img/gallery1-mob@2x.webp 2x')
							source(media='(min-width: 768px)' srcset='/img/gallery1.webp 1x, /img/gallery1@2x.webp 2x')
							img(src='/img/gallery1.webp' alt='')
						a.ss-experience-card__overlay(href='#experience-page' aria-label='Пищевая промышленность — опыт')
						.ss-experience-card__content
							.ss-experience-card__top
								span.ss-experience-card__cta(aria-hidden='true')
									span.ss-experience-card__cta-text Смотреть решение
									+svgIcon('arrow-up-right')
							.ss-experience-card__body
								h3.ss-experience-card__title Пищевая промышленность
								ul.ss-list
									li.ss-list__item Стабильность температуры и давления
									li.ss-list__item Точное регулирование параметров пара
									li.ss-list__item Гарантированная производительность
									li.ss-list__item Соответствие ГОСТ

				pre.cards-catalog__snippet
					code
						| article.ss-experience-card
						|     picture.ss-experience-card__bg
						|         source(media='(max-width: 767px)' srcset='/img/exp2-mob.webp 1x, /img/exp2-mob@2x.webp 2x')
						|         source(media='(min-width: 768px)' srcset='/img/exp2.webp 1x, /img/exp2@2x.webp 2x')
						|         img(src='/img/exp2.webp' alt='')
						|     a.ss-experience-card__overlay(href='/experience/food' aria-label='…')
						|     .ss-experience-card__content
						|         .ss-experience-card__top
						|             span.ss-experience-card__cta(aria-hidden='true')
						|                 span.ss-experience-card__cta-text Смотреть решение
						|                 +svgIcon('arrow-up-right')
						|         .ss-experience-card__body
						|             h3.ss-experience-card__title Отрасль
						|             ul.ss-list
						|                 li.ss-list__item Пункт 1
						|                 li.ss-list__item Пункт 2

			//- ========== Stage card ==========
			- var stageItems = [{ n: 1, icon: 'chart', title: 'Анализ и аудит', text: 'Проводим обследование системы и выявляем проблемы', tags: ['Отчет', 'Список проблем', 'Рекомендации'] }, { n: 2, icon: 'sliders', title: 'Проектирование', text: 'Разрабатываем схему под параметры объекта', tags: ['Схема', 'Спецификация', 'Расчёт'] }, { n: 3, icon: 'cog', title: 'Подбор оборудования', text: 'Подбираем оборудование и готовим спецификацию поставки', tags: ['КП', 'Сроки', 'Документы'] }, { n: 4, icon: 'tool', title: 'Монтаж', text: 'Выполняем монтаж и обвязку по исполнительной документации', tags: ['Акты', 'Исполнительная'] }, { n: 5, icon: 'cable', title: 'Пусконаладка', text: 'Настраиваем и тестируем систему для стабильной работы', tags: ['Протокол', 'Паспорт'] }, { n: 6, icon: 'headset', title: 'Сервис 24/7', text: 'Поддержка и обслуживание на всём жизненном цикле', tags: ['SLA', 'Аварийный выезд'] }]

			section.cards-catalog__section#stage-card
				h3.cards-catalog__section-title .ss-stage-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка этапа работы: белая, без рамки, radius 10. Колонки и отступы между ними разводит родительский
					code .ss-grid
					| . Индикатор справа — сетка 3×2 из шести кубиков: синий тот, чей порядковый номер равен номеру этапа, так что номер и индикатор задаются одним значением
					code n
					| .

				h4.cards-catalog__subtitle 3 / 2 / 1 в ряд (.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1)
				.cards-catalog__demo.ss-bg-primary
					.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1
						each item in stageItems
							article.ss-stage-card
								.ss-stage-card__head
									.ss-stage-card__stage
										span.ss-stage-card__num= ('0' + item.n).slice(-2)
										span.ss-stage-card__icon
											+svgIcon(item.icon)
									.ss-stage-card__steps(role='img' aria-label='Этап ' + item.n + ' из 6')
										each s in [1, 2, 3, 4, 5, 6]
											span(class=s === item.n ? 'ss-stage-card__step ss-stage-card__step--active' : 'ss-stage-card__step')
								.ss-stage-card__body
									h3.ss-stage-card__title= item.title
									p.ss-stage-card__text= item.text
								.ss-stage-card__result
									span.ss-stage-card__result-label Клиент получает
									.ss-tag-group
										each tag in item.tags
											span.ss-tag.ss-tag--dark= tag

				pre.cards-catalog__snippet
					code
						| article.ss-stage-card
						|     .ss-stage-card__head
						|         .ss-stage-card__stage
						|             span.ss-stage-card__num 01
						|             span.ss-stage-card__icon
						|                 +svgIcon('chart')
						|         .ss-stage-card__steps(role='img' aria-label='Этап 1 из 6')
						|             span.ss-stage-card__step.ss-stage-card__step--active
						|             span.ss-stage-card__step
						|             ... всего шесть
						|     .ss-stage-card__body
						|         h3.ss-stage-card__title Заголовок этапа
						|         p.ss-stage-card__text Описание
						|     .ss-stage-card__result
						|         span.ss-stage-card__result-label Клиент получает
						|         .ss-tag-group
						|             span.ss-tag.ss-tag--dark Отчет

			//- ========== Role card ==========
			section.cards-catalog__section#role-card
				h3.cards-catalog__section-title .ss-role-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Одна карточка-роль (для справки по стилям). Полная секция «Клиентам» с 5 карточками, drag-скроллом и линией через
					code border-top
					| смотри на
					a(href='home-roles.html') /ui/home-roles.html
					| .

				h4.cards-catalog__subtitle Одиночная карточка
				.cards-catalog__demo
					.ss-role-card(style="max-width: 356px;")
						.ss-role-card__badge
							+svgIcon('user')
						p.ss-role-card__title Главному инженеру
						.ss-role-card__box
							.ss-role-card__body
								ul.ss-list
									li.ss-list__item Готовые технические решения
									li.ss-list__item Повышение надёжности
									li.ss-list__item Снижение затрат
								+ssLink('Смотреть готовые системы', { size: 'md' })

				pre.cards-catalog__snippet
					code
						| .ss-role-card-group
						|     .ss-role-card
						|         .ss-role-card__badge
						|             +svgIcon('user')
						|         p.ss-role-card__title Главному инженеру
						|         .ss-role-card__box
						|             .ss-role-card__body
						|                 ul.ss-list
						|                     li.ss-list__item Готовые технические решения
						|                     li.ss-list__item Повышение надёжности
						|                 +ssLink('Смотреть готовые системы', { size: 'md' })
						|     //- ... ещё 4 карточки .ss-role-card

			//- ========== Benefit card ==========
			section.cards-catalog__section#benefit-card
				h3.cards-catalog__section-title .ss-benefit-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка секции «Преимущества». Base = белая (border + primary/secondary текст). Модификатор
					code .ss-benefit-card--stat
					| — синяя со статистикой: градиент, крупный заголовок-число (62 desktop / 32 mobile), белый текст.
					| Полная секция с 8 карточками — на
					a(href='home-benefits.html') /ui/home-benefits.html
					| .

				h4.cards-catalog__subtitle Пара карточек — белая и синяя (2 в ряд .ss-grid.ss-grid--row-2)
				.cards-catalog__demo.ss-bg-gray
					.ss-grid.ss-grid--row-2
						.ss-benefit-card
							p.ss-benefit-card__title Собственный инжиниринг — единая ответственность
							p.ss-benefit-card__text Проектирование, монтаж и пусконаладка собственными силами. Один договор, один ответственный за результат.
						.ss-benefit-card.ss-benefit-card--stat
							p.ss-benefit-card__title 7 000+
							p.ss-benefit-card__text предприятий-клиентов: пищевая, фарма, химия, энергетика

				pre.cards-catalog__snippet
					code
						| //- Белая
						| .ss-benefit-card
						|     p.ss-benefit-card__title Собственный инжиниринг — единая ответственность
						|     p.ss-benefit-card__text Проектирование, монтаж и пусконаладка...
						| //- Синяя со статистикой
						| .ss-benefit-card.ss-benefit-card--stat
						|     p.ss-benefit-card__title 7 000+
						|     p.ss-benefit-card__text предприятий-клиентов: пищевая, фарма...
