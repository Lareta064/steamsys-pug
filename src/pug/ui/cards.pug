extends ../layouts/layout-ui.pug

block content
	//- Данные для feature-card demo
	- var featureItems = [{ icon: 'target', title: 'Аудит и диагностика', text: 'Анализируем систему, выявляем потери и точки роста эффективности' }, { icon: 'doc', title: 'Проектирование', text: 'Проектируем надёжные системы под задачи вашего производства' }, { icon: 'tool', title: 'Внедрение', text: 'Поставляем оборудование, выполняем монтаж и пусконаладочные работы' }, { icon: 'headset', title: 'Сервис и поддержка', text: 'Обслуживаем системы и обеспечиваем стабильную работу 24/7' }]

	.container-dashboard.ss-wrapper
		h2.db-h2 Cards

		.container-dashboard__content

			p.cards-catalog__intro.ss-reg-14.ss-txt-secondary
				| Компоненты-карточки редизайна. Раскладку N в ряд решает родительский
				code .ss-grid
				| .

			//- ========== Оглавление ==========
			nav.cards-catalog__toc
				h3.cards-catalog__toc-title Оглавление
				ul.cards-catalog__toc-list
					li: a(href='#feature-card') .ss-feature-card
					li: a(href='#task-card') .ss-task-card
					li: a(href='#category-card') .ss-category-card
					li: a(href='#product-card') .ss-product-card
					li: a(href='#info-card') .ss-info-card
					li: a(href='#expert-card') .ss-expert-card
					li: a(href='#solution-card') .ss-solution-card
					li: a(href='#experience-card') .ss-experience-card
					li: a(href='#stage-card') .ss-stage-card
					li: a(href='#role-card') .ss-role-card
					li: a(href='#benefit-card') .ss-benefit-card
					li: a(href='#profit') .ss-profit
					li: a(href='#metrics') .ss-metrics

			//- ========== Feature card ==========
			section.cards-catalog__section#feature-card
				h3.cards-catalog__section-title .ss-feature-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Универсальная карточка «иконка + заголовок + описание». Для этапов, преимуществ, услуг. На
					code &lt; $md
					| иконка съезжает влево (в ряд).

				//- Раскладка: 4 в ряд (≥1024) / 2 (768–1023) / 1 (<768)
				h4.cards-catalog__subtitle 4 / 2 / 1 в ряд (.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1)
				.cards-catalog__demo.ss-bg-gray
					.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1
						each item in featureItems
							.ss-feature-card
								+svgIcon(item.icon)
								.ss-feature-card__body
									p.ss-feature-card__title= item.title
									p.ss-feature-card__text= item.text

				//- Одиночная карточка (для наглядности)
				h4.cards-catalog__subtitle Одиночная (для сравнения desktop/mobile — сузь окно)
				.cards-catalog__demo.ss-bg-gray
					.ss-feature-card(style="max-width:280px;")
						+svgIcon('target')
						.ss-feature-card__body
							p.ss-feature-card__title Аудит и диагностика
							p.ss-feature-card__text Анализируем систему, выявляем потери и точки роста эффективности

				//- Сниппет
				pre.cards-catalog__snippet
					code
						| .ss-feature-card
						|     +svgIcon('target')
						|     .ss-feature-card__body
						|         p.ss-feature-card__title Заголовок
						|         p.ss-feature-card__text Описание

			//- ========== Task card ==========
			- var taskItems = [{ img: 'task-icon1', w: 210, h: 133, title: 'Потери конденсата', text: 'Организуем возврат конденсата до 90%, снижаем нагрузку на химводоподготовку и расход воды', link: 'Станция возврата конденсата' }, { img: 'task-icon2', w: 250, h: 125, title: 'Нестабильное давление и температура', text: 'Обеспечиваем стабильные параметры пара для технологических процессов — исключаем брак и аварии', link: 'РОУ / БРОУ' }, { img: 'task-icon3', w: 244, h: 135, title: 'Неравномерный нагрев теплообменников', text: 'Выравниваем температуру по поверхности нагрева — точная теплопередача без перегретых зон', link: 'Обвязка калориферов и ТО' }, { img: 'task-icon4', w: 136, h: 127, title: 'Высокие эксплуатационные затраты', text: 'Рассчитываем экономию пара, воды и энергии — КП с инженерным расчётом за 4 часа', link: 'Калькуляторы экономии' }]

			section.cards-catalog__section#task-card
				h3.cards-catalog__section-title .ss-task-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка задачи с картинкой сверху и ссылкой прижатой к низу. Высота фиксирована — 534 desktop / 440 mobile.
					| Картинка через
					code &lt;picture&gt;
					| с
					code srcset
					| 1x/2x для retina. Ссылка —
					code +ssLink(text, {variant: 'light'})
					| .

				h4.cards-catalog__subtitle 4 в ряд (.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1)
				.cards-catalog__demo.ss-bg-gray
					.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1
						each item in taskItems
							.ss-task-card
								picture.ss-task-card__image
									source(srcset=`${basePath}img/${item.img}.webp 1x, ${basePath}img/${item.img}@2x.webp 2x`)
									img(src=`${basePath}img/${item.img}.webp` width=item.w height=item.h alt=item.title, loading='lazy', decoding='async')
								.ss-task-card__body
									p.ss-task-card__title= item.title
									p.ss-task-card__text= item.text
									+ssLink(item.link, { variant: 'light' })(class='ss-task-card__link')

				pre.cards-catalog__snippet
					code
						| .ss-task-card
						|     picture.ss-task-card__image
						|         source(srcset='/img/name.webp 1x, /img/name@2x.webp 2x')
						|         img(src='/img/name.webp' width='250' height='125' alt='...', loading='lazy', decoding='async')
						|     .ss-task-card__body
						|         p.ss-task-card__title Заголовок
						|         p.ss-task-card__text Описание
						|         +ssLink('Ссылка', { variant: 'light' })(class='ss-task-card__link')

			//- ========== Category card ==========
			- var categoryItems = [{ img: 'tool1', title: 'Со свободноплавающим поплавком', desc: 'Непрерывный отвод конденсата без потерь пара.' }, { img: 'tool2', title: 'Поплавковые для больших расходов', desc: 'Для теплообменников и установок с высокой нагрузкой.' }, { img: 'tool3', title: 'Термодинамические', desc: 'Компактные решения для паропроводов.' }, { img: 'tool1', title: 'Термостатические', desc: 'Для отвода воздуха и переохлаждённого конденсата.' }]

			section.cards-catalog__section#category-card
				h3.cards-catalog__section-title .ss-category-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка категории каталога: фото продукта сверху (
					code &lt;picture&gt;
					| + 1x/2x srcset, mob-варианта нет — на всех экранах карточка примерно одной ширины, фикс. пропорция 235/210,
					code object-fit: contain
					| ), заголовок + описание, скрытая ссылка «Перейти в раздел» проявляется на hover карточки и всегда прижата к низу (
					code margin-top: auto
					| ). Border меняется на accent1 при наведении. У текстовых элементов только UI-классы (
					code .ss-semi-22
					| /
					code .ss-reg-14
					| /
					code .ss-txt-*
					| ) — заголовку с узким fluid-размером 18↔22 и авто-переносами по русскому словарю доводка задана через
					code .ss-category-card .ss-semi-22
					| .

				h4.cards-catalog__subtitle 4 в ряд (.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1)
				.cards-catalog__demo.ss-bg-gray
					.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1
						each item in categoryItems
							a.ss-category-card(href='#')
								picture.ss-category-card__img
									source(srcset=`${basePath}img/${item.img}.webp 1x, ${basePath}img/${item.img}@2x.webp 2x`)
									img.ss-img-contain(src=`${basePath}img/${item.img}.webp` width='235' height='210' alt=item.title loading='lazy' decoding='async')
								.ss-category-card__body
									p.ss-semi-22.ss-txt-primary= item.title
									p.ss-reg-14.ss-txt-secondary= item.desc
									span.ss-category-card__more.ss-medi-18
										| Перейти в раздел
										+svgIcon('arrow-right')

				h4.cards-catalog__subtitle Одиночная (для сравнения desktop/mobile)
				.cards-catalog__demo.ss-bg-gray
					a.ss-category-card(href='#')
						picture.ss-category-card__img
							source(srcset=`${basePath}img/tool3.webp 1x, ${basePath}img/tool3@2x.webp 2x`)
							img.ss-img-contain(src=`${basePath}img/tool3.webp` width='235' height='210' alt='Термодинамические' loading='lazy' decoding='async')
						.ss-category-card__body
							p.ss-semi-22.ss-txt-primary Термодинамические
							p.ss-reg-14.ss-txt-secondary Компактные решения для паропроводов.
							span.ss-category-card__more.ss-medi-18
								| Перейти в раздел
								+svgIcon('arrow-right')

				pre.cards-catalog__snippet
					code
						| a.ss-category-card(href='#')
						|     picture.ss-category-card__img
						|         source(srcset='/img/tool1.webp 1x, /img/tool1@2x.webp 2x')
						|         img.ss-img-contain(src='/img/tool1.webp' width='235' height='210' alt='...' loading='lazy' decoding='async')
						|     .ss-category-card__body
						|         p.ss-semi-22.ss-txt-primary Заголовок
						|         p.ss-reg-14.ss-txt-secondary Описание
						|         span.ss-category-card__more.ss-medi-18
						|             | Перейти в раздел
						|             +svgIcon('arrow-right')

			//- ========== Product card ==========
			- var productItems = [{ img: 'tool1', brand: 'TLV', type: 'Поплавковый', title: 'JX45', subtitle: 'Поплавковый конденсатоотводчик', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '25 бар' }, { k: 'Температура', v: 'до 220 °C' }], avail: 'Под заказ' }, { img: 'tool2', brand: 'Spirax', type: 'Термодинамич.', title: 'TD52L', subtitle: 'Термодинамический конденсатоотводчик', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '40 бар' }, { k: 'Температура', v: 'до 300 °C' }], avail: 'Под заказ' }, { img: 'tool3', brand: 'TLV', type: 'Термостатич.', title: 'L21S', subtitle: 'Термостатический конденсатоотводчик', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '16 бар' }, { k: 'Температура', v: 'до 250 °C' }], avail: 'Под заказ' }]

			section.cards-catalog__section#product-card
				h3.cards-catalog__section-title .ss-product-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка товара из отфильтрованного списка каталога. Внутри: фото (
					code height 160
					| ,
					code object-fit: contain
					| ), теги (reuse
					code .ss-tag--dark
					|  бренд +
					code .ss-tag--gray
					|  тип), заголовок-артикул, subtitle-название, dl-список характеристик (ключ слева / значение справа) и submit-кнопка (
					code .ss-btn--outline-dark.ss-btn--full
					| ). Кнопка прижата к низу через
					code margin-top: auto
					|  — в ряду карточки одной высоты, кнопки на одной линии.

				h4.cards-catalog__subtitle 3 в ряд (.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1)
				.cards-catalog__demo.ss-bg-gray
					.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1
						each item in productItems
							article.ss-product-card
								.ss-product-card__img
									img.ss-img-contain(src=`${basePath}img/${item.img}.webp` width='235' height='160' alt=item.title loading='lazy' decoding='async')
								.ss-tag-group
									span.ss-tag.ss-tag--dark= item.brand
									span.ss-tag.ss-tag--gray= item.type
								h3.ss-semi-20
									a(href='#')= item.title
								if item.subtitle
									p.ss-reg-14.ss-txt-secondary= item.subtitle
								dl.ss-product-card__specs
									each s in item.specs
										.ss-product-card__specs-row
											dt= s.k
											dd= s.v
								if item.avail
									p.ss-reg-14.ss-txt-secondary= item.avail
								+ssBtn('Запросить КП', { variant: 'dark', full: true })

				pre.cards-catalog__snippet
					code
						| article.ss-product-card
						|     .ss-product-card__img
						|         img.ss-img-contain(src='/img/name.webp' width='235' height='160' alt='...' loading='lazy' decoding='async')
						|     .ss-tag-group
						|         span.ss-tag.ss-tag--dark TLV
						|         span.ss-tag.ss-tag--gray Поплавковый
						|     h3.ss-semi-20
						|         a(href='/catalog/jx45') JX45
						|     p.ss-reg-14.ss-txt-secondary Поплавковый конденсатоотводчик
						|     dl.ss-product-card__specs
						|         .ss-product-card__specs-row
						|             dt DN
						|             dd 15–50
						|         .ss-product-card__specs-row
						|             dt PN
						|             dd 25 бар
						|         .ss-product-card__specs-row
						|             dt Температура
						|             dd до 220 °C
						|     p.ss-reg-14.ss-txt-secondary Под заказ
						|     +ssBtn('Запросить КП', { variant: 'dark', full: true })

			//- ========== Info card ==========
			- var infoItems = [{ title: 'Станции возврата конденсата (СВК)', desc: 'Поплавковые и насосные КО обеспечивают непрерывный дренаж конденсата из сборного бака в систему возврата.', linkText: 'Подробнее о СВК' }, { title: 'Обвязка паровых калориферов', desc: 'Термодинамические и поплавковые КО защищают калорифер от замерзания и обеспечивают полный дренаж при остановке.', linkText: 'Подробнее об обвязке' }, { title: 'Обвязка теплообменников', desc: 'Поплавковые КО с непрерывным дренажем — основной вид для кожухотрубных и пластинчатых ТО.', linkText: 'Подробнее' }]

			section.cards-catalog__section#info-card
				h3.cards-catalog__section-title .ss-info-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Универсальная простая карточка «заголовок + описание + ссылка». Без картинки, без иконки, без тегов. Пригодна под «в каких системах используются», «задачи», «отрасли» и т.п. — любые списки блоков title/text/link. Ссылка (
					code +ssLink
					| ) прижата к низу через
					code margin-top: auto
					|  — в ряду карточки на одной линии независимо от длины описания.

				h4.cards-catalog__subtitle 3 в ряд (.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1)
				.cards-catalog__demo.ss-bg-gray
					.ss-grid.ss-grid--row-3.ss-grid--lg-row-2.ss-grid--md-row-1
						each item in infoItems
							article.ss-info-card
								h3.ss-semi-18= item.title
								p.ss-reg-14.ss-txt-secondary= item.desc
								+ssLink(item.linkText, { size: 'md' })

				h4.cards-catalog__subtitle Модификатор --upper (uppercase-заголовок, .ss-semi-14)
				.cards-catalog__demo.ss-bg-gray
					.ss-grid.ss-grid--row-4.ss-grid--lg-row-2.ss-grid--md-row-1
						article.ss-info-card.ss-info-card--upper
							h3.ss-semi-14 Паспорта
							p.ss-reg-14.ss-txt-secondary Паспорта на оборудование TLV, Spirax Sarco, Yoshitake.
							+ssLink('Запросить', { size: 'md' })
						article.ss-info-card.ss-info-card--upper
							h3.ss-semi-14 Сертификаты
							p.ss-reg-14.ss-txt-secondary Сертификаты соответствия, декларации ТР ЕАЭС.
							+ssLink('Запросить', { size: 'md' })
						article.ss-info-card.ss-info-card--upper
							h3.ss-semi-14 Таблицы подбора
							p.ss-reg-14.ss-txt-secondary Подбор по давлению, расходу. Таблицы TLV и Spirax Sarco.
							+ssLink('Скачать', { size: 'md' })
						article.ss-info-card.ss-info-card--upper
							h3.ss-semi-14 Опросный лист
							p.ss-reg-14.ss-txt-secondary Форма для подбора: тип системы, давление, расход.
							+ssLink('Заполнить онлайн', { size: 'md' })

				pre.cards-catalog__snippet
					code
						| //- Базовый вариант
						| article.ss-info-card
						|     h3.ss-semi-18 Заголовок
						|     p.ss-reg-14.ss-txt-secondary Описание
						|     +ssLink('Подробнее о …', { size: 'md' })
						|
						| //- --upper — uppercase-заголовок под секции типа «Документы»
						| article.ss-info-card.ss-info-card--upper
						|     h3.ss-semi-14 Паспорта
						|     p.ss-reg-14.ss-txt-secondary Описание
						|     +ssLink('Запросить', { size: 'md' })

			//- ========== Expert card ==========
			section.cards-catalog__section#expert-card
				h3.cards-catalog__section-title .ss-expert-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка эксперта раздела: kicker + аватар + имя/должность + био + ссылка на профиль. Ставится в правой колонке секции «О разделе» (или «О нас» / «Ведущий направления»). Аватар — 80×80 круг, без img рисуется серый плейсхолдер. Имя+должность связаны в
					code __name-group
					|  (gap 4), остальные блоки — gap 20 из родителя.

				h4.cards-catalog__subtitle Одиночная карточка (сузь окно &lt; 1200 — увидишь, как ужимается padding до 20)
				.cards-catalog__demo.ss-bg-gray
					article.ss-expert-card(style='max-width: 320px;')
						span.ss-kicker.ss-txt-secondary Эксперт раздела
						.ss-expert-card__avatar
						.ss-expert-card__name-group
							h3.ss-semi-18 Павел Гилепп
							p.ss-reg-14.ss-txt-secondary Технический директор
						p.ss-reg-14.ss-txt-secondary 20+ лет в пароконденсатных системах. Подбирает оборудование по параметрам заказчика.
						+ssLink('Профиль специалиста', { variant: 'dark', size: 'md', underline: true })

				pre.cards-catalog__snippet
					code
						| article.ss-expert-card
						|     span.ss-kicker.ss-txt-secondary Эксперт раздела
						|     .ss-expert-card__avatar
						|         img(src='/img/expert.webp' width='80' height='80' alt='Павел Гилепп' loading='lazy' decoding='async')
						|     .ss-expert-card__name-group
						|         h3.ss-semi-18 Павел Гилепп
						|         p.ss-reg-14.ss-txt-secondary Технический директор
						|     p.ss-reg-14.ss-txt-secondary Био — 2-3 строки.
						|     +ssLink('Профиль специалиста', { variant: 'dark', size: 'md', underline: true })

			//- ========== Solution card ==========
			section.cards-catalog__section#solution-card
				h3.cards-catalog__section-title .ss-solution-card
				p.cards-catalog__hint.ss-reg-14.ss-txt-secondary
					| Карточка «Готового решения»: фон-картинка внутри карточки (
					code &lt;picture&gt;
					| — своя для каждой карточки) + два градиента поверх, по hover картинка/градиенты плавно исчезают. Вся карточка кликабельна (через
					code __overlay
					| ), кнопка «Получить расчёт» кликается отдельно.

				h4.cards-catalog__subtitle Одиночная карточка (наведи мышь — фон меняется)
				.cards-catalog__demo.ss-bg-gray
					article.ss-solution-card
						picture.ss-solution-card__bg
							source(media='(max-width: 767px)' srcset=`${basePath}img/solution1-mob.webp 1x, ${basePath}img/solution1-mob@2x.webp 2x`)
