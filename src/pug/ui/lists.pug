extends ../layouts/layout-ui.pug

block content
	//- Данные для примеров
	- var bulletItems = ['Стабильность температуры и давления', 'Меньше брака от нестабильных режимов', 'Точность регулирования в процессе']
	- var iconItems = ['Опросные листы', 'Типовые схемы', 'Паспорта и сертификаты', 'CAD / 3D / BIM-модели', 'Каталоги и инструкции']

	.container-dashboard.ss-wrapper
		h2.db-h2 Lists

		.container-dashboard__content

			p.lists-catalog__intro.ss-reg-14.ss-txt-secondary
				| Стили — в
				code src/scss/base/_list.scss
				| . Точка через
				code ::before
				|  + абсолютное позиционирование — многострочный текст не уходит под точку.

			//- ========== Оглавление ==========
			nav.lists-catalog__toc
				h3.lists-catalog__toc-title Оглавление
				ul.lists-catalog__toc-list
					li: a(href='#bullet') .ss-list (bullet)
					li: a(href='#icon') .ss-list--icon
					li: a(href='#step') .ss-list--step

			//- ========== Bullet list ==========
			section.lists-catalog__section#bullet
				h3.lists-catalog__section-title .ss-list (bullet)
				p.lists-catalog__hint.ss-reg-14.ss-txt-secondary Простой список с точкой. Цвет наследуется от контекста, точка = currentColor.

				h4.lists-catalog__subtitle На светлом фоне
				.lists-catalog__demo.ss-bg-gray
					ul.ss-list
						each item in bulletItems
							li.ss-list__item= item

				h4.lists-catalog__subtitle На тёмном фоне (.ss-bg-primary + .ss-txt-white)
				.lists-catalog__demo.ss-bg-primary
					ul.ss-list.ss-txt-white
						each item in bulletItems
							li.ss-list__item= item

				pre.lists-catalog__snippet
					code
						| ul.ss-list
						|     li.ss-list__item Пункт списка
						|     li.ss-list__item Ещё пункт

			//- ========== Icon list ==========
			section.lists-catalog__section#icon
				h3.lists-catalog__section-title .ss-list--icon
				p.lists-catalog__hint.ss-reg-14.ss-txt-secondary
					| Список с badge-маркером (иконка в тёмном скруглённом квадратике). Маркер — обёртка
					code .ss-list__marker
					| с иконкой внутри через
					code +svgIcon('check')
					| .

				h4.lists-catalog__subtitle С галочкой (svg-check)
				.lists-catalog__demo.ss-bg-gray
					ul.ss-list.ss-list--icon
						each item in iconItems
							li.ss-list__item
								span.ss-list__marker
									+svgIcon('check')
								span= item

				pre.lists-catalog__snippet
					code
						| ul.ss-list.ss-list--icon
						|     li.ss-list__item
						|         span.ss-list__marker
						|             +svgIcon('check')
						|         span Текст пункта

			//- ========== Step list ==========
			section.lists-catalog__section#step
				h3.lists-catalog__section-title .ss-list--step
				p.lists-catalog__hint.ss-reg-14.ss-txt-secondary
					| Список «шагов» (title + text в item'е). Строится поверх
					code .ss-list--icon
					| : в маркере — цифра или иконка, справа —
					code .ss-list__step
					| с заголовком и описанием.
					br
					| Размеры title/text задаём типографика-утилитами на самих
					code &lt;p&gt;
					| (например
					code .ss-semi-18
					|  и
					code .ss-reg-14.ss-txt-secondary
					| ) — компонент не хардкодит шрифты.

				//- Шаги с цифрами в маркере
				h4.lists-catalog__subtitle С цифрой в маркере
				.lists-catalog__demo.ss-bg-gray
					- var stepItemsDigits = [{ title: 'Параметры системы', text: 'Давление и температура пара, расход, тип потребителя, условия монтажа.' }, { title: 'Расчёт инженером', text: 'Выбор типа системы, подбор оборудования, расчёт производительности — в течение 1 рабочего дня.' }, { title: 'Комплект документов', text: 'Техническое задание, принципиальная схема, спецификация оборудования, КП.' }]
					ul.ss-list.ss-list--icon.ss-list--step
						each step, i in stepItemsDigits
							li.ss-list__item
								span.ss-list__marker= i + 1
								.ss-list__step
									p.ss-semi-18= step.title
									p.ss-reg-14.ss-txt-secondary= step.text

				//- Шаги с svg-иконкой в маркере
				h4.lists-catalog__subtitle С svg-иконкой в маркере
				.lists-catalog__demo.ss-bg-gray
					- var stepItemsSvg = [{ icon: 'check', title: 'Опросный лист', text: 'Заполняется клиентом или инженером при звонке — за 5–10 минут.' }, { icon: 'check', title: 'Расчёт за 1 рабочий день', text: 'Инженер подбирает оборудование и готовит коммерческое предложение.' }, { icon: 'check', title: 'Поставка под ключ', text: 'Монтаж, пусконаладка, обучение персонала и гарантийная поддержка.' }]
					ul.ss-list.ss-list--icon.ss-list--step
						each step in stepItemsSvg
							li.ss-list__item
								span.ss-list__marker
									+svgIcon(step.icon)
								.ss-list__step
									p.ss-semi-18= step.title
									p.ss-reg-14.ss-txt-secondary= step.text

				pre.lists-catalog__snippet
					code
						| ul.ss-list.ss-list--icon.ss-list--step
						|     li.ss-list__item
						|         span.ss-list__marker 1
						|         .ss-list__step
						|             p.ss-semi-18 Заголовок шага
						|             p.ss-reg-14.ss-txt-secondary Описание
