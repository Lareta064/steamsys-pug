extends ../layouts/layout-ui.pug
include ../mixins/_svg-icons.pug

block content
	//- Каталог всех иконок из src/img/ss-sprite.svg.
	//- При добавлении новой иконки — дополни массив ниже.
	- var icons = [{ name: 'plus-circle', note: '28×28' }, { name: 'cross', note: '26×26' }]

	.container-dashboard
		h2.db-h2 SVG иконки
		.container-dashboard__content
			p.ss-reg-14.ss-txt-secondary(style="margin-bottom:24px;")
				| Иконки подключаются через миксин
				code(style="margin:0 4px;") +svgIcon('name')
				| из
				code(style="margin-left:4px;") src/pug/mixins/_svg-icons.pug

			ul.svg-icons-grid(style="list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:16px;")
				each icon in icons
					li(style="display:flex; flex-direction:column; align-items:stretch; border:1px solid #DEE2E4; border-radius:8px; overflow:hidden; background:#fff;")
						div(style="display:flex; align-items:center; justify-content:center; min-height:96px; background:#F8F9F9;")
							+svgIcon(icon.name)
						div(style="padding:12px 14px; display:flex; flex-direction:column; gap:6px;")
							code(style="font-size:13px; color:#031D2A;") .svg-#{icon.name}
							span.ss-reg-12.ss-txt-secondary= icon.note
							pre(style="margin:0; padding:8px 10px; background:#031D2A; color:#F8F9F9; border-radius:4px; font-size:12px; overflow:auto;")
								code +svgIcon('#{icon.name}')
