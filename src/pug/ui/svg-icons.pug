extends ../layouts/layout-ui.pug
include ../mixins/_svg-icons.pug

block content
	//- Каталог всех иконок из src/img/ss-sprite.svg.
	//- При добавлении новой иконки — дополни массив ниже.
	- var icons = [{ name: 'plus-circle', note: '28×28' }, { name: 'cross', note: '26×26' }]

	.container-dashboard
		h2.db-h2 SVG иконки
		.container-dashboard__content
			p.icons-catalog__intro.ss-reg-14.ss-txt-secondary
				| Иконки подключаются через миксин
				code +svgIcon('name')
				| из
				code src/pug/mixins/_svg-icons.pug

			ul.icons-catalog
				each icon in icons
					li.icons-catalog__item
						.icons-catalog__preview
							+svgIcon(icon.name)
						.icons-catalog__meta
							code.icons-catalog__name .svg-#{icon.name}
							span.icons-catalog__note.ss-reg-12.ss-txt-secondary= icon.note
							pre.icons-catalog__snippet
								code +svgIcon('#{icon.name}')
