extends ../layouts/layout-ui.pug

block variables
	-var title = "CTA-плашка (.ss-cta-card)";

block content
	.container-dashboard.ss-wrapper
		h2.db-h2 CTA-плашка (.ss-cta-card)

		.container-dashboard__content

			p.breadcrumbs-catalog__hint.ss-reg-14.ss-txt-secondary
				| Компактная плашка с заголовком, опциональным описанием и кнопкой. Используется в сайдбарах, футерах, любых боковых блоках — где нужен вызывающий действие. Стили —
				code src/scss/blocks/_cta-card.scss
				| .
				br
				| Не привязана к контексту. Секция кладёт её в свой
				code __element
				|  — как часть раскладки.

			//- ===== С описанием =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title С описанием
				p.breadcrumbs-catalog__hint.ss-reg-14.ss-txt-secondary
					| Типовой кейс — сайдбар «Базы знаний».

				.breadcrumbs-catalog__demo(style='max-width: 320px;')
					.ss-cta-card
						p.ss-cta-card__title Нужна консультация?
						p.ss-cta-card__text Инженер ответит на вопрос по статье или подберёт решение под задачу.
						+ssBtn('Задать вопрос инженеру', { variant: 'primary', full: true, tag: 'a', href: '#' })

				pre.breadcrumbs-catalog__snippet
					code
						| .ss-cta-card
						|     p.ss-cta-card__title Нужна консультация?
						|     p.ss-cta-card__text Инженер ответит на вопрос…
						|     +ssBtn('Задать вопрос инженеру', { variant: 'primary', full: true, tag: 'a', href: '#' })

			//- ===== Без описания =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Только заголовок + кнопка
				p.breadcrumbs-catalog__hint.ss-reg-14.ss-txt-secondary
					| Между
					code __title
					|  и кнопкой сохраняется отступ 20px через селектор
					code __title + .ss-btn
					| .

				.breadcrumbs-catalog__demo(style='max-width: 320px;')
					.ss-cta-card
						p.ss-cta-card__title Получить коммерческое предложение
						+ssBtn('Оставить заявку', { variant: 'primary', full: true, tag: 'a', href: '#' })

				pre.breadcrumbs-catalog__snippet
					code
						| .ss-cta-card
						|     p.ss-cta-card__title Получить коммерческое предложение
						|     +ssBtn('Оставить заявку', { variant: 'primary', full: true, tag: 'a', href: '#' })

			//- ===== Модификатор --promo =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Модификатор .ss-cta-card--promo (промо-плашка в полную ширину)
				p.breadcrumbs-catalog__hint.ss-reg-14.ss-txt-secondary
					| Светло-серый фон, горизонтальная раскладка 2 колонки: слева
					code .ss-cta-card__content
					|  (kicker + title + text), справа
					code .ss-cta-card__action
					|  (кнопка + footnote под ней). На &lt;768px стек в колонку, кнопка на всю ширину.
					br
					| Используется для секций «Нужна точность?» и подобных — крупный CTA под основным контентом.

				.breadcrumbs-catalog__demo
					.ss-cta-card.ss-cta-card--promo
						.ss-cta-card__content
							p.ss-cta-card__kicker Нужна точность?
							p.ss-cta-card__title Точный расчёт от инженера — за 24 часа, бесплатно
							p.ss-cta-card__text Калькуляторы дают оценку ±30%. Для обоснования перед руководством нужен точный расчёт с учётом реальных параметров вашей системы.
						.ss-cta-card__action
							+ssBtn('Получить точный расчёт', { variant: 'dark', tag: 'a', href: '#' })
							p.ss-cta-card__footnote Ответ в течение 24 часов

				pre.breadcrumbs-catalog__snippet
					code
						| .ss-cta-card.ss-cta-card--promo
						|     .ss-cta-card__content
						|         p.ss-cta-card__kicker Нужна точность?
						|         p.ss-cta-card__title Точный расчёт от инженера — за 24 часа
						|         p.ss-cta-card__text Калькуляторы дают оценку ±30%…
						|     .ss-cta-card__action
						|         +ssBtn('Получить точный расчёт', { variant: 'dark', tag: 'a', href: '#' })
						|         p.ss-cta-card__footnote Ответ в течение 24 часов

			//- ===== Модификатор --dark =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Модификатор .ss-cta-card--dark (тёмно-синяя плашка)
				p.breadcrumbs-catalog__hint.ss-reg-14.ss-txt-secondary
					| Инверсная тёмная плашка. Сочетается с
					code --promo
					|  (горизонтальная раскладка): фон
					code --primary1
					| , весь текст — белый. Используется для крупного CTA под основным контентом страницы (например, под кейсом: «Хотите такой же результат на вашем объекте?»).
					br
					| __title белый, __text осветлённый (--secondary2), __kicker --accent3 (светло-синий), __footnote --secondary2. В
					code .__action
					|  можно размещать несколько CTA — кнопку и текстовую ссылку, они стекаются по вертикали с центровкой.

				.breadcrumbs-catalog__demo
					.ss-cta-card.ss-cta-card--promo.ss-cta-card--dark
						.ss-cta-card__content
							p.ss-cta-card__title Хотите такой же результат на&nbsp;вашем объекте?
							p.ss-cta-card__text Проведём диагностику вашей паровой системы, подберём решение под параметры и&nbsp;рассчитаем экономический эффект.
						.ss-cta-card__action
							+ssBtn('Запросить похожее решение', { variant: 'primary', icon: 'arrow-right', tag: 'a', href: '#' })
							+ssLink('Получить консультацию инженера', { variant: 'white', size: 'md' })(href='#')

				pre.breadcrumbs-catalog__snippet
					code
						| .ss-cta-card.ss-cta-card--promo.ss-cta-card--dark
						|     .ss-cta-card__content
						|         p.ss-cta-card__title Хотите такой же результат на вашем объекте?
						|         p.ss-cta-card__text Проведём диагностику…
						|     .ss-cta-card__action
						|         +ssBtn('Запросить похожее решение', { variant: 'primary', icon: 'arrow-right', tag: 'a', href: '#' })
						|         +ssLink('Получить консультацию инженера', { variant: 'white', size: 'md' })(href='#')

			//- ===== Про элементы =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Про элементы
				ul
					li
						code .ss-cta-card
						|  — обёртка. Border
						code --secondary2
						| , радиус 10, паддинг 24, фон
						code --white
						| .
					li
						code .ss-cta-card__title
						|  — заголовок 16/700, цвет
						code --primary
						| .
					li
						code .ss-cta-card__text
						|  — описание 13/400,
						code line-height: 1.5
						| , цвет
						code --secondary
						| . Опционален.
					li
						strong Кнопка:
						|  обычная
						code .ss-btn
						|  через миксин
						code +ssBtn
						| . Для сайдбар-ширины удобнее с
						code full: true
						| .
