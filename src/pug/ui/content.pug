extends ../layouts/layout-ui.pug

block variables
	-var title = "Контент из админки (.ss-content)";

block content
	.container-dashboard.ss-wrapper
		h2.db-h2 Контент из админки (.ss-content)

		.container-dashboard__content

			p.breadcrumbs-catalog__hint.ss-reg-14.ss-txt-secondary
				| Обёртка для текстового контента, который приходит из редактора админки. Владелец сайта пишет разметку без классов —
				code h2
				| /
				code h3
				| /
				code p
				| /
				code ul
				| /
				code ol
				| /
				code strong
				| /
				code a
				| /
				code blockquote
				| /
				code hr
				|  — всё оформляется по тегу. Стили —
				code src/scss/blocks/_content.scss
				| .
				br
				| Прямые дети-компоненты (
				code .ss-callout
				| ,
				code .ss-fact-card
				| ,
				code figure
				|  и т.п.) получают одинаковый вертикальный воздух через селектор-исключение.

			//- ===== Демо: полный набор тегов =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Полный набор тегов + вложенные компоненты

				.breadcrumbs-catalog__demo
					.ss-content
						h2 Последствия замерзания
						p Замерзание конденсата в паровом калорифере — не разовая неприятность, а цепочка последствий, которые проявляются в течение недель и месяцев после первого события.
						ul
							li Разрушение оребрения и трубок теплообменника
							li Аварийная остановка вентиляционной установки
							li Затраты на ремонт или замену калорифера (от 100 тыс. руб.)
							li Риск замочки помещений и трубопроводов
						p Отдельно стоит риск для смежного оборудования — контроль возврата конденсата, паровая линия, дренажная разводка.

						h3 Типичные схемы обвязки
						p Ниже — короткое сравнение схем по типу конденсатоотводчика. Полная таблица идёт отдельным блоком.

						.ss-callout
							p.ss-callout__kicker Инженерное замечание
							.ss-callout__body
								p Если калорифер периодически «подмерзает», проблему нельзя решать только увеличением давления пара. Чаще всего причина находится в отводе конденсата: конденсат не уходит из нижней точки, а при остановке превращается в лёд.

						h3 Как предотвратить замерзание — чек-лист
						ol
							li Выбрать поплавковый конденсатоотводчик вместо термодинамического
							li Установить термостатический клапан защиты от замерзания
							li Предусмотреть дренаж конденсата при остановке системы
							li Проверить уклон труб в сторону КО
							li Использовать готовую обвязку с защитой от замерзания

						.ss-fact-card
							p.ss-fact-card__title Фрагмент расчёта для статьи
							.ss-fact-card__row
								.ss-fact-card__key Исходные данные
								.ss-fact-card__value Пар 6 бар, расход 280 кг/ч, температура наружного воздуха −25°C.
							.ss-fact-card__row
								.ss-fact-card__key Проверка КО
								.ss-fact-card__value Пропускная способность принимается с запасом к пусковой нагрузке.
							.ss-fact-card__row
								.ss-fact-card__key Вывод
								.ss-fact-card__value Для узла нужен поплавковый КО, автоматический воздухоотвод и отдельный дренаж при остановке.

						h4 Мелкий подзаголовок (h4)
						p Абзац с
						a(href='#') внутренней ссылкой
						|  и
						strong жирным текстом
						| , а также
						em курсивом
						| . Всё через голые теги, без классов.

						blockquote
							p Правильно спроектированная обвязка калорифера — это не «золотые компоненты», а согласованность параметров: давление пара, тип клапана защиты, диаметр труб и точка дренажа рассматриваются в системе.

						hr

						figure.ss-figure
							img(src=`${basePath}img/1.webp` width='474' height='842', alt='', loading='lazy', decoding='async')
							figcaption Подпись к фото — рекомендации по эксплуатации и обслуживанию.

						p Финальный абзац — последний ребёнок без нижнего margin.

			//- ===== Про элементы =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Про типографику
				ul
					li
						code h2
						|  — 700/1.3, fluid 28↔22, margin 40 0 20.
					li
						code h3
						|  — 700/1.3, fluid 22↔18, margin 30 0 15.
					li
						code h4
						|  — 700/1.3, fluid 18↔16, margin 25 0 10.
					li
						code p
						|  — 400/1.6, fluid 16↔14, margin 0 0 15.
					li
						code ul/ol
						|  — margin 0 0 15, padding-left 24. Маркеры disc/decimal.
					li
						code li
						|  — 400/1.6, fluid 16↔14, margin-bottom 10. Вложенные списки — margin-top 10.
					li
						code strong/b
						|  — 700.
						code em/i
						|  — italic.
					li
						code a
						|  — цвет
						code --accent1
						| , underline с offset 2. Hover:
						code --accent2
						| .
					li
						code blockquote
						|  — фон
						code --secondary3
						| , левый бордер 4px
						code --accent2
						| , радиус 4, паддинг 15 20. Ровно как
						code .ss-callout
						|  визуально, но семантика цитаты.
					li
						code hr
						|  — тонкая линия
						code --secondary2
						| , margin 30 0.
					li
						strong Компоненты внутри:
						|  прямой ребёнок, который НЕ h1..h6/p/ul/ol/blockquote/hr, получает
						code margin-block: 30px
						|  автоматически. Работает для
						code .ss-callout
						| ,
						code .ss-fact-card
						| ,
						code figure
						| ,
						code .ss-cta-row
						| ,
						code .ss-quote-card
						| ,
						code .ss-video-side
						| ,
						code .ss-gallery
						| ,
						code .ss-simple-table
						|  и любого нового.
					li
						strong Первый / последний ребёнок
						|  — сбрасываем верхний / нижний margin, чтобы не было лишнего воздуха на границах обёртки.
