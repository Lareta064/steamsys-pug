extends ../layouts/layout-ui-sections.pug

block content
	- var calcItems = ['Расчёт потерь пара', 'Расчёт возврата конденсата', 'Экономический эффект', 'Подбор РОУ / БРОУ']
	- var docItems = ['Опросные листы', 'Типовые схемы', 'Паспорта и сертификаты', 'CAD / 3D / BIM-модели', 'Каталоги и инструкции']

	section.ss-section.ss-section-calc-docs
		.ss-container.ss-wrapper
			.ss-grid
				//- Col 1 (3/12) — только kicker.
				.ss-col-3.ss-col-lg-12
					span.ss-kicker Калькуляторы и документация

				//- Col 2 (5/12) — калькуляторы: h2 + список ссылок-плашек + кнопка.
				.ss-col-5.ss-col-lg-12.ss-section-calc-docs__calc
					h2.ss-h2.ss-section-calc-docs__title Рассчитайте и&nbsp;оцените эффективность
					.ss-section-calc-docs__strips
						each item in calcItems
							+ssLink(item, { variant: 'strip', icon: 'calc' })
					+ssBtn('Все калькуляторы', { tag: 'a', href: '#calc' })

				//- Col 3 (4/12) — документы: h2 + коробка (список+картинка + 3 кнопки).
				.ss-col-4.ss-col-lg-12.ss-section-calc-docs__docs
					h2.ss-h2.ss-section-calc-docs__title Документы для инженеров
					.ss-section-calc-docs__docs-box
						.ss-section-calc-docs__docs-body
							ul.ss-list.ss-list--icon.ss-section-calc-docs__docs-list
								each doc in docItems
									li.ss-list__item
										span.ss-list__marker
											+svgIcon('check')
										span= doc
							picture.ss-section-calc-docs__docs-img
								source(srcset='/img/catalog.webp 1x, /img/catalog@2x.webp 2x')
								img(src='/img/catalog.webp' width='226' height='164' alt='Каталог документации')
						.ss-section-calc-docs__docs-actions
							+ssBtn('Скачать опросный лист', { icon: 'download', full: true, tag: 'a', href: '#download' })
							+ssBtn('Перейти в библиотеку', { variant: 'dark', icon: 'book', full: true, tag: 'a', href: '#library' })
							+ssBtn('Запросить типовую схему', { variant: 'outline-dark', icon: 'mail', full: true, tag: 'a', href: '#request' })
