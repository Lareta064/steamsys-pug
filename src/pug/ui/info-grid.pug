extends ../layouts/layout-ui.pug

block variables
	-var title = "Информационная сетка (.ss-info-grid)";

block content
	.container-dashboard.ss-wrapper
		h2.db-h2 Информационная сетка (.ss-info-grid)

		.container-dashboard__content

			p.breadcrumbs-catalog__hint.ss-reg-14.ss-txt-secondary
				| Сетка информационных элементов «иконка + label + значение». Нейтральна по контексту — пригодна для «Паспорта проекта», характеристик, стат-карточек компании, параметров системы и любых похожих раскладок.
				br
				| 3 колонки на десктопе, 2 на &lt;$lg (1024), 1 на &lt;$md (768). Grid-flow по строкам — DOM-порядок слева направо.
				br
				| Стили —
				code src/scss/blocks/_info-grid.scss
				| .

			//- ===== Пример: Паспорт проекта (9 элементов) =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Пример: 9 элементов (3×3)
				p.breadcrumbs-catalog__hint.ss-reg-14.ss-txt-secondary
					| На single-case.html используется как «Паспорт проекта» — page-level секция оборачивает его h3-заголовком.

				.breadcrumbs-catalog__demo
					ul.ss-info-grid
						li.ss-info-grid__item
							span.ss-info-grid__icon(aria-hidden='true')
								+svgIcon('user')
							.ss-info-grid__body
								p.ss-info-grid__label Клиент
								p.ss-info-grid__value Молочный комбинат «Вкусмол»
						li.ss-info-grid__item
							span.ss-info-grid__icon(aria-hidden='true')
								+svgIcon('calendar')
							.ss-info-grid__body
								p.ss-info-grid__label Год реализации
								p.ss-info-grid__value 2023
						li.ss-info-grid__item
							span.ss-info-grid__icon(aria-hidden='true')
								+svgIcon('tool')
							.ss-info-grid__body
								p.ss-info-grid__label Оборудование
								p.ss-info-grid__value TLV, TUMA, фильтры Y-типа
						li.ss-info-grid__item
							span.ss-info-grid__icon(aria-hidden='true')
								+svgIcon('shield')
							.ss-info-grid__body
								p.ss-info-grid__label Отрасль
								p.ss-info-grid__value Молочная промышленность
						li.ss-info-grid__item
							span.ss-info-grid__icon(aria-hidden='true')
								+svgIcon('doc')
							.ss-info-grid__body
								p.ss-info-grid__label Тип объекта
								p.ss-info-grid__value Пищевое производство
						li.ss-info-grid__item
							span.ss-info-grid__icon(aria-hidden='true')
								+svgIcon('cog')
							.ss-info-grid__body
								p.ss-info-grid__label Масштаб
								p.ss-info-grid__value 48 конденсатоотводчиков
						li.ss-info-grid__item
							span.ss-info-grid__icon(aria-hidden='true')
								+svgIcon('target')
							.ss-info-grid__body
								p.ss-info-grid__label Регион
								p.ss-info-grid__value Краснодарский край
						li.ss-info-grid__item
							span.ss-info-grid__icon(aria-hidden='true')
								+svgIcon('sliders')
							.ss-info-grid__body
								p.ss-info-grid__label Вид работ
								p.ss-info-grid__value Диагностика и замена конденсатоотводчиков
						li.ss-info-grid__item
							span.ss-info-grid__icon(aria-hidden='true')
								+svgIcon('chart')
							.ss-info-grid__body
								p.ss-info-grid__label Срок реализации
								p.ss-info-grid__value 6 месяцев

			//- ===== Элементы =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Элементы
				ul
					li
						code .ss-info-grid
						|  — обёртка
						code ul
						| , grid 3 колонки.
					li
						code .ss-info-grid__item
						|  — одна ячейка (
						code li
						| ), flex-row.
					li
						code .ss-info-grid__icon
						|  — обёртка SVG 32×32,
						code color: --accent1
						| .
					li
						code .ss-info-grid__label
						|  — надпись-метка (13/400, --secondary).
					li
						code .ss-info-grid__value
						|  — значение (15/600, --primary).

			//- ===== Сниппет =====
			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Сниппет

				pre.breadcrumbs-catalog__snippet
					code
						| ul.ss-info-grid
						|     li.ss-info-grid__item
						|         span.ss-info-grid__icon(aria-hidden='true')
						|             +svgIcon('user')
						|         .ss-info-grid__body
						|             p.ss-info-grid__label Клиент
						|             p.ss-info-grid__value Молочный комбинат «Вкусмол»
						|     li.ss-info-grid__item
						|         span.ss-info-grid__icon(aria-hidden='true')
						|             +svgIcon('calendar')
						|         .ss-info-grid__body
						|             p.ss-info-grid__label Год реализации
						|             p.ss-info-grid__value 2023
