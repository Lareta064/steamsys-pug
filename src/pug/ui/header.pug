extends ../layouts/layout-ui-sections.pug

block content
	include ../sections/_header.pug

	//- Тестовая hero-секция для preview шапки на тёмном фоне.
	section.demo-hero
		.demo-hero__inner
			p.demo-hero__eyebrow ТЕСТОВАЯ HERO-СЕКЦИЯ
			p.demo-hero__title Инженерные решения для промышленности
			p.demo-hero__desc Проверяем полупрозрачную шапку с backdrop-blur на тёмном фоне, submenu (mega + simple) с hover-логикой, sticky-режим при скролле и мобильное меню (&lt;1200).

	//- Скролл-спейсер для теста sticky-режима.
	section.demo-scroll-spacer
		p Прокрути ниже — шапка залипнет и сожмётся.
