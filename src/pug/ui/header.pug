				submenu: [
					[
						{ title: 'Модульные паровые котельные', href: '#' },
						{ title: 'Сверхкомпактный ИТП ГВС', href: '#' },
						{ title: 'Обвязка калориферов', href: '#' },
						{ title: 'Редукционно-охладительные установки (РОУ и БРОУ)', href: '#' }
					],
					[
						{ title: 'Теплопункты пар/жидкость', href: '#' },
						{ title: 'Редукционные установки', href: '#' },
						{ title: 'Охладительные установки', href: '#' },
						{ title: 'Станции возврата конденсата', href: '#' }
					],
					[
						{ title: 'Обвязка вращающихся сушилок (цилиндров)', href: '#' },
						{ title: 'Обвязка варочных котлов (реакторов)', href: '#' },
						{ title: 'Паросплитники', href: '#' },
						{ title: 'Вакуумные системы нагрева TLV', href: '#' }
					]
				]
			},
			{
				title: 'Отрасли', href: '#', type: 'mega',
				submenu: [
					[
						{ title: 'Пищевая промышленность', href: '#' },
						{ title: 'Молочная промышленность', href: '#' },
						{ title: 'Фармацевтика', href: '#' }
					],
					[
						{ title: 'Химия и нефтехимия', href: '#' },
						{ title: 'Энергетика', href: '#' },
						{ title: 'Целлюлозно-бумажная', href: '#' }
					],
					[
						{ title: 'ЖКХ и теплоснабжение', href: '#' },
						{ title: 'Металлургия', href: '#' }
					]
				]
			},
			{
				title: 'Оборудование', href: '#', type: 'mega',
				submenu: [
					[
						{ title: 'Конденсатоотводчики', href: '#', subs: [ 'Со свободноплавающим поплавком', 'Поплавковые для больших расходов', 'Термодинамические', 'Термостатические', 'Конденсатоотводчики для сжатого воздуха' ] },
						{ title: 'Приборы контроля конденсатоотводчиков', href: '#' },
						{ title: 'Регулирующие клапаны для пара', href: '#' },
						{ title: 'Теплообменники пар/жидкость', href: '#' },
						{ title: 'Запорная арматура для пара и конденсата', href: '#' },
						{ title: 'Предохранительные клапаны', href: '#' },
						{ title: 'Электромагнитные клапаны', href: '#' }
					],
					[
						{ title: 'Конденсатные насосы TLV Power Trap', href: '#' },
						{ title: 'Редукционные клапаны TLV', href: '#' },
						{ title: 'Регулирующие клапаны для воды', href: '#' },
						{ title: 'Охладители пара', href: '#' },
						{ title: 'Обратные клапаны', href: '#' },
						{ title: 'Автоматика', href: '#', subs: [ 'Контроллеры', 'Датчики температуры', 'Термостаты', 'Датчики давления', 'Реле давления', 'Реле времени', 'Щиты управления' ] },
						{ title: 'Парогенераторы Уран', href: '#' }
