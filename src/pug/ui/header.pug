	header.ss-header.ss-wrapper
		.ss-container.ss-header__inner
			a.ss-header__logo(href='/', aria-label='STEAMSYS — на главную')
				+svgIcon('logo', { sprite: 'logo-sprite' })

			nav.ss-header__nav(aria-label='Основная навигация')
				ul.ss-menu__list
					each item, idx in menuItems
						li.ss-menu__item
							a.ss-menu__link(href=item.href, aria-haspopup=item.type ? 'true' : false, aria-expanded=item.type ? 'false' : false, aria-controls=item.type ? 'menu-submenu-' + idx : false)
								span= item.title
								if item.type
									+svgIcon('chevron-down')(class='ss-menu__chevron')

							//- Mega submenu
							if item.type === 'mega'
								.ss-menu__submenu.ss-menu__submenu--mega(id='menu-submenu-' + idx)
									.ss-menu__submenu-inner
										each col in item.submenu
											.ss-menu__submenu-col
												each sub in col
													.ss-menu__submenu-item
														a.ss-menu__submenu-link(href=sub.href)= sub.title
														if sub.subs
															.ss-menu__submenu-subs
																each chip in sub.subs
																	a.ss-menu__submenu-sub(href='#')= chip

							//- Simple submenu
							if item.type === 'simple'
								.ss-menu__submenu.ss-menu__submenu--simple(id='menu-submenu-' + idx)
									.ss-menu__submenu-inner
										each sub in item.submenu
											a.ss-menu__submenu-link(href=sub.href)= sub.title

					//- Триггер «…» — показывается JS при переполнении.
					li.ss-menu__item.ss-menu__item--more(hidden)
						a.ss-menu__link(href='#', aria-label='Ещё пункты', aria-haspopup='true', aria-expanded='false', aria-controls='menu-submenu-more')
							span …
						.ss-menu__submenu.ss-menu__submenu--simple(id='menu-submenu-more')
							.ss-menu__submenu-inner
								//- Заполняется JS (пункты, не поместившиеся в menubar)

			a.ss-header__phone(href='tel:+78126027770') +7 (812) 602-77-70

			+ssBtn('Получить КП', { variant: 'primary', icon: 'arrow-right' })(class='ss-header__cta', data-modal='request')

			button.menu-toggle.ss-header__burger#menu-toggle(type='button', aria-label='Открыть меню')
				span

	//- ==================== Мобильное меню (sheet slide-in слева, <$xl) ====================
	//- Открывается ПОД шапкой — своей копии лого / бургера не имеет.
	.ss-mobile-menu#mobile-menu
		.ss-mobile-menu__overlay
		aside.ss-mobile-menu__panel
			nav.ss-mobile-menu__nav(aria-label='Мобильная навигация')
				ul.ss-mobile-menu__list
					each item, idx in menuItems
						li.ss-mobile-menu__item
							if item.type
								input.ss-mobile-menu__toggle(type='checkbox', id='mm-' + idx, hidden)
								label.ss-mobile-menu__title(for='mm-' + idx, tabindex='0', role='button', aria-expanded='false', aria-controls='mm-submenu-' + idx)
									span= item.title
									+svgIcon('chevron-down')(class='ss-mobile-menu__arrow')
								.ss-mobile-menu__submenu(id='mm-submenu-' + idx)
									a.ss-mobile-menu__dupe(href=item.href)= item.title
									ul.ss-mobile-menu__level2
										if item.type === 'mega'
											each col in item.submenu
												each sub in col
													li.ss-mobile-menu__level2-item
														a.ss-mobile-menu__level2-link(href=sub.href)= sub.title
														if sub.subs
															.ss-mobile-menu__level3
																each chip in sub.subs
																	a.ss-mobile-menu__level3-link(href='#')= chip
										else
											each sub in item.submenu
												li.ss-mobile-menu__level2-item
													a.ss-mobile-menu__level2-link(href=sub.href)= sub.title
							else
								a.ss-mobile-menu__link(href=item.href)= item.title

			.ss-mobile-menu__contacts
				ul.ss-contacts-list
					li.ss-contacts-list__item
						p.ss-contacts-list__label Телефон
						a.ss-contacts-list__value(href='tel:+78126027770') +7 (812) 602-77-70
					li.ss-contacts-list__item
						p.ss-contacts-list__label Почта
						a.ss-contacts-list__value(href='mailto:info@steamsys.ru') info@steamsys.ru
					li.ss-contacts-list__item
						p.ss-contacts-list__label Режим работы
						p.ss-contacts-list__value.ss-medi-16
							| Работаем: Пн - Пт с 9:00 до 18:00
							br
							| Выходной: Сб - Вс
					li.ss-contacts-list__item
						p.ss-contacts-list__label Адрес
						p.ss-contacts-list__value.ss-medi-16
							| Санкт-Петербург,
							br
							| ул. Воронежская, д. 5, оф. 123
				+socialGroup(['whatsapp', 'telegram'])

			+ssBtn('Получить КП', { variant: 'primary', full: true, icon: 'arrow-right' })(data-modal='request')

	//- Тестовая hero-секция для preview шапки на тёмном фоне.
	section.demo-hero
		.demo-hero__inner
			p.demo-hero__eyebrow ТЕСТОВАЯ HERO-СЕКЦИЯ
			p.demo-hero__title Инженерные решения для промышленности
			p.demo-hero__desc Проверяем полупрозрачную шапку с backdrop-blur на тёмном фоне, submenu (mega + simple) с hover-логикой, sticky-режим при скролле и мобильное меню (&lt;1200).

	//- Скролл-спейсер для теста sticky-режима.
	section.demo-scroll-spacer
		p Прокрути ниже — шапка залипнет и сожмётся.
