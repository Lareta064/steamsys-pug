extends ../layouts/layout-ui.pug
include ../mixins/_svg-icons.pug

block content
	
	- var socialItems =['whatsapp','telegram']
	
	.container-dashboard.ss-wrapper
		h2.db-h2 Social

		.container-dashboard__content

			p.icons-catalog__intro.ss-reg-14.ss-txt-secondary
				| Иконки подключаются через миксин
				code +socialGroup(['whatsapp','telegram'])
				
			
			
			h3.icons-catalog__section-title Соц сети
			ul.icons-catalog
				li.icons-catalog__item
					.icons-catalog__preview
						+socialGroup(socialItems)
					.icons-catalog__meta
						code.icons-catalog__name +socialGroup('whatsapp')
						
						pre.icons-catalog__snippet
							code +socialGroup(['whatsapp','telegram'])
				li.icons-catalog__item
					.icons-catalog__preview.icons-catalog__preview--dark
						+socialGroup(socialItems)(class="ss-social--white")
					.icons-catalog__meta
						code.icons-catalog__name +socialGroup(socialItems)(class="ss-social--white")
						
						pre.icons-catalog__snippet
							code +socialGroup(['whatsapp','telegram'])
				li.icons-catalog__item
					.icons-catalog__preview.icons-catalog__preview--dark
						+socialGroup(socialItems)(class="ss-social--blue")
					.icons-catalog__meta
						code.icons-catalog__name +socialGroup(['whatsapp','telegram'])(class="ss-social--blue")
						
						pre.icons-catalog__snippet
							code +socialGroup(['whatsapp','telegram'])(class="ss-social--blue")
			
			
			