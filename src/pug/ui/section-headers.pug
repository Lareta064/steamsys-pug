extends ../layouts/layout-ui.pug

block content
	.container-dashboard.ss-wrapper
		h2.db-h2 Заголовки секций

		.container-dashboard__content

			p.section-headers-catalog__intro.ss-reg-14.ss-txt-secondary
				| Компоненты и утилиты для оформления шапок секций. Стили — в
				code src/scss/base/_typography.scss
				| (kicker) и последующих файлах.

			//- ========== Оглавление ==========
			nav.section-headers-catalog__toc
				h3.section-headers-catalog__toc-title Оглавление
				ul.section-headers-catalog__toc-list
					li: a(href='#kicker') .ss-kicker
					li: a(href='#section-header') .ss-section-header
					li: a(href='#section-intro') .ss-section-intro
					li: a(href='#section-hero') .ss-section-hero

			//- ========== Kicker ==========
			section.section-headers-catalog__section#kicker
				h3.section-headers-catalog__section-title .ss-kicker
				p.section-headers-catalog__hint.ss-reg-14.ss-txt-secondary
					| Uppercase-надпись над заголовком секции. Цвет по умолчанию —
					code var(--accent1)
					| , можно переопределить утилитой
					code .ss-txt-*
					| . Размер адаптируется: 18 (xl+), 16 (768–1199), 14 (&lt; 768).

				ul.section-headers-catalog__grid
					//- На светлом фоне
					li.section-headers-catalog__card
						.section-headers-catalog__preview
							span.ss-kicker Клиенты
						.section-headers-catalog__meta
							code.section-headers-catalog__name .ss-kicker
							span.section-headers-catalog__token На светлом фоне · accent1
							pre.section-headers-catalog__snippet
								code span.ss-kicker Клиенты

					//- На тёмном фоне — accent3
					li.section-headers-catalog__card.section-headers-catalog__card--on-dark
						.section-headers-catalog__preview.ss-bg-primary
							span.ss-kicker.ss-txt-accent3 Процесс
						.section-headers-catalog__meta
							code.section-headers-catalog__name .ss-kicker.ss-txt-accent3
							span.section-headers-catalog__token На тёмном фоне · accent3
							pre.section-headers-catalog__snippet
								code span.ss-kicker.ss-txt-accent3 Процесс

					//- На тёмном фоне — white
					li.section-headers-catalog__card.section-headers-catalog__card--on-dark
						.section-headers-catalog__preview.ss-bg-primary1
							span.ss-kicker.ss-txt-white Преимущества
						.section-headers-catalog__meta
							code.section-headers-catalog__name .ss-kicker.ss-txt-white
							span.section-headers-catalog__token На тёмном фоне · white
							pre.section-headers-catalog__snippet
								code span.ss-kicker.ss-txt-white Преимущества

				p.section-headers-catalog__hint.ss-reg-14.ss-txt-secondary(style="margin-top:16px;")
					| Живой пример в связке с заголовком:

				.section-headers-catalog__demo
					span.ss-kicker Задачи
					h2.ss-h2(style="margin-top:8px;") Какие задачи решаем

			//- ========== Section header ==========
			section.section-headers-catalog__section#section-header
				h3.section-headers-catalog__section-title .ss-section-header
				p.section-headers-catalog__hint.ss-reg-14.ss-txt-secondary
					| Простая строка над секцией: kicker слева, заголовок
					code .ss-h2
					| справа, разведены через
					code space-between
					| . На экранах ниже
					code $md
					| — колонка (kicker сверху, заголовок снизу), row-gap 20.

				//- Живой пример на светлом фоне
				h4.section-headers-catalog__subtitle На светлом фоне
				.section-headers-catalog__demo
					.ss-section-header
						span.ss-kicker Задачи
						h2.ss-h2 Какие задачи решаем

				//- Живой пример на тёмном фоне
				h4.section-headers-catalog__subtitle На тёмном фоне (bg + text bundle)
				.section-headers-catalog__demo.ss-bg-primary(style="padding:32px 24px;")
					.ss-section-header
						span.ss-kicker.ss-txt-accent3 Процесс
						h2.ss-h2 Как проходит работа с нами

				//- Сниппет
				pre.section-headers-catalog__snippet(style="margin-top:16px;")
					code
						| .ss-section-header
						|     span.ss-kicker Задачи
						|     h2.ss-h2 Какие задачи решаем

				p.section-headers-catalog__hint.ss-reg-14.ss-txt-secondary(style="margin-top:16px;")
					| Сузь окно браузера до &lt; 768 — kicker и заголовок встанут в колонку с
					code row-gap: 20
					| .

			//- ========== Section intro ==========
			section.section-headers-catalog__section#section-intro
				h3.section-headers-catalog__section-title .ss-section-intro
				p.section-headers-catalog__hint.ss-reg-14.ss-txt-secondary
					| Стек-колонка из трёх строк: kicker · заголовок+описание · CTA. По умолчанию
					code row-gap: 20
					| . Между заголовком и описанием — фиксированные
					code 10px
					| .

				//- Полный вариант
				h4.section-headers-catalog__subtitle Все три строки
				.section-headers-catalog__demo
					.ss-section-intro
						span.ss-kicker Комплексный подход
						.ss-section-intro__body
							h2.ss-h2 Берём на себя весь цикл работ — от аудита до сервисной поддержки
							p.ss-section-intro__description Анализируем систему, проектируем, поставляем оборудование, обеспечиваем стабильную работу 24/7.
						+ssLink('Подробнее о подходе')

				//- Без CTA
				h4.section-headers-catalog__subtitle Без CTA
				.section-headers-catalog__demo
					.ss-section-intro
						span.ss-kicker Клиенты
						.ss-section-intro__body
							h2.ss-h2 Для кого работаем
							p.ss-section-intro__description Главные инженеры, энергетики, технологи, закупщики, проектировщики.

				//- На тёмном фоне (bundle)
				h4.section-headers-catalog__subtitle На тёмном фоне (bg + text bundle)
				.section-headers-catalog__demo.ss-bg-primary(style="padding:32px 24px;")
					.ss-section-intro
						span.ss-kicker.ss-txt-accent3 Процесс
						.ss-section-intro__body
							h2.ss-h2 Как проходит работа с нами
							p.ss-section-intro__description Пять этапов от заявки до сдачи в эксплуатацию.
						+ssLink('Смотреть все проекты', { variant: 'white' })

				//- Stretch модификатор
				h4.section-headers-catalog__subtitle .ss-section-intro--stretch (в grid-ряду с высоким соседом)
				p.section-headers-catalog__hint.ss-reg-14.ss-txt-secondary Три строки разведены к краям через space-between.
				.section-headers-catalog__demo
					.ss-grid
						.ss-col-6
							.ss-section-intro.ss-section-intro--stretch
								span.ss-kicker Опыт
								.ss-section-intro__body
									h2.ss-h2 Опыт в ключевых отраслях
									p.ss-section-intro__description Пищевая, фарм, химия, энергетика.
								+ssLink('Смотреть все кейсы')
						.ss-col-6
							.section-headers-catalog__filler(style="min-height:280px; background:#DEE2E4; border-radius:8px; display:flex; align-items:center; justify-content:center; color:#7C8A93;") Высокий сосед (карточки/фото)

				//- Сниппет
				pre.section-headers-catalog__snippet(style="margin-top:16px;")
					code
						| .ss-section-intro
						|     span.ss-kicker Kicker
						|     .ss-section-intro__body
						|         h2.ss-h2 Заголовок
						|         p.ss-section-intro__description Описание
						|     +ssLink('CTA')

			//- ========== Section hero ==========
			section.section-headers-catalog__section#section-hero
				h3.section-headers-catalog__section-title .ss-section-hero
				p.section-headers-catalog__hint.ss-reg-14.ss-txt-secondary
					| Заголовочный блок первого экрана. Две группы в колонке: сверху
					code .ss-section-hero__head
					| (kicker / .ss-h1 / описание — gap 20), снизу
					code .ss-section-hero__actions
					| (группа кнопок — flex + gap 16). Между группами — gap 40.

				//- Полный вариант на светлом фоне
				h4.section-headers-catalog__subtitle На светлом фоне
				.section-headers-catalog__demo
					.ss-section-hero
						.ss-section-hero__head
							span.ss-kicker Инженерный каталог
							h1.ss-h1 Готовые системы и решения для пароконденсатных контуров
							p.ss-section-intro__description Подберём систему под задачу: РОУ/БРОУ, ОУ, ИТП ГВС, СВК, обвязки калориферов, редукционные установки.
						.ss-section-hero__actions
							+ssBtn('Подобрать систему')
							+ssBtn('Отправить параметры', { variant: 'outline-dark' })

				//- На тёмном фоне
				h4.section-headers-catalog__subtitle На тёмном фоне
				.section-headers-catalog__demo.ss-bg-primary(style="padding:40px 24px;")
					.ss-section-hero
						.ss-section-hero__head
							span.ss-kicker.ss-txt-accent3 Инжиниринговый интегратор пароконденсатных систем
							h1.ss-h1 Инженерные решения для пароконденсатных систем
							p.ss-section-intro__description Снижаем расход пара, возвращаем конденсат, стабилизируем давление и температуру.
						.ss-section-hero__actions
							+ssBtn('Получить КП')
							+ssBtn('Обсудить задачу', { variant: 'outline-light' })

				//- Минимальный вариант — только head, без CTA
				h4.section-headers-catalog__subtitle Минимум: только head, без CTA
				.section-headers-catalog__demo
					.ss-section-hero
						.ss-section-hero__head
							span.ss-kicker Каталог оборудования
							h1.ss-h1 Конденсатоотводчики
							p.ss-section-intro__description Автоматический отвод конденсата из паровых систем.

				//- Сниппет
				pre.section-headers-catalog__snippet(style="margin-top:16px;")
					code
						| .ss-section-hero
						|     .ss-section-hero__head
						|         span.ss-kicker Kicker
						|         h1.ss-h1 Заголовок
						|         p.ss-section-intro__description Описание
						|     .ss-section-hero__actions
						|         +ssBtn('Первичная')
						|         +ssBtn('Вторичная', { variant: 'outline' })
