extends ../layouts/layout-ui.pug

block variables
	-var title = "Слайдер товаров (.ss-products-slider)";

block content
	- var demoItems = [{ img: 'tool1', brand: 'TLV', title: 'JX6S', alt: 'Поплавковый конденсатоотводчик TLV JX6S', specs: [{ k: 'DN', v: '15–80' }, { k: 'PN', v: '40 бар' }, { k: 'Температура', v: 'до 220 °C' }], href: '#' }, { img: 'tool2', brand: 'Spirax Sarco', title: 'JX7S', alt: 'Термодинамический конденсатоотводчик Spirax JX7S', specs: [{ k: 'DN', v: '25–100' }, { k: 'PN', v: '16 бар' }, { k: 'Температура', v: 'до 300 °C' }], href: '#' }, { img: 'tool3', brand: 'Gestra', title: 'A3N', alt: 'Термостатический конденсатоотводчик Gestra A3N', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '40 бар' }, { k: 'Температура', v: 'до 250 °C' }], href: '#' }, { img: 'tool1', brand: 'ADCA', title: 'L21S', alt: 'Биметаллический конденсатоотводчик ADCA L21S', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '16 бар' }, { k: 'Температура', v: 'до 300 °C' }], href: '#' }, { img: 'tool2', brand: 'TLV', title: 'FT14', alt: 'Поплавковый конденсатоотводчик TLV FT14', specs: [{ k: 'DN', v: '15–50' }, { k: 'PN', v: '25 бар' }, { k: 'Температура', v: 'до 220 °C' }], href: '#' }]

	.container-dashboard.ss-wrapper
		h2.db-h2 Слайдер товаров (.ss-products-slider)

		.container-dashboard__content

			p.breadcrumbs-catalog__hint.ss-reg-14.ss-txt-secondary
				| Слайдер похожих товаров для страницы карточки. Используется та же карточка
				code .ss-product-card
				| , что в каталоге. Равная высота слайдов — в
				code _product-similar.scss
				| :
				code height:unset + min-height:100% + display:flex
				|  на
				code .swiper-slide
				| ,
				code flex:1
				|  на карточке. Стрелки над слайдером —
				code .ss-slider-nav.ss-slider-nav--accent
				| . JS —
				code src/js/similar-swiper.js
				| .
				br
				| Брейкпойнты: &lt;768 — auto, gap 10px · 768–1439 — auto, gap 20px · 1440–1599 — 4 слайда, gap 20px · ≥1600 — 4 слайда, gap 30px.
				| Ширина слайда в auto-режиме — 330px (CSS). Пагинация скрыта на &lt;1024px.

			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Пример слайдера

				.breadcrumbs-catalog__demo
					.ss-products-slider
						.ss-section-header
							.ss-section-header__title
								h2.ss-h2 Похожие товары
							.ss-slider-nav.ss-slider-nav--accent
								+ssSwiperBtn('prev')
								+ssSwiperBtn('next')

						.swiper.swiper-pb.swiper-bars.js-similar-slider
							.swiper-wrapper
								each item in demoItems
									.swiper-slide
										article.ss-product-card
											a.ss-product-card__media(href=item.href aria-label=`Открыть карточку товара ${item.title}`)
												picture
													source(srcset=`${basePath}img/${item.img}.webp 1x, ${basePath}img/${item.img}@2x.webp 2x`)
													img(src=`${basePath}img/${item.img}.webp` width='235' height='160' alt=item.alt loading='lazy' decoding='async')
											p.ss-product-card__brand= item.brand
											h3.ss-product-card__title
												a(href=item.href)= item.title
											dl.ss-product-card__specs
												each s in item.specs
													.ss-product-card__specs-row
														dt= s.k
														dd= s.v
							.swiper-pagination

			section.breadcrumbs-catalog__section
				h3.breadcrumbs-catalog__section-title Сниппет

				pre.breadcrumbs-catalog__snippet
					code
						| .ss-products-slider
						|     .ss-section-header
						|         .ss-section-header__title
						|             h2.ss-h2 Похожие товары
						|         .ss-slider-nav.ss-slider-nav--accent
						|             +ssSwiperBtn('prev')
						|             +ssSwiperBtn('next')
						|     .swiper.swiper-pb.swiper-bars.js-similar-slider
						|         .swiper-wrapper
						|             .swiper-slide
						|                 article.ss-product-card
						|                     a.ss-product-card__media(href='#')
						|                         img(src='...', alt='', loading='lazy', decoding='async')
						|                     p.ss-product-card__brand TLV
						|                     h3.ss-product-card__title
						|                         a(href='#') JX45
						|                     dl.ss-product-card__specs
						|                         .ss-product-card__specs-row
						|                             dt DN
						|                             dd 15–50
						|         .swiper-pagination
