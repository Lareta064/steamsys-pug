extends ../layouts/layout-ui.pug

block content
	//- Данные для демо nav
	- var navItems = [{ id: 'nav-1', title: 'Решения', links: [{ text: 'Все решения', href: '#' }, { text: 'РОУ и БРОУ', href: '#' }, { text: 'СВК', href: '#' }, { text: 'ОУ / ИТП ГВС', href: '#' }, { text: 'Обвязка калориферов', href: '#' }, { text: 'Обвязка теплообменников', href: '#' }] }, { id: 'nav-2', title: 'Оборудование', links: [{ text: 'Всё оборудование', href: '#' }, { text: 'Конденсатоотводчики', href: '#' }, { text: 'Конденсатные насосы', href: '#' }, { text: 'Клапаны и арматура', href: '#' }, { text: 'Автоматика', href: '#' }, { text: 'Бренды', href: '#' }] }, { id: 'nav-3', title: 'Отрасли и опыт', links: [{ text: 'Все отрасли', href: '#' }, { text: 'Кейсы', href: '#' }, { text: 'Отзывы', href: '#' }, { text: 'Медиа', href: '#' }] }, { id: 'nav-4', title: 'Инструменты', links: [{ text: 'Калькуляторы', href: '#' }, { text: 'Опросные листы', href: '#' }, { text: 'Документация', href: '#' }, { text: 'База знаний', href: '#' }, { text: 'CAD / 3D / BIM', href: '#' }] }, { id: 'nav-5', title: 'Компания', links: [{ text: 'О компании', href: '#' }, { text: 'Команда', href: '#' }, { text: 'Карьера', href: '#' }, { text: 'Реквизиты', href: '#' }, { text: 'Вопросы и ответы', href: '#' }, { text: 'Контакты', href: '#' }] }]

	//- Миксин для одного контакт-айтема. Опциональный класс типографики
	//- для value (напр. 'ss-h4' в feedback, 'ss-medi-20' для расписания).
	mixin contactItem(label, value, sizeClass)
		li.ss-contacts-list__item
			p.ss-contacts-list__label= label
			p.ss-contacts-list__value(class=sizeClass)!= value

	.container-dashboard.ss-wrapper
		h2.db-h2 Компоненты футера

		.container-dashboard__content

			p.footer-catalog__intro.ss-reg-14.ss-txt-secondary
				| Отдельные части футера. По готовности всех компонентов — соберём полный
				code section.ss-footer
				|  на отдельной странице. Все компоненты рассчитаны на тёмный фон, демо — на подложке
				code .ss-bg-primary
				| .

			//- ========== .ss-footer-nav__item ==========
			h3.footer-catalog__section-title .ss-footer-nav__item
			p.footer-catalog__hint.ss-reg-14.ss-txt-secondary
				| Одна колонка навигации: киккер (accent3) + список ссылок.
				| Десктоп (≥$md) — статичная колонка. Мобилка (<$md) — аккордеон: клик по заголовку разворачивает список,
				| у открытого блока сверху и снизу бордер accent3. Реализовано без JS через скрытый
				code input[type="checkbox"]
				|  + label с
				code for
				| . Родитель (расположение по горизонтали на десктопе, стек на мобилке) — задача консьюмера.

			.footer-catalog__demo.ss-bg-primary
				.footer-catalog__nav-grid
					each item in navItems
						.ss-footer-nav__item
							input.ss-footer-nav__toggle(type='checkbox', id='footer-' + item.id, hidden)
							label.ss-footer-nav__title(for='footer-' + item.id)
								span.ss-footer-nav__title-text= item.title
								+svgIcon('chevron-down')(class='ss-footer-nav__arrow')
							ul.ss-footer-nav__list
								each link in item.links
									li: a.ss-footer-nav__link(href=link.href)= link.text

			h4.footer-catalog__subtitle Сниппет
			pre.footer-catalog__snippet
				code
					| .ss-footer-nav__item
					|     input.ss-footer-nav__toggle#footer-nav-1(type='checkbox' hidden)
					|     label.ss-footer-nav__title(for='footer-nav-1')
					|         span.ss-footer-nav__title-text Решения
					|         +svgIcon('chevron-down')(class='ss-footer-nav__arrow')
					|     ul.ss-footer-nav__list
					|         li: a.ss-footer-nav__link(href='#') Все решения
					|         li: a.ss-footer-nav__link(href='#') РОУ и БРОУ
					|         //- ...

			//- ========== .ss-contacts-list ==========
			h3.footer-catalog__section-title .ss-contacts-list
			p.footer-catalog__hint.ss-reg-14.ss-txt-secondary
				| Список контактов (label + value). Используется в футере, мобильном меню и в секции feedback.
				br
				| — База: column, value 20/600 десктоп → 16/600 при &lt;$xl.
				br
				|
				code .ss-contacts-list--row
				|  — горизонтальная раскладка (футер desktop).
				br
				|
				code .ss-contacts-list--hero
				|  — крупный row-gap 40 + крупный label 18/16 (для feedback).
				br
				| — Размер value кастомизируется через типографический класс вторым классом:
				code .ss-h4
				|  (24→40) для feedback,
				code .ss-medi-20
				|  для многострочного расписания/адреса,
				code .ss-semi-20
				|  для телефона в mob-меню и т.д.

			h4.footer-catalog__subtitle База — column, компакт (футер mobile / mob-menu)
			.footer-catalog__demo.ss-bg-primary(style='max-width: 300px;')
				ul.ss-contacts-list
					+contactItem('Телефон', '+7 (812) 602-77-70')
					+contactItem('Почта', 'info@steamsys.ru')
					+contactItem('Режим работы', 'Работаем: Пн - Пт с 9:00 до 18:00<br>Выходной: Сб - Вс', 'ss-medi-14')
					+contactItem('Адрес', 'Санкт-Петербург,<br>ул. Воронежская, д. 5, оф. 123', 'ss-medi-14')

			h4.footer-catalog__subtitle --row (для футера на десктопе)
			.footer-catalog__demo.ss-bg-primary
				ul.ss-contacts-list.ss-contacts-list--row
					+contactItem('Телефон', '+7 (812) 602-77-70')
					+contactItem('Почта', 'info@steamsys.ru')
					+contactItem('Режим работы', 'Работаем: Пн - Пт с 9:00 до 18:00<br>Выходной: Сб - Вс', 'ss-medi-14')
					+contactItem('Адрес', 'Санкт-Петербург,<br>ул. Воронежская, д. 5, оф. 123', 'ss-medi-14')

			h4.footer-catalog__subtitle --hero (для секции feedback, размер value через .ss-h4 / .ss-medi-20)
			.footer-catalog__demo.ss-bg-primary
				ul.ss-contacts-list.ss-contacts-list--hero
					+contactItem('Телефон', '+7 (812) 602-77-70', 'ss-h4')
					+contactItem('Почта', 'info@steamsys.ru', 'ss-h4')
					+contactItem('Режим работы', 'Работаем: Пн - Пт с 9:00 до 18:00<br>Выходной: Сб - Вс', 'ss-medi-20')

			h4.footer-catalog__subtitle Сниппет
			pre.footer-catalog__snippet
				code
					| ul.ss-contacts-list
					|     li.ss-contacts-list__item
					|         p.ss-contacts-list__label Телефон
					|         p.ss-contacts-list__value +7 (812) 602-77-70
					|     li.ss-contacts-list__item
					|         p.ss-contacts-list__label Режим работы
					|         p.ss-contacts-list__value.ss-medi-14
					|             | Работаем: Пн - Пт с 9:00 до 18:00
					|             br
					|             | Выходной: Сб - Вс
					|
					| //- модификаторы + override размера value через типографику:
					| ul.ss-contacts-list.ss-contacts-list--row       // горизонтально
					| ul.ss-contacts-list.ss-contacts-list--hero      // крупный gap + label
					| p.ss-contacts-list__value.ss-h4                  // 24→40 (feedback)
					| p.ss-contacts-list__value.ss-semi-20            // 20 постоянно (mob-menu tel)

			//- ========== .ss-footer__contacts ==========
			h3.footer-catalog__section-title .ss-footer__contacts
			p.footer-catalog__hint.ss-reg-14.ss-txt-secondary
				| Ряд с контактами в футере: слева
				code .ss-contacts-list--row
				|  (column-gap 10 переопределён), справа группа кнопок
				code .ss-footer__contacts-actions
				| . Сверху — тонкая линия
				code --secondary
				| , padding-block 30 (моб 30 20).
				br
				| На &lt;$md весь ряд разворачивается в колонку: список — column row-gap 30,
				| кнопки — column row-gap 20 full-width.

			.footer-catalog__demo.ss-bg-primary(style='padding: 0 20px;')
				.ss-footer__contacts
					ul.ss-contacts-list.ss-contacts-list--row
						+contactItem('Телефон', '+7 (812) 602-77-70')
						+contactItem('Почта', 'info@steamsys.ru')
						+contactItem('Режим работы', 'Работаем: Пн - Пт с 9:00 до 18:00<br>Выходной: Сб - Вс', 'ss-medi-16')
						+contactItem('Адрес', 'Санкт-Петербург,<br>ул. Воронежская, д. 5, оф. 123', 'ss-medi-16')
					.ss-footer__contacts-actions
						+ssBtn('Реквизиты', { variant: 'white', icon: 'book' })
						+ssBtn('Получить КП', { variant: 'primary', icon: 'arrow-right' })

			h4.footer-catalog__subtitle Сниппет
			pre.footer-catalog__snippet
				code
					| .ss-footer__contacts
					|     ul.ss-contacts-list.ss-contacts-list--row
					|         li.ss-contacts-list__item
					|             p.ss-contacts-list__label Телефон
					|             p.ss-contacts-list__value +7 (812) 602-77-70
					|         //- ... остальные items
					|     .ss-footer__contacts-actions
					|         +ssBtn('Реквизиты',   { variant: 'white', icon: 'book' })
					|         +ssBtn('Получить КП', { variant: 'primary', icon: 'arrow-right' })

			//- ========== .ss-footer-bottom ==========
			h3.footer-catalog__section-title .ss-footer-bottom
			p.footer-catalog__hint.ss-reg-14.ss-txt-secondary
				| Нижний ряд футера: копирайт слева, ссылки СОУТ / Политика конфиденциальности,
				| справа кредит «Разработка сайта: KOGIT». Раскладка
				code justify-content: space-between
				| , padding-block 20, border-top --secondary.
				br
				| Размеры типографики — вторым классом:
				code .ss-medi-16
				|  (copy),
				code .ss-medi-14
				|  (ссылки),
				code .ss-reg-14
				|  (кредит).
				br
				| На &lt;$md — flex-column row-gap 20; copyright может переноситься на 2 строки без gap.

			.footer-catalog__demo.ss-bg-primary(style='padding: 0 20px;')
				.ss-footer-bottom
					p.ss-footer-bottom__copy.ss-medi-16 © 2008–2026 | ООО «Паровые системы» | ИНН 7816436595 | Все права защищены
					a.ss-footer-bottom__link.ss-medi-14(href='#') СОУТ
					a.ss-footer-bottom__link.ss-medi-14(href='#') Политика конфиденциальности
					p.ss-footer-bottom__dev.ss-reg-14
						| Разработка сайта: #[a(href='#') KOGIT]

			h4.footer-catalog__subtitle Сниппет
			pre.footer-catalog__snippet
				code
					| .ss-footer-bottom
					|     p.ss-footer-bottom__copy.ss-medi-16 © 2008–2026 | ...
					|     a.ss-footer-bottom__link.ss-medi-14(href='#') СОУТ
					|     a.ss-footer-bottom__link.ss-medi-14(href='#') Политика конфиденциальности
					|     p.ss-footer-bottom__dev.ss-reg-14
					|         | Разработка сайта: #[a(href='#') KOGIT]
