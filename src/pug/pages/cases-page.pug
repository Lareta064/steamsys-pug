extends ../layouts/layout.pug

block variables
	-var title = "Реализованные проекты — STEAMSYS";
	-var bodyCl = "ss-wrapper";
	-var customStyle = `.ss-hero-inner--dark .ss-hero-inner__body{background-image:url('${basePath}img/cases-mob.webp')}@media(min-width:1024px){.ss-hero-inner--dark .ss-hero-inner__body{background-image:url('${basePath}img/cases.webp')}}`

block content
	include ../sections/_header.pug
	main.ss-main-inner.ss-cases-page

		include ../sections/_cases-hero.pug
		include ../sections/_cases-catalog.pug
		include ../sections/_cases-partners.pug
		include ../sections/_feedback-b24-inner.pug

	include ../sections/_footer.pug
