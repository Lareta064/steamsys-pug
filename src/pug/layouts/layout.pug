include _mixins-links.pug
- var basePath = './'
block variables

doctype html
html(lang="ru")
	head
		meta(charset="UTF-8")
		
		meta(name="viewport", content="width=device-width, initial-scale=1.0")
		meta(http-equiv="X-UA-Compatible", content="ie=edge")
		//убрать перевод цифр в номер телефона на ios  и safari 
		
		meta(name="format-detection" content="telephone=no")
		//- preload критических шрифтов (Regular 400 для body/desc + SemiBold 600
		//- для h1-h4). Браузер начинает качать шрифты параллельно с HTML,
		//- не дожидаясь парсинга CSS — экономия ~100-300ms на LCP.
		//- crossorigin обязателен: без него браузер качает шрифт дважды.
		//- Medium 500 (kicker) и Bold 700 не preload'им — они не above-the-fold
		//- или используются точечно; подтянутся штатно через font-display: swap.
		link(rel='preload' as='font' type='font/woff2' href=`${basePath}fonts/Inter-Regular.woff2` crossorigin)
		link(rel='preload' as='font' type='font/woff2' href=`${basePath}fonts/Inter-SemiBold.woff2` crossorigin)
		//favicon
		//- SVG первый + sizes='any' — Chrome предпочтёт векторную (в ней сидит
		//- prefers-color-scheme для dark-mode). Без sizes='any' Chrome берёт
		//- растр с явным размером и игнорирует SVG.
		link(rel='icon' type='image/svg+xml' href=`${basePath}favicon/favicon.svg` sizes='any')
		link(rel='icon' type='image/png' href=`${basePath}favicon/favicon-96x96.png` sizes='96x96')
		//- alternate icon вместо legacy 'shortcut icon' — фолбэк для древних браузеров.
		//- link(rel='alternate icon' href=`${basePath}favicon/favicon.ico`)
		link(rel='apple-touch-icon' sizes='180x180' href=`${basePath}favicon/apple-touch-icon.png`)
		meta(name='apple-mobile-web-app-title' content='MyWebSite')
		link(rel='manifest' href=`${basePath}favicon/site.webmanifest`)
		//========= vendor styles ========
		//- Swiper CSS грузится асинхронно: media="print" исключает файл из
		//- render-blocking (браузер не блокирует Critical Path под "печатный"
		//- CSS), onload переключает media на 'all' — стили применяются сразу
		//- после загрузки. К моменту прокрутки до первого .swiper — уже готов.
		//- <noscript> — фоллбек для отключённого JS.
		link(rel="stylesheet" href=`${basePath}libs/swiper/swiper.min.css` media="print" onload="this.media='all'")
		noscript
			link(rel="stylesheet" href=`${basePath}libs/swiper/swiper.min.css`)
		//========= custom styles ========
		link(rel="stylesheet" href=`${basePath}css/main.css`)
		title !{title}
		style.
			!{customStyle}
	
	body(class=(bodyCl !=="" ? bodyCl : ''))

		
		block content

		//- Swiper грузится лениво из src/js/00-swiper-loader.js
		//- (при приближении первого .swiper к вьюпорту). Убирает ~140 КБ
		//- из «unused JavaScript» на первом рендере — важно для mobile PageSpeed.
		script(src=`${basePath}js/main.js`)