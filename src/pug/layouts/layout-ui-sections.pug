include _mixins-links.pug
- var basePath = '../'
block variables

doctype html
html(lang="ru")
	head
		meta(charset="UTF-8")
		
		meta(name="viewport", content="width=device-width, initial-scale=1.0")
		meta(http-equiv="X-UA-Compatible", content="ie=edge")
		//=======убрать перевод цифр в номер телефона на ios  и safari ======
		meta(name="format-detection" content="telephone=no")
		//========= vendor styles ========
		link(rel="stylesheet" href=`${basePath}libs/swiper/swiper.min.css`)
		//========= custom styles ========
		link(rel="stylesheet" href=`${basePath}css/main.css`)
		title !{title}
		//-style.

			!{customStyle}
	
	body.body-dashboard.body-dashboard--full
		a.ui-back-link(href="docs.html") &larr; Назад
		block content

		script(src=`${basePath}libs/swiper/swiper.js`)
		script(src=`${basePath}js/main.js`)
	
	