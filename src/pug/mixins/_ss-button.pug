//- ssBtn(text, [opts]) — универсальный вывод кнопки .ss-btn.
//-
//- text  — надпись на кнопке.
//- opts  — необязательный объект настроек:
//-     variant   primary | secondary | outline | outline-dark | dark | light | outline-light | white  (default: primary)
//-     size      big — крупная 74px | small — компактная 50px. Без опции — базовый 65px.       (default: базовый 65)
//-     full      true — на всю ширину контейнера                                               (default: false)
//-     wrap      true — разрешить перенос текста в 2+ строк (нужно на узких CTA в сайдбаре)    (default: false)
//-     icon      имя иконки без префикса `svg-` (напр. 'plus-circle')                          (default: null → без иконки)
//-     iconSide  right | left                                                                   (default: right)
//-     tag       button | a                                                                    (default: button)
//-     href      URL — только при tag='a'
//-     disabled  true → атрибут `disabled` для button или класс `.is-disabled` для a           (default: false)
//-
//- Примеры:
//-   +ssBtn('Отправить', { variant: 'primary' })                                //- базовый 65
//-   +ssBtn('Обсудить',  { variant: 'outline-light', size: 'big' })             //- крупный 74
//-   +ssBtn('Получить схему обвязки', { variant: 'dark', size: 'small', full: true, wrap: true }) //- узкий sidebar
//-   +ssBtn('Подробнее', { tag: 'a', href: '/about' })
mixin ssBtn(text, opts)
	-
		var o = opts || {};
		var variant = o.variant || 'primary';
		var iconSide = o.iconSide || 'right';
		var tag = o.tag || 'button';
		var classes = 'ss-btn ss-btn--' + variant;
		if (o.size === 'big') classes += ' ss-btn--big';
		if (o.size === 'small') classes += ' ss-btn--small';
		if (o.full) classes += ' ss-btn--full';
		if (o.wrap) classes += ' ss-btn--wrap';
		if (tag === 'a' && o.disabled) classes += ' is-disabled';

	if tag === 'a'
		a(class=classes href=o.href)&attributes(attributes)
			if o.icon && iconSide === 'left'
				+svgIcon(o.icon)
			span= text
			if o.icon && iconSide === 'right'
				+svgIcon(o.icon)
	else
		button(class=classes type='button' disabled=o.disabled)&attributes(attributes)
			if o.icon && iconSide === 'left'
				+svgIcon(o.icon)
			span= text
			if o.icon && iconSide === 'right'
				+svgIcon(o.icon)
